<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro</RootNamespace>
    <AssemblyName>SmartMacro.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <!-- PrivateAssets="all" (стадия 4B): Tesseract нужен здесь, чтобы компилировался
         TesseractCoordinateReader, но дальше, в проекты, которые ссылаются на Core, он уже НЕ
         течёт. Читатель законсервирован — ICoordinateReader в демоне никто не резолвит, — а
         пакет при этом укладывал в выхлоп SmartMacro.Daemon 12,1 МБ нативных блобов (x64\ и
         x86\, в каждой leptonica-1.82.0 + tesseract50) ради кода, который никогда не грузится.
         ⚠️ ПОСЛЕДСТВИЕ: SmartMacro.Core.dll уезжает к демону с метаданной ссылкой на
         Tesseract.dll, которой рядом НЕТ. Это безобидно ровно до тех пор, пока в демоне никто
         не трогает TesseractCoordinateReader: сборку CLR резолвит лениво, при первом обращении
         к типу. Расконсервировать читателя (детект застреваний) — значит убрать отсюда
         PrivateAssets, чтобы полезная нагрузка снова потекла. Его живой потребитель,
         tools/VisionSampleRunner, держит собственный PackageReference на Tesseract и
         собственный tessdata\.
         ExcludeAssets="build;buildTransitive" — вторая половина, и она НЕ избыточна:
         PrivateAssets останавливает только lib\ (Tesseract.dll). В build\Tesseract.targets
         пакета лежат четыре обычных <None CopyToOutputDirectory> на x86\ и x64\
         leptonica+tesseract50, а None-элементы с CopyToOutputDirectory протекают через
         ProjectReference независимо от того, что говорит PrivateAssets, — именно так эти
         12,1 МБ нативов и продолжали приземляться рядом с демоном. Пропуск targets в Core
         убирает их в источнике; раннер импортирует свою копию тех же targets и всё равно их
         получает.
         Про цифры: сам пакет весит 12,1 МБ нативов и больше ничего в выхлоп не кладёт.
         Оставшиеся ~4 МБ из «107 → 91 МБ» в SmartMacro.Daemon.csproj — это eng.traineddata,
         который лежал отдельным закоммиченным каталогом src/SmartMacro.Daemon/tessdata\ и
         удалён той же стадией 4B, но не этими атрибутами. -->
    <PackageReference Include="Tesseract" Version="5.2.0" PrivateAssets="all" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartMacro.Contracts\SmartMacro.Contracts.csproj" />
    <ProjectReference Include="..\SmartMacro.Native\SmartMacro.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Ipc\IpcRequestDispatcher.Logging.cs">
      <DependentUpon>IpcRequestDispatcher.cs</DependentUpon>
    </Compile>
    <Compile Update="Ipc\IpcServer.Logging.cs">
      <DependentUpon>IpcServer.cs</DependentUpon>
    </Compile>
    <Compile Update="Macros\Storage\MacroGraphStore.Logging.cs">
      <DependentUpon>MacroGraphStore.cs</DependentUpon>
    </Compile>
    <Compile Update="Orchestration\Orchestrator.Logging.cs">
      <DependentUpon>Orchestrator.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
