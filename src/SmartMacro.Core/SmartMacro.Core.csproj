<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro</RootNamespace>
    <AssemblyName>SmartMacro.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartMacro.Contracts\SmartMacro.Contracts.csproj" />
    <ProjectReference Include="..\SmartMacro.Native\SmartMacro.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Agents\CharacterAgent.Logging.cs">
      <DependentUpon>CharacterAgent.cs</DependentUpon>
    </Compile>
    <Compile Update="Ipc\IpcRequestDispatcher.Logging.cs">
      <DependentUpon>IpcRequestDispatcher.cs</DependentUpon>
    </Compile>
    <Compile Update="Ipc\IpcServer.Logging.cs">
      <DependentUpon>IpcServer.cs</DependentUpon>
    </Compile>
    <Compile Update="Macros\Storage\MacroGraphStore.Logging.cs">
      <DependentUpon>MacroGraphStore.cs</DependentUpon>
    </Compile>
    <Compile Update="Orchestration\Orchestrator.Logging.cs">
      <DependentUpon>Orchestrator.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
