<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Общий словарь демона (Core) и панели (App): модель графа макроса, её чистый валидатор,
    DTO для провода и типы протокола IPC.

    ЖЁСТКОЕ ПРАВИЛО: единственная ссылка отсюда — SmartMacro.Native. Ничто в этой сборке не
    вправе затащить в процесс панели OpenCV, Tesseract или работу с файлами и реестром; типу,
    которому это нужно, место в Core.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro.Contracts</RootNamespace>
    <AssemblyName>SmartMacro.Contracts</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartMacro.Native\SmartMacro.Native.csproj" />
  </ItemGroup>

</Project>
