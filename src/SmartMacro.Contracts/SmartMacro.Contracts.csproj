<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ПРОТОКОЛ, на котором говорят демон (Core) и панель (App): конверт, каталог типов сообщений,
    DTO для провода, IpcJson/IpcPipe/IpcConnection, а также арифметика над путями
    (InstallationLayout, PeerExecutableLocator).

    ЖЁСТКОЕ ПРАВИЛО: ссылки отсюда — только SmartMacro.Native и SmartMacro.Shared, и НИКАКОГО
    файлового ввода-вывода, реестра и процессов. Ничто в этой сборке не вправе затащить в
    процесс панели OpenCV, Tesseract или работу с диском; типу, которому это нужно, место в
    Core, а если он нужен обеим сторонам — в Shared.

    Направление ссылки Contracts -> Shared, а не наоборот, и это не вкусовщина: нагрузки
    протокола УЖЕ упоминают домен (SaveMacroRequest несёт MacroGraph, ValidationIssueDto
    отображает ValidationIssue, а IpcJson собран копией MacroGraphJson.Options, чтобы файловый
    и проводной диалекты не разъехались). Обратного упоминания нет ни одного: модель, валидатор
    и бандл .hsm ничего не знают ни про конверт, ни про пайп — и знать не должны, потому что
    домен обязан читаться и без запущенного демона. Волна F3, где макрос перестаёт ходить по
    трубе вовсе, эту зависимость только истончит, но не развернёт: ValidationIssueDto останется.

    ⚠️ Закон «файлового IO нет» — про ЭТУ сборку. На Shared он НЕ распространяется: см.
    комментарий в SmartMacro.Shared.csproj, там правило своё.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro.Contracts</RootNamespace>
    <AssemblyName>SmartMacro.Contracts</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartMacro.Native\SmartMacro.Native.csproj" />
    <ProjectReference Include="..\SmartMacro.Shared\SmartMacro.Shared.csproj" />
  </ItemGroup>

</Project>
