<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PerfectWorldAgent.App.ViewModels"
        xmlns:conv="using:PerfectWorldAgent.App.Converters"
        xmlns:controls="using:PerfectWorldAgent.App.Controls"
        x:Class="PerfectWorldAgent.App.MacrosDialog"
        x:DataType="vm:MacrosDialogViewModel"
        Width="780" Height="720"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="Macros">

    <Window.DataTemplates>
        <!-- Polymorphic action rows. Avalonia matches by exact runtime type. -->
        <DataTemplate DataType="{x:Type vm:KeyPressRowViewModel}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,2">
                <TextBlock Grid.Column="0"
                           Text="Key"
                           FontSize="10"
                           Foreground="#888"
                           Width="50"
                           VerticalAlignment="Center" />
                <controls:KeyBindingPicker Grid.Column="1"
                                           Key="{Binding Key, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch" />
                <Button Grid.Column="2"
                        Content="↑"
                        FontSize="11"
                        Padding="8,2"
                        Margin="4,0,0,0"
                        Click="OnMoveActionUpClicked" />
                <Button Grid.Column="3"
                        Content="↓"
                        FontSize="11"
                        Padding="8,2"
                        Margin="2,0,0,0"
                        Click="OnMoveActionDownClicked" />
                <Button Grid.Column="4"
                        Content="×"
                        FontSize="11"
                        Padding="8,2"
                        Margin="4,0,0,0"
                        Click="OnRemoveActionClicked" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DelayRowViewModel}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,2">
                <TextBlock Grid.Column="0"
                           Text="Delay"
                           FontSize="10"
                           Foreground="#888"
                           Width="50"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding SecondsText, Mode=TwoWay}"
                         FontFamily="Consolas, monospace" />
                <TextBlock Grid.Column="2"
                           Text="sec"
                           FontSize="10"
                           Foreground="#aaa"
                           VerticalAlignment="Center"
                           Margin="6,0" />
                <Button Grid.Column="3"
                        Content="↑"
                        FontSize="11"
                        Padding="8,2"
                        Click="OnMoveActionUpClicked" />
                <Button Grid.Column="4"
                        Content="↓"
                        FontSize="11"
                        Padding="8,2"
                        Margin="2,0,0,0"
                        Click="OnMoveActionDownClicked" />
                <Button Grid.Column="5"
                        Content="×"
                        FontSize="11"
                        Padding="8,2"
                        Margin="4,0,0,0"
                        Click="OnRemoveActionClicked" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ClickRowViewModel}">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto,Auto" Margin="0,2">
                <TextBlock Grid.Column="0"
                           Text="Click"
                           FontSize="10"
                           Foreground="#888"
                           Width="50"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding XText, Mode=TwoWay}"
                         FontFamily="Consolas, monospace"
                         Watermark="X" />
                <TextBlock Grid.Column="2"
                           Text=","
                           FontSize="11"
                           Foreground="#666"
                           VerticalAlignment="Center"
                           Margin="6,0" />
                <TextBox Grid.Column="3"
                         Text="{Binding YText, Mode=TwoWay}"
                         FontFamily="Consolas, monospace"
                         Watermark="Y" />
                <CheckBox Grid.Column="4"
                          Content="dbl"
                          FontSize="10"
                          IsChecked="{Binding DoubleClick, Mode=TwoWay}"
                          Margin="8,0,0,0" />
                <Button Grid.Column="5"
                        Content="↑"
                        FontSize="11"
                        Padding="8,2"
                        Margin="4,0,0,0"
                        Click="OnMoveActionUpClicked" />
                <Button Grid.Column="6"
                        Content="↓"
                        FontSize="11"
                        Padding="8,2"
                        Margin="2,0,0,0"
                        Click="OnMoveActionDownClicked" />
                <Button Grid.Column="7"
                        Content="×"
                        FontSize="11"
                        Padding="8,2"
                        Margin="4,0,0,0"
                        Click="OnRemoveActionClicked" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock FontSize="14" Text="Macros" />
            <TextBlock FontSize="11"
                       Foreground="#888"
                       TextWrapping="Wrap"
                       Text="One macro per row. Each macro has per-class action blocks. Add Key or Delay actions in each block. Delays are in SECONDS (decimals OK — 1.5 = 1500ms). Save first, then Run." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,12"
                BorderThickness="1"
                BorderBrush="#333"
                CornerRadius="3">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MacroRowViewModel">
                            <Border Padding="10"
                                    Margin="6"
                                    BorderThickness="1"
                                    BorderBrush="#444"
                                    Background="#1a1a1a"
                                    CornerRadius="3">
                                <StackPanel Spacing="6">

                                    <!-- Macro header: name + Run + Remove -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="Name"
                                                   FontSize="10"
                                                   Foreground="#888"
                                                   Width="50"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Name, Mode=TwoWay}"
                                                 FontFamily="Consolas, monospace" />
                                        <Button Grid.Column="2"
                                                Content="Run"
                                                FontSize="11"
                                                Classes="accent"
                                                Margin="6,0,0,0"
                                                Click="OnRunClicked" />
                                        <Button Grid.Column="3"
                                                Content="Remove"
                                                FontSize="11"
                                                Margin="6,0,0,0"
                                                Click="OnRemoveClicked" />
                                    </Grid>

                                    <!-- Per-class blocks -->
                                    <ItemsControl ItemsSource="{Binding ClassPanels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MacroClassPanelViewModel">
                                                <Border Padding="8"
                                                        Margin="0,4"
                                                        BorderThickness="1"
                                                        BorderBrush="#3a3a3a"
                                                        Background="#242424"
                                                        CornerRadius="3">
                                                    <StackPanel Spacing="4">

                                                        <!-- Class dropdown + reorder + Remove -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Class"
                                                                       FontSize="10"
                                                                       Foreground="#888"
                                                                       Width="50"
                                                                       VerticalAlignment="Center" />
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{x:Static vm:MacroClassPanelViewModel.AllClasses}"
                                                                      SelectedItem="{Binding Class, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch" />
                                                            <Button Grid.Column="2"
                                                                    Content="↑"
                                                                    FontSize="11"
                                                                    Padding="8,4"
                                                                    Margin="6,0,0,0"
                                                                    Click="OnMoveClassPanelUpClicked" />
                                                            <Button Grid.Column="3"
                                                                    Content="↓"
                                                                    FontSize="11"
                                                                    Padding="8,4"
                                                                    Margin="2,0,0,0"
                                                                    Click="OnMoveClassPanelDownClicked" />
                                                            <Button Grid.Column="4"
                                                                    Content="Remove class"
                                                                    FontSize="11"
                                                                    Margin="6,0,0,0"
                                                                    Click="OnRemoveClassPanelClicked" />
                                                        </Grid>

                                                        <!-- Actions list (polymorphic via Window.DataTemplates) -->
                                                        <ItemsControl ItemsSource="{Binding Actions}" />

                                                        <!-- Add-action buttons -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                            <Button Content="+ Key"
                                                                    FontSize="11"
                                                                    Click="OnAddKeyPressClicked" />
                                                            <Button Content="+ Delay"
                                                                    FontSize="11"
                                                                    Click="OnAddDelayClicked" />
                                                            <Button Content="+ Click"
                                                                    FontSize="11"
                                                                    Click="OnAddClickClicked" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ Add class block"
                                            FontSize="11"
                                            HorizontalAlignment="Left"
                                            Margin="0,4,0,0"
                                            Click="OnAddClassPanelClicked" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2"
                   Foreground="#E06060"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:NotNullToBoolConverter.Instance}}"
                   Text="{Binding ErrorMessage}" />

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0"
                    Content="+ Add macro"
                    Click="OnAddClicked" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Click="OnCancel" />
                <Button x:Name="SaveButton"
                        Content="Save"
                        Classes="accent"
                        Click="OnSave" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
