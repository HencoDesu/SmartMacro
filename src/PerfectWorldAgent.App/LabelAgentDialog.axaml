<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PerfectWorldAgent.App.ViewModels"
        xmlns:conv="using:PerfectWorldAgent.App.Converters"
        xmlns:controls="using:PerfectWorldAgent.App.Controls"
        x:Class="PerfectWorldAgent.App.LabelAgentDialog"
        x:DataType="vm:LabelAgentDialogViewModel"
        Width="460" Height="440"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Label agent">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock FontSize="14" Text="Label this agent" />
            <TextBlock FontSize="11"
                       Foreground="#888"
                       Text="{Binding CurrentName, StringFormat='current: {0}'}" />
            <TextBlock FontSize="10"
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Text="Pick the character's class — it's the roster identity key. Class identification uses the in-game stats window (default hotkey C); make sure you've supplied a template PNG per class under Assets/ClassTemplates/." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16" Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock FontSize="11" Foreground="#aaa" Text="Character name" />
                <TextBox Text="{Binding Name, Mode=TwoWay}" />
            </StackPanel>

            <CheckBox Content="Is master (the lead character)"
                      IsChecked="{Binding IsMaster, Mode=TwoWay}" />

            <StackPanel Spacing="4">
                <TextBlock FontSize="11" Foreground="#aaa" Text="Class" />
                <ComboBox ItemsSource="{Binding ClassOptions}"
                          SelectedItem="{Binding Class, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                    <TextBlock FontSize="11" Foreground="#aaa" Text="Immunity" />
                    <controls:KeyBindingPicker Key="{Binding ImmunityKey, Mode=TwoWay}"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                    <TextBlock FontSize="11" Foreground="#aaa" Text="Assist" />
                    <controls:KeyBindingPicker Key="{Binding AssistKey, Mode=TwoWay}"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock FontSize="11" Foreground="#aaa" Text="Combat macro" />
                <ComboBox ItemsSource="{Binding MacroOptions}"
                          SelectedItem="{Binding CombatMacroName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <TextBlock Foreground="#E06060"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:NotNullToBoolConverter.Instance}}"
                       Text="{Binding ErrorMessage}" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="OnCancel" />
            <Button x:Name="SaveButton"
                    Content="Save"
                    Classes="accent"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
