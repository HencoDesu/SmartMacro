<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PerfectWorldAgent.App.ViewModels"
        xmlns:conv="using:PerfectWorldAgent.App.Converters"
        xmlns:controls="using:PerfectWorldAgent.App.Controls"
        x:Class="PerfectWorldAgent.App.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Width="520" Height="540"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Settings">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock FontSize="14" Text="Global hotkeys" />
            <TextBlock FontSize="11"
                       Foreground="#888"
                       TextWrapping="Wrap"
                       Text="Click a binding, then press the desired key combo (with modifiers). Escape cancels, Delete/Backspace clears. Saves to hotkeys.json next to the executable and re-registers immediately." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,12"
                BorderThickness="1"
                BorderBrush="#333"
                CornerRadius="3">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HotkeyBindingRow">
                            <Grid ColumnDefinitions="*,200" Margin="8,6">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Text="{Binding TriggerLabel}" />
                                <controls:KeyBindingPicker Grid.Column="1"
                                                           CaptureModifiers="True"
                                                           Modifiers="{Binding Modifiers, Mode=TwoWay}"
                                                           Key="{Binding Key, Mode=TwoWay}"
                                                           MouseButton="{Binding MouseButton, Mode=TwoWay}"
                                                           HorizontalAlignment="Stretch"
                                                           HorizontalContentAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2"
                   Foreground="#E06060"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:NotNullToBoolConverter.Instance}}"
                   Text="{Binding ErrorMessage}" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="OnCancel" />
            <Button x:Name="SaveButton"
                    Content="Save"
                    Classes="accent"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
