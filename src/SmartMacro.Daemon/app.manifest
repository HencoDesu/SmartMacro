<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="SmartMacro.Daemon"/>

  <!--
    asInvoker — и это НЕ упрощение, а условие, без которого галочка «работать с правами
    администратора» не имеет смысла: у процесса, помеченного requireAdministrator, проверять
    наличие повышения нечего, он иначе просто не стартует.

    Права по-прежнему нужны — UIPI блокирует SendMessage/PostMessage и обрезает PrintWindow от
    менее привилегированного процесса к более привилегированному, а клиенты Perfect World
    запускаются от администратора. Разница в том, КТО их запрашивает: не оболочка при каждом
    запуске файла, а сам демон при старте и только когда об этом просит настройка
    (Daemon/ElevationRelaunch). Снявший галочку получает демон без запроса UAC.

    ⚠️ Манифест ПАНЕЛИ асимметричен и остаётся requireAdministrator. Она снимает кадры окон
    игры через PrintWindow (сегодня — зрение, завтра — диалог выделения области), а из
    непривилегированного процесса это молча возвращает чёрный кадр. Симметрия здесь была бы
    красивой и неверной.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
