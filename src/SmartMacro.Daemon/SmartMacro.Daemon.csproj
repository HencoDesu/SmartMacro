<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: the daemon is windowless and must not flash a console window when
         it starts (typically from the shell / a shortcut, not a terminal). Serilog's console
         sink still works when it IS launched from one via `dotnet run`. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro.Daemon</RootNamespace>
    <AssemblyName>SmartMacro.Daemon</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartMacro.Contracts\SmartMacro.Contracts.csproj" />
    <ProjectReference Include="..\SmartMacro.Core\SmartMacro.Core.csproj" />
    <ProjectReference Include="..\SmartMacro.Native\SmartMacro.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Authoritative engine configuration. Moved here from SmartMacro.App in stage 2A —
         the daemon is the process that hosts the engine, so this is where its knobs live.
         App keeps a stripped-down copy only for as long as its transitional composition
         root survives (deleted in stage 3).
         The File sink runs with "shared": true — a rejected second instance must be able to
         append its "already running" line while the winner holds the same rolling file, and
         that only works if every writer opens it in shared mode. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Assets and tessdata physically live here as of stage 3 (they used to be linked out
         of SmartMacro.App). Everything that reads them — the vision pipeline, the template
         matcher, WindowIconService, Win32TrayIcon — runs in this process, so this is where
         they belong; the panel keeps only its own embedded window icon.
         Copied rather than embedded so the user can add or retouch a template without a
         rebuild. -->
    <None Include="tessdata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Tray icon, loaded from disk by Win32TrayIcon (LoadImage + LR_LOADFROMFILE). -->
    <None Include="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Per-tag taskbar icons. A SetIconNode names the file (typically
         "Assets/ClassIcons/{tag}.png"); WindowIconService resolves it and skips with a
         Debug log when it's missing. -->
    <None Include="Assets\ClassIcons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Tag templates for the stats-window template-match identification path
         (filename stem = tag). -->
    <None Include="Assets\GameClassNames\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Single UI-element templates, referenced by file stem from Find/Wait nodes. -->
    <None Include="Assets\GameUiElements\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- User-authored template SETS for RecognizeTag nodes: Assets/templates/{set}/{tag}.png.
         Empty in the repo — the glob exists so a set dropped in here reaches the output on
         the next build. -->
    <None Include="Assets\templates\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
