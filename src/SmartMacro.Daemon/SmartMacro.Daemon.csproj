<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, а не Exe: у демона нет окон, и мигать консолью при старте он не должен —
         запускают его обычно из оболочки или по ярлыку, а не из терминала. Консольный сток
         Serilog при этом продолжает работать, если его всё-таки подняли через dotnet run. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro.Daemon</RootNamespace>
    <AssemblyName>SmartMacro.Daemon</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Инструмент только под Windows и только x64 (инъекция сообщений Win32,
         requireAdministrator, PrintWindow), так что везти каждый RID, который пакет решил
         положить, незачем. Без этого один только OpenCvSharp4.runtime.win клал
         runtimes/win-x86 рядом с runtimes/win-x64 — 148 МБ runtimes/ на выхлоп, которому
         нужно оттуда 85. Выхлоп: 169 МБ → 107 МБ (и → 91 МБ, когда стадия 4B убрала из
         проекта нативные блобы Tesseract и tessdata; см. SmartMacro.Core.csproj).
         Оперативной памяти это не стоит ни так, ни эдак — лишние RID никогда не грузились;
         речь только про размер выхлопа и время копирования.
         SelfContained=false: с .NET 6 «под конкретный RID» перестало означать
         «самодостаточный», но лучше сказать вслух — случайно самодостаточный демон это
         apphost на 70 МБ.
         AppendRuntimeIdentifierToOutputPath=false: оставляет путь выхлопа как
         bin/Debug/net10.0-windows/. Панель и демон находят друг друга подменой сегмента с
         именем проекта в остальном одинакового пути, и этот путь описан в CLAUDE.md —
         сегмент win-x64/ сломал бы обоих. Нативные блобы при этом просто переезжают из
         runtimes/win-x64/native/ в корень выхлопа, куда загрузчик и смотрит первым делом
         (проверено: OpenCvSharpExtern по-прежнему находится на первом же вызове vision). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartMacro.Contracts\SmartMacro.Contracts.csproj" />
    <ProjectReference Include="..\SmartMacro.Core\SmartMacro.Core.csproj" />
    <ProjectReference Include="..\SmartMacro.Native\SmartMacro.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Конфигурация Serilog, и только она: все ручки движка уехали в settings.json,
         которым владеет SettingsStore. Уровень журнала здесь остаётся намеренно — если демон
         споткнётся на чтении настроек, отладить это можно лишь тем уровнем, что был известен
         ДО. Сток File работает с "shared": true — отвергнутый второй экземпляр обязан суметь
         дописать свою строку «уже запущен», пока победитель держит тот же роллинговый файл, а
         это работает, только если каждый пишущий открывает его в разделяемом режиме. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Активы физически лежат здесь начиная со стадии 3 (раньше линковались из
         SmartMacro.App). Всё, что их читает, — конвейер vision, сопоставитель шаблонов,
         WindowIconService, Win32TrayIcon — работает в этом процессе, так что им тут и место;
         панели остаётся только её собственная встроенная иконка окна.
         Копируются, а не встраиваются, чтобы пользователь мог добавить или подправить шаблон
         без пересборки.
         Рядом с ними лежал tessdata\; стадия 4B его удалила. Читал его единственный
         TesseractCoordinateReader, которого демон не поднимает, — языковой пакет теперь живёт
         только при tools/VisionSampleRunner. -->
    <!-- Иконка трея, читается с диска в Win32TrayIcon (LoadImage + LR_LOADFROMFILE). -->
    <None Include="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Иконки панели задач по тегам. Файл называет нода SetIcon (обычно
         «Assets/ClassIcons/{tag}.png»); WindowIconService разрешает путь, а когда файла нет —
         пропускает, записав строку уровня Debug. -->
    <None Include="Assets\ClassIcons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- ⚠️ Дерева шаблонов зрения здесь БОЛЬШЕ НЕТ, и это волна F2, а не пропажа.

         Раньше отсюда ехал Assets\templates\**\*.png с Link=templates\..., то есть в корень
         установки, где его читал общий на всё приложение TemplateSetProvider. Общего дерева не
         стало: шаблон живёт внутри бандла .hsm того макроса, который его называет (§5.7 спеки),
         и никакой сборкой в путь выполнения не попадает вовсе.

         Исходники самих PNG никуда не делись — четырнадцать файлов, из них одиннадцать имён
         классов, вырезанных вручную из игры на экране 3840x2160, — они лежат в assets\templates\
         В КОРНЕ РЕПОЗИТОРИЯ: снаружи любого проекта, так что ни один glob их случайно не
         подхватит, но под git и под рукой, чтобы перетащить нужный в свой макрос кнопкой
         «+ файл…» в редакторе. -->
  </ItemGroup>

</Project>
