<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Общий ДОМЕН демона и панели: модель графа макроса, её чистый валидатор, чистые анализы
    (переменные, шаблоны) и чтение/запись бандла .hsm.

    ПРАВИЛО ЭТОЙ СБОРКИ — НЕ ТО ЖЕ САМОЕ, ЧТО У Contracts, и путать их дорого. У Contracts
    закон: ссылка только на Native и никакого файлового ввода-вывода. Shared его НЕ наследует —
    читать и писать .hsm обязаны обе стороны, а это System.IO.Compression, то есть файлы.

    Правило Shared формулируется так: общий домен; файлы можно, OpenCV и Tesseract нельзя.
    Второй половине правила цена известна: ссылка App -> Core снята именно для того, чтобы
    нативные блобы машинного зрения не приезжали в процесс, который пользователь открывает и
    закрывает по десять раз на дню. Shared видят оба процесса, значит всё, что сюда затащат,
    поедет и в панель. «Раз уж файлы можно, положим сюда и чтение шаблонов через OpenCV» — это
    ровно то, чего здесь быть не должно; такому типу место в Core.

    RootNamespace = SmartMacro (не SmartMacro.Shared) намеренно: пространства имён модели —
    SmartMacro.Macros.* ещё с тех пор, когда она жила в Core, и переезд сюда их не меняет.
    С таким корнем папка Macros\Model даёт ровно SmartMacro.Macros.Model, и ни один using в
    дереве править не пришлось. Тот же приём, что и в SmartMacro.Core.csproj.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro</RootNamespace>
    <AssemblyName>SmartMacro.Shared</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ScreenPoint / ScreenRect и коды клавиш — модель нод описывает координаты и ввод ими. -->
    <ProjectReference Include="..\SmartMacro.Native\SmartMacro.Native.csproj" />
  </ItemGroup>

  <!--
    ВЕСЬ ТЕКСТ ДВИЖКА, КОТОРЫЙ ВИДИТ ЧЕЛОВЕК, ЛЕЖИТ В Resources\Strings.Engine.resx, и лежит
    он в Shared по той же причине, по которой здесь валидатор: замечания судят бандл ОБА
    процесса, и разъехаться их формулировкам негде — источник один. Правила сборки это не
    нарушает: resx — это данные, ни файлов, ни OpenCV он сюда не тащит.

    Класс доступа ПОРОЖДАЕТСЯ НА КАЖДОЙ СБОРКЕ, а не лежит в дереве .Designer.cs, и это
    решение, а не экономия. Файл строк — рабочий документ для вычитки: формулировки в нём
    правят и УДАЛЯЮТ. Сверстанный руками класс-спутник на удаление записи не реагирует —
    ResourceManager вернул бы null, и на экране появилась бы пустота там, где была фраза.
    Порождение из самого resx даёт обратное: снятая запись исчезает как член класса, и
    компилятор перечисляет все места, где она печаталась. Штатного генератора у SDK нет
    (GenerateResxSource — из Arcade, не отсюда), а ResXFileCodeGenerator — это средство IDE и
    в `dotnet build` не участвует; XmlPeek + WriteLinesToFile обходятся без обоих.

    Порождённый файл лежит в obj\ — его не видят ни глоб исходников, ни тесты папки Sources,
    которые читают дерево. Имя ресурса («SmartMacro.Resources.Strings.Engine») складывается из
    RootNamespace и пути к resx; менять путь, не поменяв строку в цели, нельзя — тесты
    EngineStringsTests ловят это сразу и целиком.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.Engine.resx" />
  </ItemGroup>

  <Target Name="GenerateEngineStrings"
          Inputs="Resources\Strings.Engine.resx"
          Outputs="$(IntermediateOutputPath)Strings.Engine.g.cs">
    <XmlPeek XmlInputPath="Resources\Strings.Engine.resx" Query="/root/data/@name">
      <Output TaskParameter="Result" ItemName="EngineStringKey" />
    </XmlPeek>

    <ItemGroup>
      <EngineStringsLine Include="// &lt;auto-generated /&gt; Порождено целью GenerateEngineStrings из Resources\Strings.Engine.resx." />
      <EngineStringsLine Include="#nullable enable" />
      <EngineStringsLine Include="namespace SmartMacro.Resources%3B" />
      <EngineStringsLine Include="/// &lt;summary&gt;Тексты движка, обращённые к человеку. Правятся в Strings.Engine.resx.&lt;/summary&gt;" />
      <EngineStringsLine Include="public static class Strings_Engine" />
      <EngineStringsLine Include="{" />
      <EngineStringsLine Include="    /// &lt;summary&gt;Читатель ресурсов сборки.&lt;/summary&gt;" />
      <EngineStringsLine Include="    public static global::System.Resources.ResourceManager ResourceManager { get%3B } = new(&quot;SmartMacro.Resources.Strings.Engine&quot;, typeof(Strings_Engine).Assembly)%3B" />
      <EngineStringsLine Include="    /// &lt;summary&gt;Язык. &lt;c&gt;null&lt;/c&gt; — язык системы%3B здесь будет переключатель, когда появится перевод.&lt;/summary&gt;" />
      <EngineStringsLine Include="    public static global::System.Globalization.CultureInfo? Culture { get%3B set%3B }" />
      <EngineStringsLine Include="@(EngineStringKey->'    public static string %(Identity) =&gt; ResourceManager.GetString(&quot;%(Identity)&quot;, Culture)!%3B')" />
      <EngineStringsLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(IntermediateOutputPath)Strings.Engine.g.cs"
                      Lines="@(EngineStringsLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="utf-8" />
  </Target>

  <Target Name="IncludeEngineStrings" BeforeTargets="CoreCompile" DependsOnTargets="GenerateEngineStrings">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Strings.Engine.g.cs" />
    </ItemGroup>
  </Target>

</Project>
