<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Общий ДОМЕН демона и панели: модель графа макроса, её чистый валидатор, чистые анализы
    (переменные, шаблоны) и чтение/запись бандла .hsm.

    ПРАВИЛО ЭТОЙ СБОРКИ — НЕ ТО ЖЕ САМОЕ, ЧТО У Contracts, и путать их дорого. У Contracts
    закон: ссылка только на Native и никакого файлового ввода-вывода. Shared его НЕ наследует —
    читать и писать .hsm обязаны обе стороны, а это System.IO.Compression, то есть файлы.

    Правило Shared формулируется так: общий домен; файлы можно, OpenCV и Tesseract нельзя.
    Второй половине правила цена известна: ссылка App -> Core снята именно для того, чтобы
    нативные блобы машинного зрения не приезжали в процесс, который пользователь открывает и
    закрывает по десять раз на дню. Shared видят оба процесса, значит всё, что сюда затащат,
    поедет и в панель. «Раз уж файлы можно, положим сюда и чтение шаблонов через OpenCV» — это
    ровно то, чего здесь быть не должно; такому типу место в Core.

    RootNamespace = SmartMacro (не SmartMacro.Shared) намеренно: пространства имён модели —
    SmartMacro.Macros.* ещё с тех пор, когда она жила в Core, и переезд сюда их не меняет.
    С таким корнем папка Macros\Model даёт ровно SmartMacro.Macros.Model, и ни один using в
    дереве править не пришлось. Тот же приём, что и в SmartMacro.Core.csproj.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro</RootNamespace>
    <AssemblyName>SmartMacro.Shared</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ScreenPoint / ScreenRect и коды клавиш — модель нод описывает координаты и ввод ими. -->
    <ProjectReference Include="..\SmartMacro.Native\SmartMacro.Native.csproj" />
  </ItemGroup>

  <!--
    ТЕКСТЫ ИНТЕРФЕЙСА. Причина, по которой они здесь, а не в App: сборку видят обе стороны, а
    пользовательские тексты валидатора тут уже лежали.

    Класс-обёртку генерирует MSBuild (задача GenerateResource), а НЕ студийный ResXFileCodeGenerator:
    гейт этого проекта — dotnet build, и «сгенерируется, когда кто-нибудь откроет решение в Visual
    Studio» здесь не работает. Метаданные Generator/LastGenOutput оставлены только затем, чтобы
    студия не пыталась сгенерировать второй, конфликтующий файл.

    StronglyTypedFileName ведёт в obj\: порождённый код не должен попадаться ни на глаза, ни
    сканерам исходников из tests/Sources (они пропускают bin и obj по имени папки).

    PublicClass=true обязателен: класс читают из ДРУГИХ сборок — из App и из разметки Avalonia
    через {x:Static}. Умолчание у задачи — internal, и с ним всё это не собралось бы.

    ⚠️ LogicalName — не украшение, а единственное, что здесь вообще работает. Имя ресурса в
    манифесте по умолчанию берётся из ПУТИ файла (Resources\Strings.resx при
    RootNamespace=SmartMacro даёт SmartMacro.Resources.Strings), а имя, которое порождённый
    класс передаёт в ResourceManager, — из ИМЕНИ КЛАССА (SmartMacro.Resources.Strings). Точка
    против подчёркивания: имена не совпадают, сборка проходит молча, а первое же чтение строки
    падает в рантайме MissingManifestResourceException — то есть на живой панели и мимо всех
    тестов. LogicalName выравнивает их, задавая имя в манифесте напрямую.

    Соседний рычаг StronglyTypedManifestPrefix для этого НЕ годится, и это проверено: задача
    склеивает его с именем класса через точку, так что «SmartMacro.Resources» превращается в
    «SmartMacro.Resources.Strings» (то есть в умолчание), а попытка задать полный путь даёт
    «SmartMacro.Resources.Strings.Strings». Совпасть с путём файла, в котором есть точка,
    им нельзя в принципе.
  -->
  <ItemGroup>
    <!-- ⚠️ Ни Generator, ни LastGenOutput здесь БЫТЬ НЕ ДОЛЖНО, хотя соблазн велик.
         Их заводили с мыслью «пусть студия знает и не порождает второй файл», но работают они
         наоборот: `Generator` — это и есть указание среде ЗАПУСТИТЬ свой генератор, а
         `LastGenOutput` обещает `Resources\Strings.Designer.cs`, которого рядом нет. В итоге
         среда либо ищет несуществующий файл, либо порождает его сама — и тогда класс Strings
         объявлен дважды. Порождает его здесь ровно один хозяин: задача GenerateResource. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>SmartMacro.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <LogicalName>SmartMacro.Resources.Strings.resources</LogicalName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>

    <!-- ⚠️ ЭТО ДЛЯ IDE, А НЕ ДЛЯ КОМПИЛЯТОРА, и без него редактор краснеет весь.
         `GenerateResource` сама выдаёт порождённый файл в Compile — но ВО ВРЕМЯ СБОРКИ, из
         тела цели. Модель проекта, по которой Rider разрешает имена, строится вычислением, а
         цели при вычислении не выполняются: класс Strings компилируется прекрасно и при этом
         «не существует» для редактора. Симптом ровно такой — сборка зелёная, а все шестьсот с
         лишним обращений подчёркнуты.
         Дубликат, который добавит цель, снимает DeduplicateGeneratedStrings ниже. -->
    <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" Visible="false" />
  </ItemGroup>

  <!-- Схлопывает пару «наш статический Include + Output цели GenerateResource» обратно в одну
       запись. Без этого компилятор получает один и тот же файл дважды и выдаёт CS2002, а
       предупреждение в проекте, где гейт — чистая сборка, равносильно поломке.

       Две тонкости, каждая из которых стоила попытки:

       · `BeforeTargets="CoreCompile"`, а НЕ `AfterTargets="GenerateResource"`. На инкрементальной
         сборке `GenerateResource` пропускается как актуальная — вместе с ней не сработала бы и
         очистка, и дубликат выжил бы ровно в полной сборке, то есть в той, которой проверяют.
       · Отбор по имени файла, а не `Remove` по пути: цель кладёт в `Compile` путь в своей форме,
         и совпасть с написанным здесь он не обязан. Сравнение метаданных от формы не зависит. -->
  <Target Name="DeduplicateGeneratedStrings" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Filename)%(Extension)' == 'Strings.Designer.cs'" />
      <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
