<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro.Native</RootNamespace>
    <AssemblyName>SmartMacro.Native</AssemblyName>
    <!-- LibraryImport source generators emit unsafe ref-handling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Швы для тестов у колбэков хуков: поставить настоящий WH_MOUSE_LL из теста нельзя (нужен
         сеанс рабочего стола), а проверять там есть что — колбэк обязан возвращаться, не дождавшись
         подписчика. Внутренними, а не публичными: это шов, а не поверхность сборки. -->
    <InternalsVisibleTo Include="SmartMacro.Tests" />
  </ItemGroup>

</Project>
