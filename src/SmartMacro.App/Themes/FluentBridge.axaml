<!--
  Nocturne — мостик к FluentTheme (волна D1).

  Controls.axaml заменяет те темы контролов Fluent, которые нам важны. Всё оставшееся —
  Window, Popup, FlyoutPresenter, MenuFlyout, ToolTip, TitleBar — по-прежнему рисуется
  шаблонами самой Fluent, а те берут цвета из КЛЮЧЕЙ ресурсов Fluent. Этот файл
  перенаправляет такие ключи на токены Nocturne, и остатки без своей темы перестают быть
  серой виндовой оправой, притом что шаблон для них никому писать не пришлось.

  Почему это работает: поиск DynamicResource идёт по логическому дереву вверх до Application,
  а Application.Resources (куда подмешан этот словарь) просматривается РАНЬШЕ, чем
  Application.Styles (где FluentTheme держит свои словари). Ключ тот же — побеждает наш.

  Держите этот файл МАЛЕНЬКИМ и скучным. Всё, что заслуживает настоящего внимания дизайнера,
  должно получить ControlTheme в Controls.axaml, а не ещё один ключ здесь. От волны D2 ждут,
  что записи отсюда будут удаляться, а не добавляться.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         ШТАТНЫЙ СИНИЙ
         Fluent выводит каждую «акцентную» кисть из этих шести цветов, а виндовое значение по
         умолчанию — синий, не имеющий к этой системе никакого отношения. Перекрытие палитры в
         корне отправляет его на пенсию разом и повсюду: выделение, подсветка, отрисовка
         фокуса в контролах, которых мы вообще не касались.
         ================================================================ -->

    <StaticResource x:Key="SystemAccentColor" ResourceKey="NocturneAccentColor" />
    <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="NocturneAccent400Color" />
    <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="NocturneAccent300Color" />
    <StaticResource x:Key="SystemAccentColorLight3" ResourceKey="NocturneAccent200Color" />
    <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="NocturneAccent600Color" />
    <StaticResource x:Key="SystemAccentColorDark2" ResourceKey="NocturneAccent700Color" />
    <StaticResource x:Key="SystemAccentColorDark3" ResourceKey="NocturneAccent800Color" />

    <!-- ================================================================
         НИ ЧИСТО ЧЁРНОГО, НИ ЧИСТО БЕЛОГО
         Тёмная Fluent кладёт окна на #000000 и пишет текст в #FFFFFF. Оба цвета из системы
         исключены; эти два ключа — та самая дверь, через которую они входят.
         ================================================================ -->

    <SolidColorBrush x:Key="SystemRegionBrush" Color="{DynamicResource NocturneGroundColor}" />
    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{DynamicResource NocturneGroundColor}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource NocturneTextColor}" />

    <!-- ================================================================
         ПЛАВАЮЩИЕ ПОВЕРХНОСТИ — flyout'ы, меню, подсказки.
         Все три Fluent пропускает через эти ключи transient/chrome.
         ================================================================ -->

    <SolidColorBrush x:Key="SystemControlTransientBackgroundBrush" Color="{DynamicResource NocturneSurfaceOverlayColor}" />
    <SolidColorBrush x:Key="SystemControlTransientBorderBrush" Color="{DynamicResource NocturneDividerStrongColor}" />
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="{DynamicResource NocturneSurfaceOverlayColor}" />

    <!-- Заливка при наведении и нажатии внутри меню, прямо со шкалы акцентных оттенков. -->
    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{DynamicResource NocturneAccentTint12Color}" />
    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{DynamicResource NocturneAccentTint22Color}" />
    <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush" Color="{DynamicResource NocturneTextColor}" />

    <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>
    <Thickness x:Key="FlyoutContentThemePadding">5.6</Thickness>
    <Thickness x:Key="MenuFlyoutItemThemePadding">8.4,5.6</Thickness>
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">2.8</Thickness>
    <Thickness x:Key="ToolTipBorderThemePadding">8.4,5.6</Thickness>
    <x:Double x:Key="ToolTipContentThemeFontSize">11</x:Double>

    <!-- Квадратик в 1px, который Fluent ставит на стыке двух полос прокрутки. Наши — накладные. -->
    <SolidColorBrush x:Key="ScrollViewerScrollBarsSeparatorBackground" Color="Transparent" />

    <!-- ================================================================
         ШРИФТ
         Fluent и так просит здесь "fonts:Inter#Inter, $Default" — ту самую коллекцию
         Avalonia.Fonts.Inter, которую регистрирует Program.BuildAvaloniaApp().WithInterFont(),
         а за ней Segoe UI на те глифы, которых у Inter нет. Цепочка та же, что и у
         NocturneFontFamily; меняется только размер основного текста — вниз, до масштаба 0.7×.
         ================================================================ -->

    <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter, $Default</FontFamily>
    <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>

</ResourceDictionary>
