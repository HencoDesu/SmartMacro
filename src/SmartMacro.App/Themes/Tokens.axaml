<!--
  Nocturne — слой токенов (волна D1).

  Источник истины: docs/design/nocturne-tokens.md, а значения, выходящие за шкалы, взяты
  дословно из docs/design/opt-1b.html. Здесь никто ничего не знает о контролах; Controls.axaml
  и представления потребляют эти токены и только их. Если представлению понадобился цвет,
  которого в этом файле нет, лечится это новым именованным токеном здесь — но никак не
  литералом в разметке.

  ИМЕНОВАНИЕ (держитесь его — D2 и D3 будут ссылаться на это постоянно):

    Nocturne <Роль|Шкала+Ступень|Семантика> <Вид?>

    …Color        Color,        например NocturneAccent500Color
    …Brush        SolidColorBrush поверх того же значения, например NocturneAccent500Brush
    NocturneSpaceN     double, где N — номер ступени на шкале 0.7× (1 2 3 4 6 8)
    NocturneRadius*    CornerRadius (Sm / Md / Lg / Pill)
    NocturneInset*     Thickness под padding
    NocturneShadow*    BoxShadows (Sm / Md / Lg)
    NocturneFontSize*  double
    NocturneFontFamily / …Mono   FontFamily

  Обе шкалы существуют целиком (нейтральная 100–900, акцентная 100–900), даже там, где ступень
  пока никто не потребляет: шкала — это единая лестница светлоты, и выбор «следующей ступени»
  ровно то, чем система держится связной. Промежуточных ступеней не добавлять.

  ПРАВИЛА, живущие прямо в значениях (см. §"Правила" в документе о токенах):
    · Акцент — это линия и свечение, но никогда не заливка; отсюда кисти AccentTint* и полное
      отсутствие токена вида «акцентная заливка».
    · Нигде ни чисто чёрного, ни чисто белого, кроме теней, где чёрный — это окружающая тьма,
      а не цвет.
    · Шкала отступов мелкая намеренно (плотность 0.7×). Округлять её вверх не надо.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         РОЛИ
         ================================================================ -->

    <Color x:Key="NocturneBgColor">#161826</Color>
    <Color x:Key="NocturneSurfaceColor">#232532</Color>
    <Color x:Key="NocturneTextColor">#e9e9ed</Color>
    <Color x:Key="NocturneAccentColor">#9184d9</Color>

    <SolidColorBrush x:Key="NocturneBgBrush" Color="{StaticResource NocturneBgColor}" />
    <SolidColorBrush x:Key="NocturneSurfaceBrush" Color="{StaticResource NocturneSurfaceColor}" />
    <SolidColorBrush x:Key="NocturneTextBrush" Color="{StaticResource NocturneTextColor}" />
    <SolidColorBrush x:Key="NocturneAccentBrush" Color="{StaticResource NocturneAccentColor}" />

    <!-- Ролевой токен "color-divider": текст с прозрачностью 16%. Это волосяная линия системы;
         собственные разделители макета (ниже) непрозрачны и чуть холоднее. -->
    <SolidColorBrush x:Key="NocturneHairlineBrush" Color="#29e9e9ed" />

    <!-- ================================================================
         НЕЙТРАЛЬНАЯ ШКАЛА  (OKLCH, единая лестница светлоты — равный шаг = равный вес)
         ================================================================ -->

    <Color x:Key="NocturneNeutral100Color">#f3f5fe</Color>
    <Color x:Key="NocturneNeutral200Color">#e4e7f5</Color>
    <Color x:Key="NocturneNeutral300Color">#cfd3e5</Color>
    <Color x:Key="NocturneNeutral400Color">#b2b6ca</Color>
    <Color x:Key="NocturneNeutral500Color">#9397ab</Color>
    <Color x:Key="NocturneNeutral600Color">#75798c</Color>
    <Color x:Key="NocturneNeutral700Color">#595d6c</Color>
    <Color x:Key="NocturneNeutral800Color">#3f424d</Color>
    <Color x:Key="NocturneNeutral900Color">#292b31</Color>

    <SolidColorBrush x:Key="NocturneNeutral100Brush" Color="{StaticResource NocturneNeutral100Color}" />
    <SolidColorBrush x:Key="NocturneNeutral200Brush" Color="{StaticResource NocturneNeutral200Color}" />
    <SolidColorBrush x:Key="NocturneNeutral300Brush" Color="{StaticResource NocturneNeutral300Color}" />
    <SolidColorBrush x:Key="NocturneNeutral400Brush" Color="{StaticResource NocturneNeutral400Color}" />
    <SolidColorBrush x:Key="NocturneNeutral500Brush" Color="{StaticResource NocturneNeutral500Color}" />
    <SolidColorBrush x:Key="NocturneNeutral600Brush" Color="{StaticResource NocturneNeutral600Color}" />
    <SolidColorBrush x:Key="NocturneNeutral700Brush" Color="{StaticResource NocturneNeutral700Color}" />
    <SolidColorBrush x:Key="NocturneNeutral800Brush" Color="{StaticResource NocturneNeutral800Color}" />
    <SolidColorBrush x:Key="NocturneNeutral900Brush" Color="{StaticResource NocturneNeutral900Color}" />

    <!-- ================================================================
         АКЦЕНТНАЯ ШКАЛА
         В монохромной схеме accent-2 читается как акцент — второй акцентной роли не существует.
         ================================================================ -->

    <Color x:Key="NocturneAccent100Color">#f5f4ff</Color>
    <Color x:Key="NocturneAccent200Color">#e7e5fe</Color>
    <Color x:Key="NocturneAccent300Color">#d2cefd</Color>
    <Color x:Key="NocturneAccent400Color">#b5abfc</Color>
    <Color x:Key="NocturneAccent500Color">#968ae0</Color>
    <Color x:Key="NocturneAccent600Color">#796cbf</Color>
    <Color x:Key="NocturneAccent700Color">#5d5294</Color>
    <Color x:Key="NocturneAccent800Color">#423a6a</Color>
    <Color x:Key="NocturneAccent900Color">#2b2741</Color>

    <SolidColorBrush x:Key="NocturneAccent100Brush" Color="{StaticResource NocturneAccent100Color}" />
    <SolidColorBrush x:Key="NocturneAccent200Brush" Color="{StaticResource NocturneAccent200Color}" />
    <SolidColorBrush x:Key="NocturneAccent300Brush" Color="{StaticResource NocturneAccent300Color}" />
    <SolidColorBrush x:Key="NocturneAccent400Brush" Color="{StaticResource NocturneAccent400Color}" />
    <SolidColorBrush x:Key="NocturneAccent500Brush" Color="{StaticResource NocturneAccent500Color}" />
    <SolidColorBrush x:Key="NocturneAccent600Brush" Color="{StaticResource NocturneAccent600Color}" />
    <SolidColorBrush x:Key="NocturneAccent700Brush" Color="{StaticResource NocturneAccent700Color}" />
    <SolidColorBrush x:Key="NocturneAccent800Brush" Color="{StaticResource NocturneAccent800Color}" />
    <SolidColorBrush x:Key="NocturneAccent900Brush" Color="{StaticResource NocturneAccent900Color}" />

    <!-- ================================================================
         АКЦЕНТНЫЕ ОТТЕНКИ — та половина правила про акцент, что отвечает за «свечение».
         Проценты акцента поверх того, что оказалось сзади. Это ЕДИНСТВЕННЫЙ способ, которым
         акценту позволено занимать площадь; сплошной акцентный прямоугольник — это баг.
         ================================================================ -->

    <Color x:Key="NocturneAccentTint08Color">#149184d9</Color>
    <Color x:Key="NocturneAccentTint12Color">#1f9184d9</Color>
    <Color x:Key="NocturneAccentTint15Color">#269184d9</Color>
    <Color x:Key="NocturneAccentTint18Color">#2e9184d9</Color>
    <Color x:Key="NocturneAccentTint22Color">#389184d9</Color>

    <SolidColorBrush x:Key="NocturneAccentTint08Brush" Color="{StaticResource NocturneAccentTint08Color}" />
    <SolidColorBrush x:Key="NocturneAccentTint12Brush" Color="{StaticResource NocturneAccentTint12Color}" />
    <SolidColorBrush x:Key="NocturneAccentTint15Brush" Color="{StaticResource NocturneAccentTint15Color}" />
    <SolidColorBrush x:Key="NocturneAccentTint18Brush" Color="{StaticResource NocturneAccentTint18Color}" />
    <SolidColorBrush x:Key="NocturneAccentTint22Brush" Color="{StaticResource NocturneAccentTint22Color}" />

    <!-- Семантические псевдонимы для двух состояний взаимодействия, названных в документе о
         токенах явно. -->
    <SolidColorBrush x:Key="NocturneHoverBrush" Color="{StaticResource NocturneAccentTint12Color}" />
    <SolidColorBrush x:Key="NocturnePressedBrush" Color="{StaticResource NocturneAccentTint22Color}" />

    <!-- ================================================================
         СЕМАНТИЧЕСКИЕ ПОВЕРХНОСТИ
         Значения, которые макет берёт сверх шкал (документ о токенах, §"Значения, взятые
         макетом сверх системы"). Осознанные локальные оттенки под плотный инструмент —
         именованные, но никогда не вписанные по месту.
         ================================================================ -->

    <!-- Земля, на которой стоит всё окно (фон body в документе дизайна). -->
    <Color x:Key="NocturneGroundColor">#0d0e16</Color>
    <SolidColorBrush x:Key="NocturneGroundBrush" Color="{StaticResource NocturneGroundColor}" />

    <!-- Утопленная: боковые панели, жёлоба — читается как то, что лежит за плоскостью контента. -->
    <SolidColorBrush x:Key="NocturneSurfaceSunkenBrush" Color="#131420" />
    <!-- Приподнятая: полосы шапки и подвала, обрамляющие рабочую область. -->
    <SolidColorBrush x:Key="NocturneSurfaceRaisedBrush" Color="#191b28" />
    <!-- Накладная: строка заголовка, всплывающие окна, всё, что парит над плоскостью. -->
    <Color x:Key="NocturneSurfaceOverlayColor">#1c1e2a</Color>
    <SolidColorBrush x:Key="NocturneSurfaceOverlayBrush" Color="{StaticResource NocturneSurfaceOverlayColor}" />
    <!-- Вставка: волосяной зазор между строками списка, мелкие фишки с кодом. -->
    <SolidColorBrush x:Key="NocturneSurfaceInsetBrush" Color="#20222f" />
    <!-- Чередующаяся строка списка на фоне NocturneBg. -->
    <SolidColorBrush x:Key="NocturneSurfaceRowAltBrush" Color="#181a27" />
    <!-- Строка, которая есть, но пока не опознана, — тусклее обоих цветов строк. -->
    <SolidColorBrush x:Key="NocturneSurfaceRowMutedBrush" Color="#14151f" />

    <!-- Затухающая линейка рядом с разделителем «не опознано · N» (D2). Это градиент, а не
         цвет, поэтому ему место здесь, а не в представлении: #332d1f — это граница
         предупреждения, притемнённая до волосяной линии и растворяющаяся вправо. -->
    <LinearGradientBrush x:Key="NocturneUntaggedRuleBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#332d1f" />
        <GradientStop Offset="1" Color="#00332d1f" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="NocturneDividerBrush" Color="#262939" />
    <Color x:Key="NocturneDividerStrongColor">#2b2e3d</Color>
    <SolidColorBrush x:Key="NocturneDividerStrongBrush" Color="{StaticResource NocturneDividerStrongColor}" />

    <!-- Поля формы. В покое граница остаётся нейтральной; фокус — это акцентная линия. -->
    <SolidColorBrush x:Key="NocturneFieldBackgroundBrush" Color="#1b1d29" />
    <SolidColorBrush x:Key="NocturneFieldBorderBrush" Color="#33364a" />

    <!-- ================================================================
         СЕМАНТИЧЕСКИЙ ТЕКСТ
         Контраст акцента к земле примерно 3:1 — годится для иконок, оправы и крупного текста,
         но НЕ для основного текста. Абзацы акцентом набираются NocturneAccent300Brush.
         ================================================================ -->

    <SolidColorBrush x:Key="NocturneTextSecondaryBrush" Color="{StaticResource NocturneNeutral300Color}" />
    <!-- Приглушённый: строка, с которой сняли акцент, но читать её всё ещё предполагается. -->
    <SolidColorBrush x:Key="NocturneTextMutedBrush" Color="#8b8fa2" />
    <!-- Бледный: счётчики, hwnd в шестнадцатеричном виде, прошедшее время. -->
    <SolidColorBrush x:Key="NocturneTextFaintBrush" Color="#5f6376" />
    <!-- Призрачный: надзаголовки капслоком над разделом. -->
    <SolidColorBrush x:Key="NocturneTextGhostBrush" Color="#4e5265" />

    <!-- ================================================================
         СТАТУСЫ
         ================================================================ -->

    <Color x:Key="NocturneWarningColor">#dbb277</Color>
    <SolidColorBrush x:Key="NocturneWarningBrush" Color="{StaticResource NocturneWarningColor}" />
    <SolidColorBrush x:Key="NocturneWarningSurfaceBrush" Color="#1fdbb277" />
    <SolidColorBrush x:Key="NocturneWarningBorderBrush" Color="#5c4f33" />

    <Color x:Key="NocturneDangerColor">#dd8189</Color>
    <SolidColorBrush x:Key="NocturneDangerBrush" Color="{StaticResource NocturneDangerColor}" />
    <SolidColorBrush x:Key="NocturneDangerSurfaceBrush" Color="#14dd8189" />
    <SolidColorBrush x:Key="NocturneDangerBorderBrush" Color="#5c3a40" />
    <!-- Ступени взаимодействия для разрушительной кнопки: та же заливка, только гуще. -->
    <SolidColorBrush x:Key="NocturneDangerSurfaceHoverBrush" Color="#26dd8189" />
    <SolidColorBrush x:Key="NocturneDangerSurfacePressedBrush" Color="#38dd8189" />
    <SolidColorBrush x:Key="NocturneDangerBorderHoverBrush" Color="#7a3f47" />

    <!-- ================================================================
         ФИШКИ (теги)
         Пилюля — единственный составной элемент, который макет повторяет; пока она собрана из
         токенов, сводка в боковой панели у D2 и бейджи на canvas у D3 разъехаться не могут.
         ================================================================ -->

    <SolidColorBrush x:Key="NocturneChipFillBrush" Color="#269184d9" />
    <SolidColorBrush x:Key="NocturneChipBorderBrush" Color="#443f6b" />
    <SolidColorBrush x:Key="NocturneChipTextBrush" Color="#cfc8f0" />
    <!-- Мягкий вариант: та же пилюля на утопленной поверхности, где ей положено отступить назад. -->
    <SolidColorBrush x:Key="NocturneChipFillSoftBrush" Color="#219184d9" />
    <SolidColorBrush x:Key="NocturneChipBorderSoftBrush" Color="#3a3560" />
    <SolidColorBrush x:Key="NocturneChipTextSoftBrush" Color="#c3bbe8" />
    <!-- Подкрашенная акцентом граница поля ввода, которой макет обозначает «добавить тег». -->
    <SolidColorBrush x:Key="NocturneChipInputBorderBrush" Color="#4a4470" />

    <!-- ================================================================
         CANVAS (волна D3a)
         Редактор нод — это собственная визуальная плоскость: земля темнее, чем у окна, чтобы
         коробки читались как парящие над ней, плюс по оттенку на каждую деталь оправы ноды.
         Все значения здесь — собственные значения макета (opt-1d / opt-1e) и, как и
         поверхности выше, намеренно лежат вне шкал: плотному графу нужны ступени мельче, чем
         по сотне на шаг.
         ================================================================ -->

    <!-- Плоскость, на которой рисуется граф, и точечная сетка поверх неё. -->
    <SolidColorBrush x:Key="NocturneCanvasBrush" Color="#12131e" />
    <SolidColorBrush x:Key="NocturneCanvasGridBrush" Color="#242737" />

    <!-- Глубокие панели по бокам от canvas: инспектор и лента лога прогона. -->
    <SolidColorBrush x:Key="NocturnePanelDeepBrush" Color="#141520" />
    <SolidColorBrush x:Key="NocturnePanelDeepDividerBrush" Color="#212434" />

    <!-- Нода-действие: нейтральная оправа. -->
    <SolidColorBrush x:Key="NocturneNodeSurfaceBrush" Color="#1e2030" />
    <SolidColorBrush x:Key="NocturneNodeBorderBrush" Color="#343849" />
    <SolidColorBrush x:Key="NocturneNodeHeaderBrush" Color="#242739" />
    <SolidColorBrush x:Key="NocturneNodeHeaderBorderBrush" Color="#2e3243" />

    <!-- Условная нода: та же коробка, но шапка уведена в акцент, чтобы два семейства
         различались ещё до того, как прочитано хоть одно слово. -->
    <SolidColorBrush x:Key="NocturneNodeConditionalHeaderBrush" Color="#262238" />
    <SolidColorBrush x:Key="NocturneNodeConditionalHeaderBorderBrush" Color="#322d4a" />

    <!-- Нода, на которой стоит исполнитель (её и подсвечивает D3b). -->
    <SolidColorBrush x:Key="NocturneNodeRunningBrush" Color="#232038" />
    <SolidColorBrush x:Key="NocturneNodeRunningHeaderBrush" Color="#2e2951" />
    <SolidColorBrush x:Key="NocturneNodeRunningHeaderBorderBrush" Color="#46407a" />

    <!-- Нода, через которую выбранный обход уже прошёл (D5): макет её притемняет и ставит ✓ с
         затраченным временем. Именно притемнение, а не другой цвет: смысл в том, чтобы глаз
         проскользнул мимо неё и приземлился на ту, что живая. -->
    <SolidColorBrush x:Key="NocturneNodePassedBrush" Color="#1b1d2b" />
    <SolidColorBrush x:Key="NocturneNodePassedHeaderBrush" Color="#212433" />
    <SolidColorBrush x:Key="NocturneNodePassedBorderBrush" Color="#2e3243" />

    <!-- Нода, на которой обход ПРИПАРКОВАН. Акцент живой ноды плюс тревожная кромка того, что
         его удерживает, — чтобы «здесь остановились» никогда не читалось как «здесь идёт». -->
    <SolidColorBrush x:Key="NocturneNodePausedBorderBrush" Color="{StaticResource NocturneDangerColor}" />

    <!-- Рёбра и их порты. Активное = акцент, и это ЕДИНСТВЕННАЯ акцентная линия на canvas —
         именно поэтому живой путь читается с одного взгляда. -->
    <SolidColorBrush x:Key="NocturneEdgeBrush" Color="#464b61" />
    <SolidColorBrush x:Key="NocturneEdgeActiveBrush" Color="{StaticResource NocturneAccentColor}" />

    <!-- Связь по переменной: пишущий → читающий, пунктиром, цветом переменной из легенды
         макета. Никогда не акцентом: это не поток управления и читаться как ветвление не
         должно. -->
    <SolidColorBrush x:Key="NocturneVariableBrush" Color="{StaticResource NocturneWarningColor}" />
    <SolidColorBrush x:Key="NocturneVariableSurfaceBrush" Color="#12dbb277" />
    <SolidColorBrush x:Key="NocturneVariableBorderBrush" Color="#5c4f33" />

    <!-- Подпись клавиши, нарисованная кейкапом: плоский верх, кромка снизу потолще. -->
    <SolidColorBrush x:Key="NocturneKeycapBrush" Color="#2a2e40" />

    <!-- Высота ноды над плоскостью. Отличается от NocturneShadow* потому, что нода — это
         маленькая карточка на тёмной плоскости, а не всплывающее окно: никакой светлой кромки,
         только падающая тень. -->
    <BoxShadows x:Key="NocturneShadowNode">0 3 10 0 #80000000</BoxShadows>
    <!-- Выбранная или развёрнутая: системное акцентное свечение, в масштабе карточки. -->
    <BoxShadows x:Key="NocturneShadowNodeSelected">0 0 0 4 #1f9184d9, 0 10 28 0 #99000000</BoxShadows>

    <!-- ================================================================
         ОТСТУПЫ — плотность 0.7×, ступени 1 2 3 4 6 8
         ================================================================ -->

    <x:Double x:Key="NocturneSpace1">2.8</x:Double>
    <x:Double x:Key="NocturneSpace2">5.6</x:Double>
    <x:Double x:Key="NocturneSpace3">8.4</x:Double>
    <x:Double x:Key="NocturneSpace4">11.2</x:Double>
    <x:Double x:Key="NocturneSpace6">16.8</x:Double>
    <x:Double x:Key="NocturneSpace8">22.4</x:Double>

    <!-- Inset* = заготовки под padding. -->
    <Thickness x:Key="NocturneInsetTight">5.6,2.8</Thickness>
    <Thickness x:Key="NocturneInsetControl">11.2,5.6</Thickness>
    <Thickness x:Key="NocturneInsetField">8.4,5.6</Thickness>
    <Thickness x:Key="NocturneInsetChip">8.4,1.4</Thickness>
    <Thickness x:Key="NocturneInsetPanel">8.4</Thickness>
    <Thickness x:Key="NocturneInsetCard">11.2</Thickness>
    <Thickness x:Key="NocturneInsetWindow">11.2</Thickness>

    <!-- Space*Thickness = равномерные поля, шкала та же. Направленные поля остаются литералами,
         но брать их значения полагается со шкалы выше. -->
    <Thickness x:Key="NocturneSpace1Thickness">2.8</Thickness>
    <Thickness x:Key="NocturneSpace2Thickness">5.6</Thickness>
    <Thickness x:Key="NocturneSpace3Thickness">8.4</Thickness>
    <Thickness x:Key="NocturneSpace4Thickness">11.2</Thickness>

    <!-- ================================================================
         РАДИУСЫ СКРУГЛЕНИЯ
         ================================================================ -->

    <CornerRadius x:Key="NocturneRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="NocturneRadiusMd">8</CornerRadius>
    <CornerRadius x:Key="NocturneRadiusLg">14</CornerRadius>
    <!-- В собственно систему не входит: пилюля тега, у которой радиус — это просто половина её
         высоты. -->
    <CornerRadius x:Key="NocturneRadiusPill">10</CornerRadius>

    <!-- ================================================================
         ВЫСОТА НАД ПЛОСКОСТЬЮ
         На тёмной земле высота — это кромка плюс мягкая тень. Два рецепта друг на друга не
         накладывать никогда.
         ================================================================ -->

    <BoxShadows x:Key="NocturneShadowSm">0 0 0 1 #3f424d</BoxShadows>
    <BoxShadows x:Key="NocturneShadowMd">0 0 0 1 #595d6c, 0 6 18 0 #8c000000</BoxShadows>
    <BoxShadows x:Key="NocturneShadowLg">0 0 0 1 #9397ab, 0 16 40 0 #a6000000</BoxShadows>

    <!-- Не высота: ореол вокруг точки «что-то работает» на полосе прогона (D2). Растекание на
         3px акцентом с прозрачностью 20% — правило «акцент как свечение» в самом мелком виде. -->
    <BoxShadows x:Key="NocturneRunDotGlow">0 0 0 3 #339184d9</BoxShadows>

    <!-- ================================================================
         ШРИФТ
         Inter едет встроенным в пакет Avalonia.Fonts.Inter и регистрируется вызовом
         Program.BuildAvaloniaApp().WithInterFont() — псевдоним "fonts:Inter" ниже это
         собственный ключ коллекции того самого пакета, так что от установки в системе ничего
         не зависит. Пакет несёт в себе, среди прочего, Regular/Medium/SemiBold (400/500/600).

         Заголовки никогда не жирнее 500. Иерархию делают размер и воздух.
         ================================================================ -->

    <!-- Хвостовой "$Default" — это запасное семейство для глифов, которых у Inter нет (стрелки,
         геометрические фигуры). Цепочка та же самая, что использует собственный
         ContentControlThemeFontFamily у Fluent, — выбрасывать её не надо. -->
    <FontFamily x:Key="NocturneFontFamily">fonts:Inter#Inter, $Default</FontFamily>
    <FontFamily x:Key="NocturneFontFamilyMono">Cascadia Mono,Consolas,$Default</FontFamily>

    <!-- КНОПКИ-ГЛИФЫ — ловушка, которую стоит записать, потому что никакая цепочка шрифтов от
         неё не спасает. Там, где подпись кнопки САМА является символом (▸ ■ ↑ ↓ ×), кодовая
         точка не должна быть из тех, у кого есть эмодзи-представление: такие Windows подаёт из
         Segoe UI Emoji, а его глифы полноцветные и Foreground игнорируют начисто. U+25B6 ▶
         рисовался БЕЛЫМ треугольником внутри кнопки с акцентным контуром, какое семейство ни
         проси. У U+25B8 ▸ (её используем для «запустить») эмодзи-представления нет, и она
         наследует Foreground как обычный текст; ■ ↑ ↓ × так же безопасны. Любой новый глиф
         сверяйте с emoji-data, прежде чем отправлять его в подпись. -->

    <x:Double x:Key="NocturneFontSizeMicro">10</x:Double>
    <x:Double x:Key="NocturneFontSizeSmall">11</x:Double>
    <x:Double x:Key="NocturneFontSizeBody">12</x:Double>
    <x:Double x:Key="NocturneFontSizeTitle">13</x:Double>
    <x:Double x:Key="NocturneFontSizeHeading">15</x:Double>

</ResourceDictionary>
