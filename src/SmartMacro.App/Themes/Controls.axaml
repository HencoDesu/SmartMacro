<!--
  Nocturne — темы контролов (волна D1).

  Это полноценные `ControlTheme`, ключуемые по типу, поэтому они ЗАМЕНЯЮТ фолбэк FluentTheme
  для каждого перечисленного здесь контрола. FluentTheme при этом остаётся в
  Application.Styles: он даёт те контролы, которые никто пока не перестилил (Window, Popup,
  MenuFlyout, ToolTip, PathIcon…), а FluentBridge.axaml перенаправляет цветовые ключи этих
  остатков на здешние токены.

  Всё ссылается на Tokens.axaml через {DynamicResource}, а не через {StaticResource}.
  Подмешанные словари разрешают статические ссылки по родительской цепочке времени разбора, а
  её между файлами легко построить неверно; DynamicResource разрешается во время выполнения по
  всей цепочке и находит токен всегда. Внутри ЭТОГО файла статические ссылки допустимы и
  используются для локальных подтем (ползунок, кнопка страницы), потому что объявлены они выше
  места применения.

  Правила системы и место, где каждое из них обеспечивается:

    акцент — это линия и свечение   Button.Background прозрачен во всех состояниях;
                                    единственные акцентные площади — заливки AccentTint*.
    нет кнопки с акцентной          варианта с акцентной заливкой не существует.
    заливкой                        `Button.accent` — это акцентный КОНТУР; `Button.danger`
                                    точно так же.
    фокус = 2px акцента,            AdornerLayer.DefaultFocusAdorner ниже; он глобально
    отступ 2px                      заменяет почти белое двухтоновое кольцо от Fluent — в том
                                    числе на контролах, которым этот файл темы не даёт.
    плотность 0.7×                  каждый padding приходит из NocturneInset*, каждый зазор —
                                    из NocturneSpace*.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:SmartMacro.App.Controls"
                    xmlns:conv="using:SmartMacro.App.Converters">

    <!-- ================================================================
         ФОКУС
         Avalonia рисует AdornerLayer.DefaultFocusAdorner для любого контрола, который не
         задал FocusAdorner сам, и только для фокуса с клавиатуры или направленного. Значение
         по умолчанию у Fluent — кольцо в 2px цветом SystemBaseHigh с внутренней линией в 1px,
         тот самый штатный вид, ради избавления от которого эта волна и существует. Margin -4
         отодвигает штрих в 2px на 2px от контрола.
         ================================================================ -->

    <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
        <Setter Property="DefaultFocusAdorner">
            <FocusAdornerTemplate>
                <!-- AdornerLayer.IsClipEnabled по умолчанию ИСТИНА, а это обрезает украшение
                     по границам того, что оно украшает, — так что отрицательный отступ, на
                     котором и держатся наши 2px зазора, тихо срезал бы кольцо в ничто. -->
                <Border AdornerLayer.IsClipEnabled="False"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource NocturneAccentBrush}"
                        CornerRadius="6"
                        Margin="-4" />
            </FocusAdornerTemplate>
        </Setter>
    </ControlTheme>

    <!-- ================================================================
         КНОПКА
         По умолчанию — нейтральный контур на прозрачном. `.accent` поднимает контур до
         акцента, `.danger` — до тревожной кромки поверх её 8-процентной заливки. Ничто здесь
         никогда не заливается.
         ================================================================ -->

    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral300Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral800Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource NocturneRadiusSm}" />
        <Setter Property="Padding" Value="{DynamicResource NocturneInsetControl}" />
        <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeSmall}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  RecognizesAccessKey="True"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent700Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral200Brush}" />
        </Style>

        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturnePressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent600Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneAccent200Brush}" />
        </Style>

        <!-- Основная. Контур, а не заливка, — в этом вся суть системы. -->
        <Style Selector="^.accent">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NocturneAccent300Brush}" />
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent400Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource NocturneAccent200Brush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NocturnePressedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent300Brush}" />
            </Style>
        </Style>

        <!-- Destructive: "Стоп всё", "Удалить". -->
        <Style Selector="^.danger">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NocturneDangerSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneDangerBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NocturneDangerBrush}" />
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NocturneDangerSurfaceHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneDangerBorderHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NocturneDangerBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NocturneDangerSurfacePressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NocturneDangerBrush}" />
            </Style>
        </Style>

        <!-- Без оправы: значок или строчка текста, которая просто оказалась кликабельной
             (✕ у тега, строки замечаний валидатора, пункты выпадающих меню). -->
        <Style Selector="^.ghost">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="{DynamicResource NocturneInsetTight}" />
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource NocturneTextMutedBrush}" />
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NocturneAccentTint08Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource NocturneAccent300Brush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
            </Style>
        </Style>

        <!-- ПОСЛЕДНИМ, и это намеренно. Вложенные стили одинаковой специфичности разрешаются в
             порядке объявления, поэтому этот обязан идти после .accent/.danger/.ghost, иначе
             погашенная «Стоп всё» сохранит свою живую тревожную кромку и будет читаться как
             нажимаемая. -->
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral900Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral700Brush}" />
        </Style>
    </ControlTheme>

    <!-- ================================================================
         REPEATBUTTON — та же шкура, что у Button, для всего, что самоповторяется.
         ================================================================ -->

    <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral300Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral800Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource NocturneRadiusSm}" />
        <Setter Property="Padding" Value="{DynamicResource NocturneInsetControl}" />
        <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent700Brush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturnePressedBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral900Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral700Brush}" />
        </Style>
    </ControlTheme>

    <!-- ================================================================
         TEXTBOX
         Утопленное поле, нейтральная кромка в покое, акцентная ЛИНИЯ на фокусе. Версия из
         Fluent воспроизведена структурно (те же имена PART_, те же слоты watermark и
         inner-content), так что ничему, что привязано к TextBox, меняться не нужно; отличаются
         только шкура и плотность.
         ================================================================ -->

    <MenuFlyout x:Key="NocturneTextBoxContextFlyout">
        <MenuItem Header="Вырезать"
                  Command="{Binding $parent[TextBox].Cut}"
                  IsEnabled="{Binding $parent[TextBox].CanCut}"
                  InputGesture="{x:Static TextBox.CutGesture}" />
        <MenuItem Header="Копировать"
                  Command="{Binding $parent[TextBox].Copy}"
                  IsEnabled="{Binding $parent[TextBox].CanCopy}"
                  InputGesture="{x:Static TextBox.CopyGesture}" />
        <MenuItem Header="Вставить"
                  Command="{Binding $parent[TextBox].Paste}"
                  IsEnabled="{Binding $parent[TextBox].CanPaste}"
                  InputGesture="{x:Static TextBox.PasteGesture}" />
    </MenuFlyout>

    <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource NocturneFieldBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NocturneFieldBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource NocturneAccent300Brush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource NocturneAccentTint22Brush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource NocturneTextBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource NocturneRadiusSm}" />
        <!-- ⚠️ ЛОВУШКА ЖЁСТКОЙ ВЫСОТЫ. Отступ здесь 8.4,5.6, то есть 11.2 px по вертикали, а
             текст живёт внутри PART_ScrollViewer, который свою область просмотра ОБРЕЗАЕТ. Пока
             высоту определяет MinHeight ниже, всё в порядке: контрол вырастает под строку. Но
             стоит вызывающему задать жёсткий Height (24 или 26 — самые ходовые в шапках), как
             под строку остаётся Height − 2 − 11.2 ≈ 11..13 px при её высоте ~14, и низ строки
             срезается ровно по базовой линии. Дефект коварен тем, что буквы остаются целыми и
             читаемыми — пропадают только хвосты «р», «у», «д», «ц», и заметить это можно лишь
             глазами, вплотную.
             Лекарство на месте вызова: вместе с Height задавать Padding="8,0" и
             VerticalContentAlignment="Center". Здесь отступ НЕ уменьшен намеренно — на нём стоит
             высота всех полей инспектора макросов, которые высоту не фиксируют. -->
        <Setter Property="Padding" Value="{DynamicResource NocturneInsetField}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeSmall}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ContextFlyout" Value="{StaticResource NocturneTextBoxContextFlyout}" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}" />

                    <Border Margin="{TemplateBinding BorderThickness}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding InnerLeftContent}" />
                            <DockPanel x:Name="PART_InnerDockPanel"
                                       Grid.Column="1"
                                       Margin="{TemplateBinding Padding}">
                                <TextBlock Name="PART_FloatingWatermark"
                                           Foreground="{DynamicResource NocturneAccent300Brush}"
                                           FontSize="{DynamicResource NocturneFontSizeMicro}"
                                           IsVisible="False"
                                           Text="{TemplateBinding Watermark}"
                                           DockPanel.Dock="Top" />
                                <ScrollViewer Name="PART_ScrollViewer"
                                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                              IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                              AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                              BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                                    <Panel>
                                        <TextBlock Name="PART_Watermark"
                                                   Foreground="{DynamicResource NocturneTextGhostBrush}"
                                                   Text="{TemplateBinding Watermark}"
                                                   TextAlignment="{TemplateBinding TextAlignment}"
                                                   TextWrapping="{TemplateBinding TextWrapping}"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>
                                        <TextPresenter Name="PART_TextPresenter"
                                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                                       CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                                       CaretIndex="{TemplateBinding CaretIndex}"
                                                       SelectionStart="{TemplateBinding SelectionStart}"
                                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                                       TextAlignment="{TemplateBinding TextAlignment}"
                                                       TextWrapping="{TemplateBinding TextWrapping}"
                                                       LineHeight="{TemplateBinding LineHeight}"
                                                       LetterSpacing="{TemplateBinding LetterSpacing}"
                                                       PasswordChar="{TemplateBinding PasswordChar}"
                                                       RevealPassword="{TemplateBinding RevealPassword}"
                                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                       CaretBrush="{TemplateBinding CaretBrush}"
                                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Panel>
                                    <ScrollViewer.Styles>
                                        <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Cursor" Value="IBeam" />
                                        </Style>
                                    </ScrollViewer.Styles>
                                </ScrollViewer>
                            </DockPanel>
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding InnerRightContent}" />
                        </Grid>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral700Brush}" />
        </Style>

        <!-- Фокус — это акцентная ЛИНИЯ; само поле не заливается никогда. -->
        <Style Selector="^:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource NocturneSurfaceOverlayBrush}" />
        </Style>

        <Style Selector="^:error /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneDangerBrush}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral700Brush}" />
            <Style Selector="^ /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="{DynamicResource NocturneSurfaceSunkenBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral900Brush}" />
            </Style>
        </Style>

        <Style Selector="^[UseFloatingWatermark=true]:not(:empty) /template/ TextBlock#PART_FloatingWatermark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- ================================================================
         COMBOBOX
         ================================================================ -->

    <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource NocturneTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource NocturneInsetField}" />
        <Setter Property="CornerRadius" Value="{DynamicResource NocturneRadiusSm}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Foreground="{TemplateBinding Foreground}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Padding="{TemplateBinding Padding}" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturnePressedBrush}" />
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint15Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneAccent200Brush}" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturnePressedBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral700Brush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource NocturneFieldBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NocturneFieldBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource NocturneRadiusSm}" />
        <Setter Property="Padding" Value="8.4,2.8,0,2.8" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeSmall}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource NocturneTextGhostBrush}" />
        <Setter Property="MaxDropDownHeight" Value="360" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,22">
                    <Border x:Name="Background"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinHeight="{TemplateBinding MinHeight}" />

                    <TextBlock x:Name="PlaceholderTextBlock"
                               Grid.Column="0"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               Margin="{TemplateBinding Padding}"
                               Text="{TemplateBinding PlaceholderText}"
                               Foreground="{TemplateBinding PlaceholderForeground}"
                               IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />

                    <ContentControl x:Name="ContentPresenter"
                                    Grid.Column="0"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

                    <PathIcon x:Name="DropDownGlyph"
                              Grid.Column="1"
                              UseLayoutRounding="False"
                              IsHitTestVisible="False"
                              Height="8"
                              Width="8"
                              Margin="0,0,7,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource NocturneNeutral600Brush}"
                              Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z" />

                    <Popup Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}"
                           PlacementTarget="Background"
                           IsLightDismissEnabled="True"
                           InheritsTransform="True">
                        <Border x:Name="PopupBorder"
                                Background="{DynamicResource NocturneSurfaceOverlayBrush}"
                                BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                                BorderThickness="1"
                                Padding="2.8"
                                HorizontalAlignment="Stretch"
                                BoxShadow="{DynamicResource NocturneShadowMd}"
                                CornerRadius="{DynamicResource NocturneRadiusSm}">
                            <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral700Brush}" />
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint08Brush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent700Brush}" />
            <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource NocturneAccent400Brush}" />
        </Style>
        <Style Selector="^:disabled">
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="Background" Value="{DynamicResource NocturneSurfaceSunkenBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral900Brush}" />
            </Style>
            <Style Selector="^ /template/ ContentControl#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral700Brush}" />
            </Style>
            <Style Selector="^ /template/ PathIcon#DropDownGlyph">
                <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral800Brush}" />
            </Style>
        </Style>
    </ControlTheme>

    <!-- ================================================================
         CHECKBOX
         Квадратик — 14px при плотности 0.7×. Отмеченное состояние — акцентный контур поверх
         22%-заливки с глифом accent-300: линия и свечение, а не залитый акцентом квадрат.
         ================================================================ -->

    <StreamGeometry x:Key="NocturneCheckMark">M5.5 10.586 1.707 6.793A1 1 0 0 0 .293 8.207l4.5 4.5a1 1 0 0 0 1.414 0l11-11A1 1 0 0 0 15.793.293L5.5 10.586Z</StreamGeometry>

    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource NocturneTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5.6,0,0,0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeSmall}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="RootGrid" ColumnDefinitions="14,*">
                    <Border x:Name="PART_Border"
                            Grid.ColumnSpan="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />

                    <Panel VerticalAlignment="Center" Height="20">
                        <Border x:Name="NormalRectangle"
                                BorderBrush="{DynamicResource NocturneNeutral700Brush}"
                                Background="{DynamicResource NocturneFieldBackgroundBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                UseLayoutRounding="False"
                                Height="14"
                                Width="14" />
                        <Viewbox UseLayoutRounding="False" Height="9" Width="9">
                            <Panel>
                                <Panel Height="18" Width="18" />
                                <Path x:Name="CheckGlyph"
                                      Opacity="0"
                                      Fill="{DynamicResource NocturneAccent300Brush}"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      FlowDirection="LeftToRight" />
                            </Panel>
                        </Viewbox>
                    </Panel>

                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextWrapping="Wrap" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ Border#NormalRectangle">
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent600Brush}" />
                <Setter Property="Background" Value="{DynamicResource NocturneAccentTint08Brush}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
            </Style>
        </Style>

        <Style Selector="^:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
        </Style>

        <Style Selector="^:checked">
            <Style Selector="^ /template/ Border#NormalRectangle">
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource NocturneAccentTint22Brush}" />
            </Style>
            <Style Selector="^ /template/ Path#CheckGlyph">
                <Setter Property="Data" Value="{StaticResource NocturneCheckMark}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#NormalRectangle">
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent400Brush}" />
            </Style>
        </Style>

        <Style Selector="^:indeterminate">
            <Style Selector="^ /template/ Border#NormalRectangle">
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent700Brush}" />
                <Setter Property="Background" Value="{DynamicResource NocturneAccentTint15Brush}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ Border#NormalRectangle">
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral800Brush}" />
                <Setter Property="Background" Value="{DynamicResource NocturneSurfaceSunkenBrush}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral700Brush}" />
            </Style>
            <Style Selector="^ /template/ Path#CheckGlyph">
                <Setter Property="Fill" Value="{DynamicResource NocturneNeutral700Brush}" />
            </Style>
        </Style>
    </ControlTheme>

    <!-- ================================================================
         LISTBOX
         Выделение сделано навигационным приёмом из макета: акцентная линейка 2px по ведущей
         кромке поверх 12%-заливки. У невыделенного элемента линейка на месте, но прозрачная, —
         так ничего не съезжает.
         ================================================================ -->

    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NocturneTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="8.4,5.6" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Content="{TemplateBinding Content}"
                                  Padding="{TemplateBinding Padding}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint08Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint18Brush}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral700Brush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NocturneDividerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="border"
                        ClipToBounds="{TemplateBinding ClipToBounds}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                  IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                  AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                  BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        Margin="{TemplateBinding Padding}" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ================================================================
         KEYBINDINGPICKER — ловушка хоткея (волна D4, макет 1f)

         Четыре состояния в одном контроле, и каждое — своя рецептура рамки поверх одной и той
         же строки в 28px:

           unbound    пунктирный нейтральный контур + приглашение с ⌨
           capturing  акцентный контур поверх 12%-заливки, пульсирующая точка, «Нажмите сочетание…»
           bound      нейтральный контур + сочетание физическими кейкапами
           conflict   тревожный контур поверх тревожной заливки + причина, по правому краю

         Кейкапы и есть смысл этого виджета: модификаторы отдельными клавишами вместо строки
         «Ctrl+Shift+F1», — так пойманное читаемо, а столкновение с уже существующей привязкой
         легко заметить. Нижняя грань рамки толщиной 2 — то, из-за чего плоский прямоугольник
         читается физической клавишей.
         ================================================================ -->

    <ControlTheme x:Key="{x:Type controls:KeyBindingPicker}" TargetType="controls:KeyBindingPicker">
        <Setter Property="Background" Value="{DynamicResource NocturneFieldBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral800Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource NocturneTextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                <!-- У Border в Avalonia нет штриховки; пунктирный контур пустого состояния —
                     это Rectangle, положенный поверх корня, у которого в этот момент рамки нет. -->
                <Rectangle x:Name="PART_Dash"
                           IsVisible="False"
                           RadiusX="5" RadiusY="5"
                           StrokeThickness="1"
                           StrokeDashArray="3,2"
                           IsHitTestVisible="False"
                           Stroke="{DynamicResource NocturneNeutral800Brush}" />
                <Border x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <!-- Кейкапы — это Auto, а замыкающая приписка — звёздочная колонка, а не
                         наоборот: колонку Auto меряют первой, и она забирает столько, сколько
                         просит, так что подсказка, посаженная в такую колонку, объедает кейкапы,
                         и сочетание отрисовывается ниточкой. Урезать позволительно именно
                         приписке. -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">

                        <!-- точка «взведён» -->
                        <Ellipse x:Name="PART_Dot"
                                 Grid.Column="0"
                                 Width="6" Height="6"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 IsVisible="{TemplateBinding IsCapturing}"
                                 Fill="{DynamicResource NocturneAccent300Brush}" />

                        <!-- приглашение: пустое состояние либо взведённое -->
                        <TextBlock x:Name="PART_Prompt"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{TemplateBinding ShowsPrompt}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding PromptText}" />

                        <!-- сочетание, физическими клавишами -->
                        <ItemsControl x:Name="PART_Keycaps"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      IsVisible="{TemplateBinding ShowsPrompt, Converter={x:Static BoolConverters.Not}}"
                                      ItemsSource="{TemplateBinding Keycaps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:KeycapItem">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="+"
                                                   FontSize="{DynamicResource NocturneFontSizeMicro}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource NocturneTextFaintBrush}"
                                                   IsVisible="{Binding ShowsPlus}" />
                                        <Border Height="19"
                                                Padding="7,0"
                                                CornerRadius="3"
                                                BorderThickness="1,1,1,2"
                                                Background="{Binding IsPrimary, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccentTint18Brush|NocturneKeycapBrush}"
                                                BorderBrush="{Binding IsPrimary, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccent700Brush|NocturneEdgeBrush}">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="10.5"
                                                       FontWeight="Medium"
                                                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                       Foreground="{Binding IsPrimary, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccent300Brush|NocturneTextBrush}"
                                                       Text="{Binding Text}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- «клик — перезадать» либо причина конфликта. С подсказкой, потому что
                             длинное сочетание её урезает, а урезанный конфликт всё равно обязан
                             оставаться читаемым. -->
                        <TextBlock x:Name="PART_Trailing"
                                   Grid.Column="3"
                                   Margin="8,0,0,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource NocturneFontSizeMicro}"
                                   Foreground="{DynamicResource NocturneTextFaintBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{TemplateBinding TrailingText}"
                                   Text="{TemplateBinding TrailingText}" />
                    </Grid>
                </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- пусто: a dashed outline says "there is nothing here yet" without a word. -->
        <Style Selector="^:unbound">
            <Style Selector="^ /template/ Rectangle#PART_Dash">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Root">
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </Style>
        <Style Selector="^:unbound:pointerover /template/ Rectangle#PART_Dash">
            <Setter Property="Stroke" Value="{DynamicResource NocturneAccent700Brush}" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent700Brush}" />
        </Style>
        <Style Selector="^:pointerover /template/ TextBlock#PART_Prompt">
            <Setter Property="Foreground" Value="{DynamicResource NocturneAccent400Brush}" />
        </Style>

        <!-- ловит -->
        <Style Selector="^:capturing">
            <Style Selector="^ /template/ Rectangle#PART_Dash">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Root">
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource NocturneAccentTint12Brush}" />
                <!-- Тот самый smPulse из макета. У контурного элемента честный аналог
                     CSS-кейфрейма по прозрачности — это когда дышит вся строка целиком:
                     анимация кисти рамки потребовала бы двух ресурсов-кистей и всё равно не
                     читалась бы как движение. -->
                <Style.Animations>
                    <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1" />
                        </KeyFrame>
                        <KeyFrame Cue="50%">
                            <Setter Property="Opacity" Value="0.55" />
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1" />
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Prompt">
                <Setter Property="Foreground" Value="{DynamicResource NocturneAccent300Brush}" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
        </Style>

        <!-- конфликт -->
        <Style Selector="^:conflict">
            <Style Selector="^ /template/ Border#PART_Root">
                <Setter Property="BorderBrush" Value="{DynamicResource NocturneDangerBorderHoverBrush}" />
                <Setter Property="Background" Value="{DynamicResource NocturneDangerSurfaceBrush}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Trailing">
                <Setter Property="Foreground" Value="{DynamicResource NocturneDangerBrush}" />
            </Style>
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral900Brush}" />
            <Setter Property="Background" Value="{DynamicResource NocturneSurfaceSunkenBrush}" />
        </Style>
    </ControlTheme>

    <!-- ================================================================
         SCROLLBAR
         Линейка 4px, расширяющаяся до 8px при наведении. Без кнопок-стрелок, без полосы
         оправы — скроллбар из Fluent громче всего остального кричит «это не Nocturne» в
         стоковом окне Avalonia. Кнопки прокрутки у ScrollBar — необязательные части шаблона
         (сам control проверяет их на null), поэтому здесь их попросту нет.
         ================================================================ -->

    <x:Double x:Key="NocturneScrollBarSize">10</x:Double>

    <ControlTheme x:Key="NocturneScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource NocturneNeutral800Brush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource NocturneNeutral600Brush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource NocturneAccent600Brush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="NocturneScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="{DynamicResource NocturneScrollBarSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource NocturneScrollBarSize}" />
        <Setter Property="Background" Value="Transparent" />

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="{DynamicResource NocturneScrollBarSize}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Theme="{StaticResource NocturneScrollBarPageButton}"
                                              Focusable="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Theme="{StaticResource NocturneScrollBarPageButton}"
                                              Focusable="False" />
                            </Track.IncreaseButton>
                            <Thumb Theme="{StaticResource NocturneScrollBarThumb}" MinHeight="24" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="{DynamicResource NocturneScrollBarSize}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Theme="{StaticResource NocturneScrollBarPageButton}"
                                              Focusable="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Theme="{StaticResource NocturneScrollBarPageButton}"
                                              Focusable="False" />
                            </Track.IncreaseButton>
                            <Thumb Theme="{StaticResource NocturneScrollBarThumb}" MinWidth="24" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Expanded = указатель над полосой (или автоскрытие выключено): линейка расширяется,
             а за ней проступает дорожка. -->
        <Style Selector="^[IsExpanded=true]">
            <Style Selector="^ /template/ Border#Root">
                <Setter Property="Background" Value="{DynamicResource NocturneSurfaceInsetBrush}" />
            </Style>
            <Style Selector="^ /template/ Thumb">
                <Setter Property="Margin" Value="1" />
            </Style>
        </Style>
    </ControlTheme>

</ResourceDictionary>
