<!--
  Composition of the visual layer (wave D1).

  Order matters and is not arbitrary:

    Application.Resources  Tokens → FluentBridge → Controls.
                           Resources are consulted BEFORE Styles, which is what lets
                           FluentBridge.axaml override FluentTheme's own resource keys and
                           lets Controls.axaml's ControlThemes replace Fluent's per-type
                           defaults. Tokens comes first because everything else reads it.

    Application.Styles     FluentTheme stays: it still supplies the controls nobody has
                           written a Nocturne theme for. The Window style after it is the
                           one place a Style (rather than a ControlTheme) is the right
                           tool — Style priority beats ControlTheme priority, so these four
                           inherited properties win over Fluent's Window theme and cascade
                           into every control in the tree.

  Inter comes from the Avalonia.Fonts.Inter package and is registered in
  Program.BuildAvaloniaApp().WithInterFont(); "fonts:Inter#Inter" is that package's
  embedded collection, so the panel looks right on a machine with no Inter installed.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartMacro.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SmartMacro.App/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://SmartMacro.App/Themes/FluentBridge.axaml" />
                <ResourceInclude Source="avares://SmartMacro.App/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource NocturneGroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource NocturneFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeBody}" />
        </Style>
    </Application.Styles>
</Application>
