<!--
  Composition визуального слоя (волна D1).

  Порядок важен и не произволен:

    Application.Resources  Tokens → FluentBridge → Controls.
                           Ресурсы просматриваются РАНЬШЕ стилей — именно это и позволяет
                           FluentBridge.axaml перекрыть собственные ключи ресурсов
                           FluentTheme, а ControlTheme'ам из Controls.axaml — заменить
                           фолбэки Fluent по типам. Tokens идёт первым, потому что из него
                           читают все остальные.

    Application.Styles     FluentTheme остаётся: он по-прежнему даёт те контролы, для
                           которых никто не написал темы Nocturne. Стиль Window после него —
                           единственное место, где правильный инструмент именно Style, а не
                           ControlTheme: приоритет Style выше приоритета ControlTheme, так
                           что эти четыре наследуемых свойства побеждают тему Window от
                           Fluent и каскадом расходятся по всем контролам дерева.

  Inter приезжает из пакета Avalonia.Fonts.Inter и регистрируется в
  Program.BuildAvaloniaApp().WithInterFont(); "fonts:Inter#Inter" — это встроенная коллекция
  того самого пакета, поэтому панель выглядит как надо и на машине, где Inter не установлен.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartMacro.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SmartMacro/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://SmartMacro/Themes/FluentBridge.axaml" />
                <ResourceInclude Source="avares://SmartMacro/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource NocturneGroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource NocturneFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeBody}" />
        </Style>
    </Application.Styles>
</Application>
