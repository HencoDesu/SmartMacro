<!--
  «Лог» — одна оправа, без содержимого, и по тем же соображениям, что и TemplatesView.

  Демон пишет файлы Serilog в собственную папку logs/, а протокол не несёт о них ничего: ни
  запроса «дочитай хвост», ни события лога на проводе. Режим существует, чтобы рейка совпадала
  с дизайном, а пробел был виден; счётчик у него остаётся пустым.

  Что для него нужно: либо потоковое событие лога (тот же план канала, которого волна D5 хочет
  для событий прогона), либо запрос «прочитай последние N строк».
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartMacro.App.ViewModels"
             x:Class="SmartMacro.App.Views.LogView"
             x:DataType="vm:ShellViewModel">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource NocturneDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,9">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Лог"
                           FontSize="{DynamicResource NocturneFontSizeBody}"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
                <TextBlock Text="нет данных"
                           FontSize="{DynamicResource NocturneFontSizeSmall}"
                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                           Foreground="{DynamicResource NocturneNeutral600Brush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <TextBlock Text="Журнал ещё не подключён."
                       FontSize="{DynamicResource NocturneFontSizeTitle}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource NocturneTextMutedBrush}" />
            <TextBlock TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="{DynamicResource NocturneFontSizeSmall}"
                       Foreground="{DynamicResource NocturneTextFaintBrush}"
                       Text="Демон пишет свой лог файлами, и по IPC он не передаётся ни строкой, ни событием. Пока — logs/ рядом с SmartMacro.Daemon.exe." />
        </StackPanel>
    </Grid>
</UserControl>
