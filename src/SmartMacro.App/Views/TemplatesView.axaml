<!--
  «Шаблоны» — браузер дерева Assets/templates у демона.

  Макет своего экрана для этого режима не рисует (в opt-1b есть только счётчик «31» в рейке),
  поэтому раскладка собрана из уже принятых в проекте приёмов: шапка и плотные строки в 26px
  как в «Окнах», разделы с надзаголовком как в библиотеке макросов, тусклый разделитель над
  проблемной группой как «НЕ ОПОЗНАНО · N».

  Две колонки, и разделение между ними — это разделение протокола:

    · СПИСОК слева живёт на одних метаданных (GetTemplates): имя, размер в пикселях, размер в
      байтах, кому нужен. Приезжает целиком одним запросом.
    · ПРЕВЬЮ справа — единственное место, где вообще есть пиксели, и байты за ним ходят по
      одному файлу за выделением (GetTemplateImage). Миниатюр в строках нет НАМЕРЕННО: это
      ровно тот способ, которым режим потянул бы всё дерево картинок разом по трубе, общей с
      потоком событий прогона.

  Ниже списка — «НЕТ ФАЙЛА»: имена, которые называют ноды, но которых в дереве нет. Считает это
  сама панель, по библиотеке макросов и присланному списку файлов; до этого режима такое
  выяснялось только в момент прогона.

  Цвета — из Themes/Tokens.axaml, литеральным hex здесь места нет.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartMacro.App.ViewModels"
             xmlns:conv="using:SmartMacro.App.Converters"
             x:Class="SmartMacro.App.Views.TemplatesView"
             x:DataType="vm:TemplatesViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="LetterSpacing" Value="0.7" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextGhostBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Строка шаблона. Тот же приём, что у строк библиотеки макросов: выделение — это
             акцентная линейка в 2px плюс заливка 12%, а не :selected у ListBoxItem, потому что
             список разбит на разделы и одним ListBox не рисуется. -->
        <Style Selector="Border.tplRow">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0,10,0" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.tplRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint08Brush}" />
        </Style>
        <Style Selector="Border.tplRow.current">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint12Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
            <Setter Property="Padding" Value="10,0,10,0" />
        </Style>

        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeSmall}" />
            <Setter Property="FontFamily" Value="{DynamicResource NocturneFontFamilyMono}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral600Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ================================= шапка ================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource NocturneDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,9">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Шаблоны"
                           FontSize="{DynamicResource NocturneFontSizeBody}"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           Text="{Binding SummaryText}"
                           FontSize="{DynamicResource NocturneFontSizeSmall}"
                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                           Foreground="{DynamicResource NocturneNeutral600Brush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        Content="Обновить"
                        Height="24"
                        Padding="10,0"
                        IsEnabled="{Binding IsNotLoading}"
                        ToolTip.Tip="Перечитать Assets/templates у демона"
                        Click="OnRefreshClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,340">

            <!-- ================================ список ============================= -->
            <Border Grid.Column="0" Background="{DynamicResource NocturneSurfaceInsetBrush}">
                <ScrollViewer>
                    <StackPanel Margin="0,4,0,12">

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TemplateGroupViewModel">
                                    <StackPanel>
                                        <!-- Что значит «набор», сказано подсказкой, а не в
                                             строке: пояснение на каждом разделе — это шум,
                                             повторяющийся столько раз, сколько у пользователя
                                             папок. -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="12,10,10,4"
                                                    ToolTip.Tip="Подпапка templates/ — набор для RecognizeTag; имя файла в ней становится тегом">
                                            <TextBlock Classes="eyebrow" Text="{Binding Title}" />
                                            <TextBlock Classes="eyebrow" Text="·" />
                                            <TextBlock Classes="eyebrow" Text="{Binding CountText}" />
                                            <TextBlock Classes="eyebrow"
                                                       Text="НАБОР"
                                                       IsVisible="{Binding IsSet}" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TemplateRowViewModel">
                                                    <Border Classes="tplRow"
                                                            Classes.current="{Binding IsSelected}"
                                                            PointerPressed="OnTemplateRowPressed">
                                                        <!-- Колонки фиксированы, а слак уходит в
                                                             хвостовую «*»: на широком окне «*»
                                                             под именем расталкивал метрики к
                                                             правому краю, и строка читалась как
                                                             две несвязанные половины. -->
                                                        <Grid ColumnDefinitions="320,90,80,140,*">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontSize="11.5"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{Binding IsSelected, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneTextBrush|NocturneTextSecondaryBrush}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Classes="cell"
                                                                       Text="{Binding SizeText}" />
                                                            <TextBlock Grid.Column="2"
                                                                       Classes="cell"
                                                                       Text="{Binding BytesText}" />
                                                            <!-- «не используется» — не ошибка, просто факт,
                                                                 поэтому приглушённо, а не тревожным цветом. -->
                                                            <TextBlock Grid.Column="3"
                                                                       Classes="cell"
                                                                       Text="{Binding UsageText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{Binding IsUnused, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneTextGhostBrush|NocturneNeutral500Brush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ==== имя есть, файла нет ==== -->
                        <Border Background="{DynamicResource NocturneSurfaceSunkenBrush}"
                                Height="26"
                                Margin="0,12,0,1"
                                Padding="12,0"
                                IsVisible="{Binding HasMissing}">
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding MissingHeaderText}"
                                           FontSize="9.5"
                                           LetterSpacing="0.7"
                                           Foreground="{DynamicResource NocturneWarningBorderBrush}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Height="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource NocturneUntaggedRuleBrush}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Missing}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MissingTemplateViewModel">
                                    <Border Margin="0,0,0,1"
                                            Padding="12,4"
                                            Background="{DynamicResource NocturneSurfaceRowMutedBrush}"
                                            ToolTip.Tip="{Binding Consequence}">
                                        <Grid ColumnDefinitions="320,90,220,*">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource NocturneWarningBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="cell"
                                                       Text="{Binding Kind}" />
                                            <TextBlock Grid.Column="2"
                                                       Classes="cell"
                                                       Text="{Binding UsageText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ==== пустое состояние ==== -->
                        <StackPanel Margin="12,40" Spacing="6" IsVisible="{Binding IsEmpty}">
                            <TextBlock Text="У демона нет ни одного шаблона."
                                       FontSize="{DynamicResource NocturneFontSizeTitle}"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource NocturneTextMutedBrush}" />
                            <TextBlock Text="Файлы лежат в Assets/templates рядом с демоном: PNG в корне — одиночный шаблон для Find/Wait, подпапка — набор для RecognizeTag, имя файла в ней становится тегом."
                                       FontSize="{DynamicResource NocturneFontSizeSmall}"
                                       HorizontalAlignment="Center"
                                       MaxWidth="460"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource NocturneTextFaintBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================================ превью ============================= -->
            <Border Grid.Column="1"
                    Background="{DynamicResource NocturnePanelDeepBrush}"
                    BorderBrush="{DynamicResource NocturneDividerBrush}"
                    BorderThickness="1,0,0,0">
                <!-- Рамка превью прижата к содержимому (Auto), а всё свободное место собрано в
                     последней строке. С «*» на рамке шаблон высотой 35px висел посреди шестисот
                     пустых пикселей, а список ссылок уезжал к самому низу панели. -->
                <Grid RowDefinitions="Auto,Auto,Auto,*">

                    <StackPanel Grid.Row="0"
                                Margin="12,10,12,8"
                                Spacing="3"
                                IsVisible="{Binding HasSelection}">
                        <TextBlock Text="{Binding Selected.FullName}"
                                   FontSize="{DynamicResource NocturneFontSizeBody}"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="cell" Text="{Binding Selected.SizeText}" />
                            <TextBlock Classes="cell" Text="{Binding Selected.BytesText}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Шахматки под прозрачность нет намеренно: шаблоны — это вырезки игрового
                         интерфейса на тёмном фоне, и тёмная подложка показывает их ровно так, как
                         их видит матчер. -->
                    <Border Grid.Row="1"
                            Margin="12,0,12,10"
                            MinHeight="90"
                            Padding="8"
                            CornerRadius="{DynamicResource NocturneRadiusSm}"
                            Background="{DynamicResource NocturneCanvasBrush}"
                            BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                            BorderThickness="1">
                        <!-- ScrollViewer здесь БЫЛ и был неправ: он даёт содержимому бесконечную
                             ширину, поэтому Uniform + DownOnly не срабатывали никогда и шаблон в
                             365px обрезался краем панели, предлагая взамен горизонтальную
                             прокрутку. Найдено глазами. Без него DownOnly делает ровно
                             обещанное. -->
                        <Panel>
                            <!-- DownOnly: увеличивать шаблон нельзя — он пиксельно точен, и
                                 растянутая картинка врала бы о том, что ищет матчер. Крупный
                                 ужимается, чтобы поместиться целиком. MaxHeight держит высокий
                                 шаблон в рамках панели. -->
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   StretchDirection="DownOnly"
                                   MaxHeight="420"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasPreview}" />

                            <TextBlock Text="{Binding PreviewProblem}"
                                       FontSize="{DynamicResource NocturneFontSizeSmall}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource NocturneWarningBrush}"
                                       IsVisible="{Binding HasPreviewProblem}" />

                            <TextBlock Text="Выберите шаблон слева."
                                       FontSize="{DynamicResource NocturneFontSizeSmall}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource NocturneTextGhostBrush}"
                                       IsVisible="{Binding !HasSelection}" />
                        </Panel>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Margin="12,0,12,12"
                                Spacing="4"
                                IsVisible="{Binding HasSelection}">
                        <TextBlock Classes="eyebrow" Text="{Binding SelectedUsageHeader}" />
                        <ItemsControl ItemsSource="{Binding SelectedUsages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"
                                               Classes="cell"
                                               Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
