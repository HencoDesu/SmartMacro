<!--
  «Шаблоны» — намеренно одна оправа, без содержимого.

  Макет показывает счётчик 31 и обозреватель дерева templates/ у демона. Ни за тем, ни за
  другим протокола нет: в IpcMessageTypes нет ни запроса «перечисли шаблоны», ни способа
  вычитать шаблон обратно. Поэтому счётчик этого режима в боковой рейке намеренно ПУСТ, а не
  выдуман, а тело говорит, чего не хватает, вместо того чтобы притворяться.

  Что для него нужно: запрос, возвращающий имена шаблонов (Assets/GameUiElements плюс набор
  "classes"), и второй, возвращающий байты одного шаблона для предпросмотра.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartMacro.App.ViewModels"
             x:Class="SmartMacro.App.Views.TemplatesView"
             x:DataType="vm:ShellViewModel">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource NocturneDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,9">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Шаблоны"
                           FontSize="{DynamicResource NocturneFontSizeBody}"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
                <TextBlock Text="нет данных"
                           FontSize="{DynamicResource NocturneFontSizeSmall}"
                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                           Foreground="{DynamicResource NocturneNeutral600Brush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <TextBlock Text="Браузер шаблонов ещё не подключён."
                       FontSize="{DynamicResource NocturneFontSizeTitle}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource NocturneTextMutedBrush}" />
            <TextBlock TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="{DynamicResource NocturneFontSizeSmall}"
                       Foreground="{DynamicResource NocturneTextFaintBrush}"
                       Text="Шаблоны лежат у демона, а в протоколе нет ни запроса их списка, ни чтения файла — поэтому счётчик режима пуст, а не выдуман. Появятся вместе с новыми сообщениями IPC." />
        </StackPanel>
    </Grid>
</UserControl>
