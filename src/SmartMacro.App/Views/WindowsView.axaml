<!--
  «Окна» — плотный список окон из opt-1b.html.

  Две группы, и в этом разделении весь смысл раскладки:

    · сначала окна с тегами: строки по 32px на сетке 160 / 88 / 1fr с чередующимися фонами.
      Их теги — фишки с ×, а добавление ещё одного спрятано за тихим «+», который открывает
      поле: с этими строками уже всё сделано.
    · окна без тегов ниже тусклого разделителя «НЕ ОПОЗНАНО · N», нарисованные приглушённо —
      кроме их поля тега, которое является ЕДИНСТВЕННЫМ выделенным контролом на экране
      (акцентная граница), потому что проставить им теги — это всё, что с ними осталось
      сделать.

  Зазоры в 1px между строками — это просвечивающая поверхность-вставка, ровно как flex `gap`
  макета поверх контейнера #20222f.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartMacro.App.ViewModels"
             xmlns:conv="using:SmartMacro.App.Converters"
             xmlns:res="using:SmartMacro.Resources"
             x:Class="SmartMacro.App.Views.WindowsView"
             x:DataType="vm:ShellViewModel">

    <UserControl.Styles>
        <!-- Общее для обеих групп. ColumnDefinitions не является AvaloniaProperty, поэтому
             сетку 160 / 88 / 1fr приходится повторять в каждой строке, а не задавать здесь. -->
        <Style Selector="Grid.windowrow">
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="Grid.windowrow > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ================================= шапка ================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource NocturneDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,9">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{x:Static res:Strings_App.Shell_Mode_Windows}"
                           FontSize="{DynamicResource NocturneFontSizeBody}"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           Text="{Binding Workspace.WindowsSummaryText}"
                           FontSize="{DynamicResource NocturneFontSizeSmall}"
                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                           Foreground="{DynamicResource NocturneNeutral600Brush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <Button Content="{x:Static res:Strings_App.Windows_Header_IdentifyAll}"
                            Height="24"
                            Padding="10,0"
                            IsEnabled="{Binding CanIdentifyAll}"
                            ToolTip.Tip="{x:Static res:Strings_App.Windows_Header_IdentifyAllTip}"
                            Click="OnIdentifyAllClicked" />
                    <Button Content="{x:Static res:Strings_App.Windows_Header_Dump}"
                            Height="24"
                            Padding="10,0"
                            ToolTip.Tip="{x:Static res:Strings_App.Windows_Header_DumpTip}"
                            Click="OnDumpCapturesClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================= строки ================================ -->
        <Border Grid.Row="1" Background="{DynamicResource NocturneSurfaceInsetBrush}">
            <ScrollViewer>
                <StackPanel>

                    <!-- ==== с тегами ==== -->
                    <ItemsControl ItemsSource="{Binding Workspace.TaggedWindows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WindowRowViewModel">
                                <Border Margin="0,0,0,1"
                                        Padding="12,0"
                                        Background="{Binding IsAlternate, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneSurfaceRowAltBrush|NocturneBgBrush}">
                                    <Grid Classes="windowrow" ColumnDefinitions="160,88,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ProcessName}"
                                                   FontSize="{DynamicResource NocturneFontSizeBody}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding HwndHex}"
                                                   FontSize="{DynamicResource NocturneFontSizeSmall}"
                                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                   Foreground="{DynamicResource NocturneNeutral600Brush}" />
                                        <!-- Фишки, а сразу за ними — кнопка добавления:
                                             припаркованная у правого края колонки 1fr, она
                                             читалась бы как постороннее действие над строкой. -->
                                        <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,*">
                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TagChipViewModel">
                                                        <Border Height="19"
                                                                Margin="0,0,5,0"
                                                                Padding="8,0,3,0"
                                                                CornerRadius="{DynamicResource NocturneRadiusPill}"
                                                                Background="{DynamicResource NocturneChipFillBrush}"
                                                                BorderBrush="{DynamicResource NocturneChipBorderBrush}"
                                                                BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Text}"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource NocturneChipTextBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <Button Content="×"
                                                                        Classes="ghost"
                                                                        FontSize="10.5"
                                                                        MinWidth="0"
                                                                        Padding="3,0"
                                                                        Margin="0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip.Tip="{x:Static res:Strings_App.Windows_Row_RemoveTag}"
                                                                        Click="OnRemoveTagClicked" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Тихое добавление тега: «+», открывающий поле только по просьбе. -->
                                            <Button Grid.Column="1"
                                                    Content="+"
                                                    Classes="ghost"
                                                    Padding="6,0"
                                                    MinWidth="0"
                                                    IsVisible="{Binding !IsAddingTag}"
                                                    ToolTip.Tip="{x:Static res:Strings_App.Windows_Row_AddTag}"
                                                    Click="OnBeginAddTagClicked" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                        IsVisible="{Binding IsAddingTag}">
                                                <TextBox Width="120"
                                                         Height="21"
                                                         MinHeight="21"
                                                         Padding="7,0"
                                                         VerticalContentAlignment="Center"
                                                         FontSize="10.5"
                                                         Watermark="{x:Static res:Strings_App.Windows_Row_NewTagWatermark}"
                                                         Text="{Binding NewTagText, Mode=TwoWay}"
                                                         KeyDown="OnTagInputKeyDown"
                                                         AttachedToVisualTree="OnInlineTagBoxAttached" />
                                                <Button Content="+"
                                                        Height="21"
                                                        MinWidth="22"
                                                        Padding="0"
                                                        ToolTip.Tip="{x:Static res:Strings_App.Windows_Row_AddTag}"
                                                        Click="OnAddTagClicked" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ==== разделитель ==== -->
                    <Border Background="{DynamicResource NocturneSurfaceSunkenBrush}"
                            Height="26"
                            Margin="0,0,0,1"
                            Padding="12,0"
                            IsVisible="{Binding Workspace.HasUntagged}">
                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Workspace.UntaggedHeaderText}"
                                       FontSize="9.5"
                                       LetterSpacing="0.7"
                                       Foreground="{DynamicResource NocturneWarningBorderBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource NocturneUntaggedRuleBrush}" />
                        </Grid>
                    </Border>

                    <!-- ==== без тегов ==== -->
                    <ItemsControl ItemsSource="{Binding Workspace.UntaggedWindows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WindowRowViewModel">
                                <Border Margin="0,0,0,1"
                                        Padding="12,0"
                                        Background="{DynamicResource NocturneSurfaceRowMutedBrush}">
                                    <Grid Classes="windowrow" ColumnDefinitions="160,88,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ProcessName}"
                                                   FontSize="{DynamicResource NocturneFontSizeBody}"
                                                   Foreground="{DynamicResource NocturneTextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding HwndHex}"
                                                   FontSize="{DynamicResource NocturneFontSizeSmall}"
                                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                   Foreground="{DynamicResource NocturneTextFaintBrush}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <TextBox Width="120"
                                                     Height="21"
                                                     MinHeight="21"
                                                     Padding="7,0"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="10.5"
                                                     Watermark="{x:Static res:Strings_App.Windows_Row_NewTagWatermark}"
                                                     Background="{DynamicResource NocturneSurfaceOverlayBrush}"
                                                     BorderBrush="{DynamicResource NocturneChipInputBorderBrush}"
                                                     Text="{Binding NewTagText, Mode=TwoWay}"
                                                     KeyDown="OnTagInputKeyDown" />
                                            <Button Content="+"
                                                    Classes="accent"
                                                    Height="21"
                                                    MinWidth="22"
                                                    Padding="0"
                                                    ToolTip.Tip="{x:Static res:Strings_App.Windows_Row_AddTag}"
                                                    Click="OnAddTagClicked" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ==== пустое состояние ==== -->
                    <StackPanel Margin="12,40" Spacing="6" IsVisible="{Binding Workspace.HasNoWindows}">
                        <TextBlock Text="{x:Static res:Strings_App.Windows_Empty_Title}"
                                   FontSize="{DynamicResource NocturneFontSizeTitle}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource NocturneTextMutedBrush}" />
                        <TextBlock Text="{x:Static res:Strings_App.Windows_Empty_Hint}"
                                   FontSize="{DynamicResource NocturneFontSizeSmall}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource NocturneTextFaintBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
