<!--
  «Макросы» — the rows editor of plan §0.5, which until D2 was the modal MacrosDialog.

  Left: the library. Right: the selected graph's triggers and its nodes, one row each.
  A node row is a shell (type, id, reorder/delete) plus three parts rendered from the row
  view-model's own type: the type-specific parameter block, the target selector, and one
  drop-down per outgoing edge. Editing edges as node-id drop-downs is what makes branchy
  graphs fully editable here; D3's canvas adds direct manipulation over the same model.

  D2 moved this markup out of a Window and changed as little as it could get away with:
  the dialog's own header/close row is gone (there is no dialog to close), the library
  column narrowed 280 → 220 to fit the 900px shell, and the node list scrolls horizontally
  instead of clipping. Everything else — every binding, every handler name — is what the
  dialog had. D3 replaces the innards wholesale, so it is deliberately NOT restructured.

  Global hotkeys are suspended for as long as this mode is on screen; that bracket now
  lives in ShellViewModel, not here.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:SmartMacro.App.ViewModels"
             xmlns:nodes="using:SmartMacro.App.ViewModels.Nodes"
             xmlns:conv="using:SmartMacro.App.Converters"
             xmlns:controls="using:SmartMacro.App.Controls"
             x:Class="SmartMacro.App.Views.MacrosView"
             x:DataType="vm:MacroEditorViewModel">

    <UserControl.Styles>
        <!-- The parameter blocks below are a wall of tiny "label: field" pairs. Naming the
             two recurring roles once keeps the token references out of every single row. -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeMicro}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral600Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeMicro}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.numeric">
            <Setter Property="FontFamily" Value="{DynamicResource NocturneFontFamilyMono}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>

        <!-- ==== shared building blocks ==== -->

        <!-- One outgoing edge: outcome label + a drop-down of node ids ("" = end of run). -->
        <DataTemplate DataType="{x:Type nodes:NodeEdgeViewModel}" x:DataType="nodes:NodeEdgeViewModel">
            <StackPanel Orientation="Horizontal" Spacing="5.6" Margin="0,2.8,11.2,0">
                <TextBlock Classes="label" Text="{Binding Label}" />
                <ComboBox MinWidth="170"
                          ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding TargetId, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <TextBlock Text="{Binding ., Converter={x:Static conv:NodeIdDisplayConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </DataTemplate>

        <!-- Target selector: off = context window, on = fan out by tags. -->
        <DataTemplate DataType="{x:Type nodes:TargetSelectorViewModel}" x:DataType="nodes:TargetSelectorViewModel">
            <StackPanel Spacing="2.8" Margin="0,2.8,0,0">
                <CheckBox Content="Цели по тегам (выкл. — контекст-окно)"
                          IsChecked="{Binding UseSelector, Mode=TwoWay}" />
                <Grid ColumnDefinitions="Auto,*,Auto,*"
                      IsVisible="{Binding UseSelector}">
                    <TextBlock Grid.Column="0"
                               Classes="label"
                               Text="нужны:"
                               Margin="0,0,5.6,0" />
                    <TextBox Grid.Column="1"
                             Watermark="через запятую"
                             Text="{Binding RequireText, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2"
                               Classes="label"
                               Text="исключить:"
                               Margin="11.2,0,5.6,0" />
                    <TextBox Grid.Column="3"
                             Watermark="через запятую"
                             Text="{Binding ExcludeText, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Client-space rectangle. -->
        <DataTemplate DataType="{x:Type nodes:RegionEditorViewModel}" x:DataType="nodes:RegionEditorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="2.8">
                <TextBlock Classes="label" Text="регион" />
                <TextBox Classes="numeric" Width="62" Watermark="X" Text="{Binding XText, Mode=TwoWay}" />
                <TextBox Classes="numeric" Width="62" Watermark="Y" Text="{Binding YText, Mode=TwoWay}" />
                <TextBox Classes="numeric" Width="62" Watermark="W" Text="{Binding WidthText, Mode=TwoWay}" />
                <TextBox Classes="numeric" Width="62" Watermark="H" Text="{Binding HeightText, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <!-- ==== node parameter blocks (one per node type) ==== -->

        <DataTemplate DataType="{x:Type nodes:KeyPressNodeRowViewModel}" x:DataType="nodes:KeyPressNodeRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="5.6">
                <TextBlock Classes="label" Text="клавиша" />
                <controls:KeyBindingPicker MinWidth="150"
                                           CaptureModifiers="False"
                                           Key="{Binding KeyName, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:ClickNodeRowViewModel}" x:DataType="nodes:ClickNodeRowViewModel">
            <StackPanel Spacing="2.8">
                <StackPanel Orientation="Horizontal" Spacing="11.2">
                    <CheckBox Content="из переменной" IsChecked="{Binding UseVariable, Mode=TwoWay}" />
                    <CheckBox Content="двойной клик" IsChecked="{Binding DoubleClick, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2.8" IsVisible="{Binding UseLiteralPoint}">
                    <TextBlock Classes="label" Text="X" />
                    <TextBox Classes="numeric" Width="80" Text="{Binding XText, Mode=TwoWay}" />
                    <TextBlock Classes="label" Text="Y" Margin="5.6,0,0,0" />
                    <TextBox Classes="numeric" Width="80" Text="{Binding YText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2.8" IsVisible="{Binding UseVariable}">
                    <TextBlock Classes="label" Text="переменная" />
                    <TextBox Width="160" Watermark="cursor" Text="{Binding PointVar, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:DelayNodeRowViewModel}" x:DataType="nodes:DelayNodeRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="5.6">
                <TextBlock Classes="label" Text="пауза" />
                <TextBox Classes="numeric" Width="90" Text="{Binding SecondsText, Mode=TwoWay}" />
                <TextBlock Classes="hint" Text="сек (дробное — можно: 1.5 = 1500 мс)" />
            </StackPanel>
        </DataTemplate>

        <!-- Add/Remove tag share one block: they differ only in direction, which the row header already says. -->
        <DataTemplate DataType="{x:Type nodes:TagNodeRowViewModel}" x:DataType="nodes:TagNodeRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="5.6">
                <TextBlock Classes="label" Text="тег" />
                <TextBox Width="220" Watermark="имя тега или {переменная}" Text="{Binding Tag, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:SetIconNodeRowViewModel}" x:DataType="nodes:SetIconNodeRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="5.6">
                <TextBlock Classes="label" Text="иконка" />
                <TextBox Width="330" Watermark="Assets/ClassIcons/{tag}.png" Text="{Binding IconPath, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:RunMacroNodeRowViewModel}" x:DataType="nodes:RunMacroNodeRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8.4">
                <TextBlock Classes="label" Text="макрос" />
                <ComboBox MinWidth="220"
                          ItemsSource="{Binding MacroChoices}"
                          SelectedItem="{Binding MacroName, Mode=TwoWay}" />
                <CheckBox Content="ждать завершения" IsChecked="{Binding Await, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:FindElementNodeRowViewModel}" x:DataType="nodes:FindElementNodeRowViewModel">
            <StackPanel Spacing="2.8">
                <StackPanel Orientation="Horizontal" Spacing="5.6">
                    <TextBlock Classes="label" Text="шаблон" />
                    <TextBox Width="200" Watermark="имя файла без .png" Text="{Binding Template, Mode=TwoWay}" />
                    <TextBlock Classes="label" Text="точка →" Margin="8.4,0,0,0" />
                    <TextBox Width="130" Watermark="переменная (необяз.)" Text="{Binding FoundPointVar, Mode=TwoWay}" />
                </StackPanel>
                <ContentControl Content="{Binding Region}" />
                <TextBlock Classes="hint" Text="W или H = 0 — искать по всему окну" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:WaitForElementNodeRowViewModel}" x:DataType="nodes:WaitForElementNodeRowViewModel">
            <StackPanel Spacing="2.8">
                <StackPanel Orientation="Horizontal" Spacing="5.6">
                    <TextBlock Classes="label" Text="шаблон" />
                    <TextBox Width="200" Watermark="имя файла без .png" Text="{Binding Template, Mode=TwoWay}" />
                    <TextBlock Classes="label" Text="таймаут" Margin="8.4,0,0,0" />
                    <TextBox Classes="numeric" Width="90" Text="{Binding TimeoutMsText, Mode=TwoWay}" />
                    <TextBlock Classes="hint" Text="мс" />
                    <TextBlock Classes="label" Text="точка →" Margin="8.4,0,0,0" />
                    <TextBox Width="130" Watermark="переменная (необяз.)" Text="{Binding FoundPointVar, Mode=TwoWay}" />
                </StackPanel>
                <ContentControl Content="{Binding Region}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:RecognizeTagNodeRowViewModel}" x:DataType="nodes:RecognizeTagNodeRowViewModel">
            <StackPanel Spacing="2.8">
                <StackPanel Orientation="Horizontal" Spacing="5.6">
                    <TextBlock Classes="label" Text="набор" />
                    <TextBox Width="160" Watermark="classes" Text="{Binding TemplateSet, Mode=TwoWay}" />
                    <CheckBox Content="вешать тег" IsChecked="{Binding ApplyTag, Mode=TwoWay}" Margin="8.4,0,0,0" />
                    <TextBlock Classes="label" Text="результат →" Margin="8.4,0,0,0" />
                    <TextBox Width="120" Watermark="tag" Text="{Binding ResultVar, Mode=TwoWay}" />
                </StackPanel>
                <ContentControl Content="{Binding Region}" />
            </StackPanel>
        </DataTemplate>

        <!-- ==== trigger rows ==== -->

        <DataTemplate DataType="{x:Type nodes:HotkeyTriggerRowViewModel}" x:DataType="nodes:HotkeyTriggerRowViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2.8">
                <TextBlock Grid.Column="0"
                           Classes="label"
                           Text="Хоткей"
                           FontSize="{DynamicResource NocturneFontSizeSmall}"
                           Width="130" />
                <controls:KeyBindingPicker Grid.Column="1"
                                           HorizontalAlignment="Stretch"
                                           CaptureModifiers="True"
                                           Key="{Binding KeyName, Mode=TwoWay}"
                                           Modifiers="{Binding Modifiers, Mode=TwoWay}"
                                           MouseButton="{Binding MouseButton, Mode=TwoWay}" />
                <Button Grid.Column="2"
                        Content="×"
                        Classes="ghost"
                        Margin="5.6,0,0,0"
                        Click="OnRemoveTriggerClicked" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:ProcessTriggerRowViewModel}" x:DataType="nodes:ProcessTriggerRowViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2.8">
                <TextBlock Grid.Column="0"
                           Classes="label"
                           Text="Появление процесса"
                           FontSize="{DynamicResource NocturneFontSizeSmall}"
                           Width="130" />
                <TextBox Grid.Column="1"
                         Watermark="elementclient_64"
                         Text="{Binding ProcessName, Mode=TwoWay}" />
                <Button Grid.Column="2"
                        Content="×"
                        Classes="ghost"
                        Margin="5.6,0,0,0"
                        Click="OnRemoveTriggerClicked" />
            </Grid>
        </DataTemplate>

        <!-- ==== validation issue ==== -->

        <DataTemplate DataType="{x:Type vm:ValidationIssueViewModel}" x:DataType="vm:ValidationIssueViewModel">
            <Button Classes="ghost"
                    Padding="2.8,1.4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OnIssueClicked">
                <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                           TextWrapping="Wrap"
                           Foreground="{Binding IsError, Converter={x:Static conv:IssueSeverityToBrushConverter.Instance}}"
                           Text="{Binding Display}" />
            </Button>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,*">

        <!-- Mode header, same chrome as «Окна» / «Прогоны» so the rail reads as one app. -->
        <Border Grid.Row="0"
                Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource NocturneDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,9">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Макросы"
                           FontSize="{DynamicResource NocturneFontSizeBody}"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           Text="глобальные хоткеи выключены, пока открыт редактор"
                           FontSize="{DynamicResource NocturneFontSizeSmall}"
                           Foreground="{DynamicResource NocturneNeutral600Brush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        Content="+ Новый макрос"
                        Height="24"
                        Padding="10,0"
                        Click="OnNewMacroClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*" Margin="{DynamicResource NocturneInsetPanel}">

            <!-- ==== library ==== -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                    Background="{DynamicResource NocturneBgBrush}"
                    CornerRadius="{DynamicResource NocturneRadiusSm}">
                <ListBox ItemsSource="{Binding Macros}"
                         SelectedItem="{Binding SelectedMacro, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MacroListItemViewModel">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           FontSize="{DynamicResource NocturneFontSizeBody}"
                                           VerticalAlignment="Center"
                                           Text="{Binding Name}" />
                                <Button Grid.Row="0" Grid.Column="1"
                                        Content="▸"
                                        Classes="accent"
                                        Padding="{DynamicResource NocturneInsetTight}"
                                        ToolTip.Tip="Запустить"
                                        IsEnabled="{Binding IsNotRunning}"
                                        Click="OnRunMacroClicked" />
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="■"
                                        Padding="{DynamicResource NocturneInsetTight}"
                                        Margin="2.8,0,0,0"
                                        ToolTip.Tip="Остановить"
                                        IsEnabled="{Binding IsRunning}"
                                        Click="OnStopMacroClicked" />
                                <Button Grid.Row="0" Grid.Column="3"
                                        Content="×"
                                        Classes="ghost"
                                        Margin="2.8,0,0,0"
                                        ToolTip.Tip="Удалить"
                                        Click="OnDeleteMacroClicked" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                                           FontSize="{DynamicResource NocturneFontSizeMicro}"
                                           Foreground="{DynamicResource NocturneTextFaintBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Summary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ==== editor ==== -->
            <Grid Grid.Column="1" Margin="11.2,0,0,0" RowDefinitions="Auto,Auto,*,Auto,Auto"
                  IsVisible="{Binding HasOpenMacro}">

                <!-- name + start node -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8.4">
                    <TextBlock Grid.Column="0" Classes="label" Text="Имя" FontSize="{DynamicResource NocturneFontSizeSmall}" Margin="0,0,5.6,0" />
                    <TextBox Grid.Column="1" FontSize="{DynamicResource NocturneFontSizeBody}" Text="{Binding MacroName, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Classes="label" Text="старт" FontSize="{DynamicResource NocturneFontSizeSmall}" Margin="11.2,0,5.6,0" />
                    <ComboBox Grid.Column="3"
                              MinWidth="170"
                              ItemsSource="{Binding StartNodeChoices}"
                              SelectedItem="{Binding StartNodeId, Mode=TwoWay}" />
                </Grid>

                <!-- triggers -->
                <Border Grid.Row="1"
                        Padding="{DynamicResource NocturneInsetPanel}"
                        Margin="0,0,0,8.4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                        Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                        CornerRadius="{DynamicResource NocturneRadiusSm}">
                    <StackPanel Spacing="2.8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       FontSize="{DynamicResource NocturneFontSizeBody}"
                                       Foreground="{DynamicResource NocturneTextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Text="Триггеры" />
                            <Button Grid.Column="1" Content="+ хоткей" Padding="{DynamicResource NocturneInsetTight}" Click="OnAddHotkeyTriggerClicked" />
                            <Button Grid.Column="2" Content="+ процесс" Padding="{DynamicResource NocturneInsetTight}" Margin="5.6,0,0,0" Click="OnAddProcessTriggerClicked" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Triggers}" />
                    </StackPanel>
                </Border>

                <!-- nodes -->
                <Border Grid.Row="2"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                        Background="{DynamicResource NocturneBgBrush}"
                        CornerRadius="{DynamicResource NocturneRadiusSm}">
                    <!-- Horizontal scrolling, not clipping: a node row is wider than the
                         shell's work area at the mockup's 900px, and D3 is what fixes that
                         properly. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="nodes:NodeRowViewModel">
                                    <Border Padding="{DynamicResource NocturneInsetPanel}"
                                            Margin="{DynamicResource NocturneSpace1Thickness}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource NocturneDividerBrush}"
                                            CornerRadius="{DynamicResource NocturneRadiusSm}"
                                            Background="{DynamicResource NocturneSurfaceRaisedBrush}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <!-- selection accent, lit by clicking a validation issue -->
                                            <Border Grid.Column="0"
                                                    Width="2"
                                                    CornerRadius="1"
                                                    Margin="0,0,8.4,0"
                                                    Background="{DynamicResource NocturneAccentBrush}"
                                                    IsVisible="{Binding IsSelected}" />
                                            <StackPanel Grid.Column="1" Spacing="2.8">
                                                <Grid ColumnDefinitions="Auto,Auto,180,*,Auto,Auto,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               FontSize="{DynamicResource NocturneFontSizeBody}"
                                                               Foreground="{DynamicResource NocturneAccent300Brush}"
                                                               MinWidth="140"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding TypeLabel}" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="label"
                                                               Text="id"
                                                               Margin="0,0,5.6,0" />
                                                    <TextBox Grid.Column="2"
                                                             Classes="numeric"
                                                             ToolTip.Tip="Переименование автоматически перешивает входящие рёбра"
                                                             Text="{Binding NodeId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                    <Button Grid.Column="4" Content="↑" Padding="{DynamicResource NocturneInsetTight}" Click="OnMoveNodeUpClicked" />
                                                    <Button Grid.Column="5" Content="↓" Padding="{DynamicResource NocturneInsetTight}" Margin="2.8,0,0,0" Click="OnMoveNodeDownClicked" />
                                                    <Button Grid.Column="6" Content="×" Classes="ghost" Margin="5.6,0,0,0" ToolTip.Tip="Удалить ноду" Click="OnDeleteNodeClicked" />
                                                </Grid>

                                                <!-- type-specific parameters, matched on the row's concrete type -->
                                                <ContentControl Content="{Binding}" />

                                                <!-- selector: absent for conditionals and Delay -->
                                                <ContentControl Content="{Binding Target}" IsVisible="{Binding HasTarget}" />

                                                <ItemsControl ItemsSource="{Binding Edges}" Margin="0,2.8,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- messages + validation -->
                <StackPanel Grid.Row="3" Spacing="2.8" Margin="0,8.4,0,8.4">
                    <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                               Foreground="{DynamicResource NocturneWarningBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ChangedOnDisk}"
                               Text="Макрос изменён на диске, а здесь есть несохранённые правки. «Перечитать» — взять версию с диска, «Сохранить» — затереть её." />
                    <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                               Foreground="{DynamicResource NocturneDangerBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:NotNullToBoolConverter.Instance}}"
                               Text="{Binding ErrorMessage}" />
                    <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                               Foreground="{DynamicResource NocturneTextFaintBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={x:Static conv:NotNullToBoolConverter.Instance}}"
                               Text="{Binding StatusMessage}" />
                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource NocturneDangerBorderBrush}"
                            Background="{DynamicResource NocturneDangerSurfaceBrush}"
                            CornerRadius="{DynamicResource NocturneRadiusSm}"
                            Padding="{DynamicResource NocturneInsetTight}"
                            IsVisible="{Binding HasIssues}">
                        <ScrollViewer MaxHeight="120">
                            <ItemsControl ItemsSource="{Binding Issues}" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- actions -->
                <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto">
                    <Button Grid.Column="0" x:Name="AddNodeButton" Content="+ Нода">
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <ItemsControl ItemsSource="{Binding NodeKinds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="nodes:MacroNodeKindOption">
                                            <Button Content="{Binding Label}"
                                                    Classes="ghost"
                                                    Padding="{DynamicResource NocturneInsetField}"
                                                    MinWidth="180"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="OnAddNodeClicked" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="1"
                            Content="Перечитать"
                            Margin="5.6,0,0,0"
                            ToolTip.Tip="Отбросить правки и взять версию с диска"
                            Click="OnReloadClicked" />
                    <Button Grid.Column="2"
                            Content="Папка макросов"
                            Margin="5.6,0,0,0"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="{Binding FolderPath}"
                            Click="OnOpenFolderClicked" />
                    <Button Grid.Column="3"
                            Content="Сохранить"
                            Classes="accent"
                            Click="OnSaveClicked" />
                </Grid>
            </Grid>

            <!-- empty state -->
            <StackPanel Grid.Column="1"
                        Margin="11.2,0,0,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8.4"
                        IsVisible="{Binding !HasOpenMacro}">
                <TextBlock FontSize="{DynamicResource NocturneFontSizeTitle}"
                           Foreground="{DynamicResource NocturneTextMutedBrush}"
                           Text="Выберите макрос слева или создайте новый." />
                <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                           Foreground="{DynamicResource NocturneTextFaintBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding FolderPath}" />
                <Button Content="Открыть папку макросов"
                        Classes="accent"
                        HorizontalAlignment="Center"
                        Click="OnOpenFolderClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
