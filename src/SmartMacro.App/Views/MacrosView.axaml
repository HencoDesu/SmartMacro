<!--
  «Макросы» — редактор нод на canvas (волна D3a).
  Источник истины: docs/design/opt-1d.html (canvas и инспектор) и opt-1e.html (коробка,
  развёрнутая в редактор самой себя). Строчного редактора, который это заменило, больше нет.

  Четыре колонки раскладки 1d, слева направо:

    · БИБЛИОТЕКА — дерево: заголовок группы есть сам макрос, вложенные строки — его функции
      (F4). Группировка по приставке в имени, что была здесь до того, выводила структуру из
      того, как названы файлы, и была честна ровно потому, что другой структуры не было.
    · CANVAS. Коробки разложены «рядами с переносом», а рёбра идут по жёлобам МЕЖДУ рядами —
      никогда наискось через коробку. Условная нода несёт оба исхода подписанными рядами
      вдоль своей нижней кромки, и именно это делает «в конец» читаемым без терминальной
      ноды: неподключённый исход говорит «→ конец» в собственном ряду и не рисует линии
      вовсе.
    · ЛОГ ПРОГОНА (D3b), который кормит поток RunEvents от демона. В его шапке живёт
      переключатель прогонов — по одному графу могут идти десять окон разом, и полоса вместе
      с подсветкой на canvas следуют ровно за одним из них.
    · ИНСПЕКТОР. Одиночный клик по коробке наполняет его; двойной разворачивает коробку на
      месте (1e), и оба правят одну и ту же view-model, так что разойтись они не могут.

  Всё рисуется из Themes/Tokens.axaml. Буквальному цвету в этом файле места нет.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:SmartMacro.App.ViewModels"
             xmlns:canvas="using:SmartMacro.App.ViewModels.Canvas"
             xmlns:nodes="using:SmartMacro.App.ViewModels.Nodes"
             xmlns:conv="using:SmartMacro.App.Converters"
             xmlns:controls="using:SmartMacro.App.Controls"
             xmlns:res="using:SmartMacro.Resources"
             x:Class="SmartMacro.App.Views.MacrosView"
             x:DataType="vm:MacroEditorViewModel">

    <UserControl.Styles>
        <!-- Блоки параметров — сплошная стена пар «подпись: поле»; один раз назвав повторяющиеся
             роли, мы избавляем каждую строку от ссылок на токены. -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeMicro}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral600Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeMicro}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="LetterSpacing" Value="0.7" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextGhostBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="{DynamicResource NocturneFontFamilyMono}" />
        </Style>
        <Style Selector="TextBox.numeric">
            <Setter Property="FontFamily" Value="{DynamicResource NocturneFontFamilyMono}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="2.8,2.8" />
        </Style>

        <!-- ========================= строки библиотеки ========================= -->
        <Style Selector="Border.libRow">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.libRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint08Brush}" />
        </Style>
        <Style Selector="Border.libRow.current">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint12Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
            <Setter Property="Padding" Value="10,0,8,0" />
        </Style>

        <!-- ============================ коробки нод ============================ -->
        <Style Selector="Border.node">
            <Setter Property="Background" Value="{DynamicResource NocturneNodeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNodeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BoxShadow" Value="{DynamicResource NocturneShadowNode}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.node:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral700Brush}" />
        </Style>
        <Style Selector="Border.node.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource NocturneShadowNodeSelected}" />
        </Style>
        <!-- «Пройдено» ПЕРЕД «идёт» и «на паузе», чтобы коробка, которая и то и другое (цикл
             обратно на ноду, где обход уже был), читалась как живая. Порядок тут и есть всё
             правило: среди селекторов одинаковой специфичности в Avalonia побеждает ПОСЛЕДНИЙ —
             та самая ловушка, на которую D1 напоролась, когда .accent проиграл :disabled. -->
        <Style Selector="Border.node.passed">
            <Setter Property="Background" Value="{DynamicResource NocturneNodePassedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNodePassedBorderBrush}" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>
        <Style Selector="Border.node.running">
            <Setter Property="Background" Value="{DynamicResource NocturneNodeRunningBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Припаркована: акцентная поверхность живой ноды, окантованная тревожным. «Остановлено
             здесь» не имеет права выглядеть как «идёт здесь» — по последствиям их разделяет одно
             нажатие клавиши. -->
        <Style Selector="Border.node.paused">
            <Setter Property="Background" Value="{DynamicResource NocturneNodeRunningBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNodePausedBorderBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Концы связи по переменной, на которую навели. Контур, а не заливка: коробка может
             быть заодно пройденной или живой, и это должно лечь поверх любого из двух, не
             спрятав его. -->
        <Style Selector="Border.node.varSource, Border.node.varConsumer">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneVariableBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Отмечена для выделения в под-макрос (Ctrl+клик, F4). Толстая акцентная рамка, а не
             заливка: отметка обязана читаться поверх «пройдено» и «идёт» — набирают её как раз по
             свежему прогону, глядя, какой кусок графа стоит вынести. Стоит ПОСЛЕДНЕЙ среди
             .node-селекторов той же специфичности: в Avalonia побеждает последний. -->
        <Style Selector="Border.node.marked">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Отметка точки останова.
             Макет рисует её точкой, свисающей наполовину с левого верхнего угла коробки. Здесь
             это не выживает: что-то выше контейнера элемента режет по границам коробки —
             выставление ClipToBounds="False" на сгенерированном ContentPresenter не изменило
             ничего, — и нода на canvas при x=0 теряла внешнюю половину точки, отрисовываясь
             красной щепкой. Вместо того чтобы выпускать отметку, чью видимость решает случайное
             положение ноды, она стала полосой в жёлобе по внутренней кромке коробки: та самая
             форма, которой любая IDE обозначает то же самое, и её не срежет ни при каком
             положении и масштабе. -->
        <Style Selector="Border.breakpointBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="5,0,0,5" />
            <Setter Property="Background" Value="{DynamicResource NocturneDangerBrush}" />
        </Style>

        <!-- Пульсирующая текущая нода из макета. Отдельное кольцо, а не анимация самой коробки:
             угасание Border утащило бы за собой и его текст, а вся суть в том, чтобы живая нода
             оставалась самой читаемой. Невидимо и НЕПОДВИЖНО, пока класс не навешен, — Avalonia
             крутит анимацию стиля только пока его селектор подходит, так что у простаивающего
             canvas нет вообще никаких таймеров. -->
        <Style Selector="Border.pulseRing">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccent300Brush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.pulseRing.pulsing">
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.15" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.9" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.15" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.nodeHeader">
            <Setter Property="Height" Value="19" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="{DynamicResource NocturneNodeHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNodeHeaderBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.nodeHeader.conditional">
            <Setter Property="Background" Value="{DynamicResource NocturneNodeConditionalHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNodeConditionalHeaderBorderBrush}" />
        </Style>
        <Style Selector="Border.nodeHeader.running">
            <Setter Property="Background" Value="{DynamicResource NocturneNodeRunningHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNodeRunningHeaderBorderBrush}" />
        </Style>
        <!-- Точка порта. Её ЦЕНТР лежит ровно на правой кромке коробки — там же CanvasEdgeRouter
             начинает линию, так что отрицательный отступ здесь несущий. -->
        <Style Selector="Border.port">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="CornerRadius" Value="3.5" />
            <Setter Property="Margin" Value="6,0,-3.5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Cross" />
            <Setter Property="Background" Value="{DynamicResource NocturneTextFaintBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Неподключённый: пустое колечко, чтобы «этот исход завершает прогон» было видно через
             весь canvas и никогда не читалось как потерянное соединение. -->
        <Style Selector="Border.port.loose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneEdgeBrush}" />
        </Style>
        <Style Selector="Border.port:pointerover">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
        </Style>
        <Style Selector="Border.keycap">
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource NocturneKeycapBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneNeutral800Brush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- ============================ бейдж целей (1g) ============================
             Три тона, и разница между ними — это и есть весь виджет: нейтральный для
             «контекстного окна», акцентный для «во что-то попадает», тревожный для «не
             попадает ни во что». «0 окон» не имеет права выглядеть обычным числом — но см.
             TargetSelectorViewModel.BadgeIsDanger о том, почему «у демона вообще нет окон»
             намеренно НЕ считается тревожным случаем. -->
        <!-- Без фиксированной высоты: одна и та же пилюля должна помещаться и в 19-пиксельную
             шапку ноды, и в инспектор, а жёсткие 22px (отдельная карточка из макета) шапку бы
             разорвали. Отступы дают ей ~18px, и читается она одинаково в обоих местах. -->
        <Style Selector="Border.targetBadge">
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="CornerRadius" Value="{DynamicResource NocturneRadiusPill}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneDividerStrongBrush}" />
            <Setter Property="Background" Value="{DynamicResource NocturneFieldBackgroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.targetBadge TextBlock.badgeText">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextMutedBrush}" />
        </Style>
        <Style Selector="Border.targetBadge.accent">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneChipInputBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint15Brush}" />
        </Style>
        <Style Selector="Border.targetBadge.accent TextBlock.badgeText">
            <Setter Property="Foreground" Value="{DynamicResource NocturneChipTextSoftBrush}" />
        </Style>
        <Style Selector="Border.targetBadge.danger">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneDangerBorderHoverBrush}" />
            <Setter Property="Background" Value="{DynamicResource NocturneDangerSurfaceBrush}" />
        </Style>
        <Style Selector="Border.targetBadge.danger TextBlock.badgeText">
            <Setter Property="Foreground" Value="{DynamicResource NocturneDangerBrush}" />
        </Style>

        <!-- Одно окно, названное в развёрнутом бейдже. `.missed` — окно, которое селектор
             пропускает намеренно: перечёркнуто, а не спрятано, потому что «кто выпал» — это
             половина того, ради чего бейдж разворачивают. -->
        <Style Selector="Border.windowChip">
            <Setter Property="Height" Value="19" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="CornerRadius" Value="{DynamicResource NocturneRadiusSm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneChipBorderSoftBrush}" />
            <Setter Property="Background" Value="{DynamicResource NocturneChipFillSoftBrush}" />
        </Style>
        <Style Selector="Border.windowChip.missed">
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneDividerStrongBrush}" />
            <Setter Property="Background" Value="{DynamicResource NocturneFieldBackgroundBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>

        <!-- ==== бейдж целей, свёрнутый (макет 1g) ====
             «8 окон · кроме Склад». Число идёт первым: какие там теги, и так видно в
             инспекторе, а отвечает бейдж на вопрос, до скольких окон действие дотянется.
             Четыре полоски — это доля с одного взгляда; ненулевая доля всегда закрашивает
             хотя бы одну, так что «1 из 11» не отрисовывается пустой полосой никогда. -->
        <DataTemplate x:Key="TargetBadgeTemplate" x:DataType="nodes:TargetSelectorViewModel">
            <Border Classes="targetBadge"
                    Classes.accent="{Binding BadgeIsAccent}"
                    Classes.danger="{Binding BadgeIsDanger}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5"
                             VerticalAlignment="Center"
                             IsVisible="{Binding ShowsHollowDot}"
                             Stroke="{DynamicResource NocturneNeutral600Brush}"
                             StrokeThickness="1" />
                    <Ellipse Width="5" Height="5"
                             VerticalAlignment="Center"
                             IsVisible="{Binding ShowsDangerDot}"
                             Fill="{DynamicResource NocturneDangerBrush}" />
                    <ItemsControl VerticalAlignment="Center"
                                  IsVisible="{Binding ShowsBars}"
                                  ItemsSource="{Binding Bars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1.5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:Boolean">
                                <Border Width="3" Height="9" CornerRadius="1"
                                        Background="{Binding ., Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccentBrush|NocturneChipInputBorderBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="badgeText" Text="{Binding BadgeText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ==== бейдж целей, компактный ====
             Вариант для canvas. Та же пилюля, те же тона, только число: коробка в 210px и так
             несёт глиф семейства и подпись типа, а полное «7 окон · кроме Лучник, Шаман»
             вытесняет подпись из шапки целиком — а это обходится дороже, чем даёт, ведь именно
             подпись говорит, ЧТО нода делает. Теги — в подсказке и в бейдже инспектора, в одном
             клике отсюда. -->
        <DataTemplate x:Key="TargetBadgeCompactTemplate" x:DataType="nodes:TargetSelectorViewModel">
            <Border Classes="targetBadge"
                    Classes.accent="{Binding BadgeIsAccent}"
                    Classes.danger="{Binding BadgeIsDanger}"
                    Padding="6,1"
                    ToolTip.Tip="{Binding BadgeText}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5"
                             VerticalAlignment="Center"
                             IsVisible="{Binding ShowsHollowDot}"
                             Stroke="{DynamicResource NocturneNeutral600Brush}"
                             StrokeThickness="1" />
                    <Ellipse Width="5" Height="5"
                             VerticalAlignment="Center"
                             IsVisible="{Binding ShowsDangerDot}"
                             Fill="{DynamicResource NocturneDangerBrush}" />
                    <ItemsControl VerticalAlignment="Center"
                                  IsVisible="{Binding ShowsBars}"
                                  ItemsSource="{Binding Bars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1.5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:Boolean">
                                <Border Width="3" Height="9" CornerRadius="1"
                                        Background="{Binding ., Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccentBrush|NocturneChipInputBorderBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="badgeText" FontSize="9.5" Text="{Binding BadgeCountText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- один тег require/exclude, снимаемый. Объявлен РАНЬШЕ popup, который его использует:
             StaticResource внутри ResourceDictionary разрешается по тому, что уже объявлено
             выше. -->
        <DataTemplate x:Key="SelectorTagChipTemplate" x:DataType="nodes:SelectorTagChipViewModel">
            <Border Height="18"
                    Margin="0,0,4,2"
                    Padding="7,0,4,0"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource NocturneWarningBorderBrush}"
                    Background="{DynamicResource NocturneWarningSurfaceBrush}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="{DynamicResource NocturneFontSizeMicro}"
                               Foreground="{DynamicResource NocturneWarningBrush}"
                               Text="{Binding Text}" />
                    <Button Classes="ghost"
                            Content="✕"
                            FontSize="8"
                            Padding="2,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Targets_RemoveTag}"
                            Click="OnRemoveSelectorTagClicked" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- одно окно в развёрнутом бейдже -->
        <DataTemplate x:Key="TargetWindowChipTemplate" x:DataType="nodes:TargetWindowChip">
            <Border Classes="windowChip"
                    Classes.missed="{Binding IsExcluded}"
                    Margin="0,0,4,4">
                <TextBlock VerticalAlignment="Center"
                           FontSize="9.5"
                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                           TextDecorations="{Binding IsExcluded, Converter={x:Static conv:StrikethroughConverter.Instance}}"
                           Foreground="{Binding IsExcluded, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneTextFaintBrush|NocturneChipTextSoftBrush}"
                           Text="{Binding Label}" />
            </Border>
        </DataTemplate>

        <!-- ==== бейдж целей, развёрнутый ====
             Клик открывает popup: тот же селектор, но как редактор ЧИПОВ тегов (моделью
             по-прежнему остаются поля с запятыми, а это лишь приветливое их лицо), а под ним —
             живой состав: кого задело, кто вычеркнут, у скольких окон вообще нет тегов, по
             которым можно было бы маршрутизировать. -->
        <DataTemplate x:Key="TargetBadgeButtonTemplate" x:DataType="nodes:TargetSelectorViewModel">
            <Button Classes="ghost"
                    Padding="0"
                    HorizontalAlignment="Left"
                    ToolTip.Tip="{x:Static res:Strings.Editor_Targets_BadgeTip}">
                <Button.Flyout>
                    <!-- Выровнено по правому краю, а не по центру: бейдж стоит у правой кромки
                         308-пиксельного инспектора, и popup шириной 322px, размещённый снизу,
                         там попросту обрезается — Avalonia держит именно этот как наложение
                         внутри окна, так что на рабочий стол он, в отличие от платформенного
                         popup, не вылезет. -->
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="322">

                            <!-- контекст против тегов: те две вещи, которые значат «селектор
                                 null» и «селектор пустой» и которых никакая пара полей тегов
                                 не выразит. -->
                            <StackPanel Margin="10,8" Spacing="7">
                                <Grid ColumnDefinitions="*,*">
                                    <!-- Отступы, а не фиксированная Height: вертикальная
                                         вставка 11.2px из темы Button плюс коробка в 24px
                                         оставляют меньше места, чем нужно строке в 11px, и у
                                         букв сбривает выносные элементы. -->
                                    <Button Grid.Column="0"
                                            Content="{x:Static res:Strings.Editor_Targets_ModeContext}"
                                            Padding="8,3"
                                            Margin="0,0,3,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Classes.accent="{Binding !UseSelector}"
                                            Click="OnTargetContextClicked" />
                                    <Button Grid.Column="1"
                                            Content="{x:Static res:Strings.Editor_Targets_ModeTags}"
                                            Padding="8,3"
                                            Margin="3,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Classes.accent="{Binding UseSelector}"
                                            Click="OnTargetTagsClicked" />
                                </Grid>

                                <Grid ColumnDefinitions="60,*" IsVisible="{Binding UseSelector}">
                                    <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Top" Margin="0,5,0,0" Text="{x:Static res:Strings.Node_Target_Require}" />
                                    <Border Grid.Column="1"
                                            MinHeight="26"
                                            Padding="6,3"
                                            CornerRadius="{DynamicResource NocturneRadiusSm}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                                            Background="{DynamicResource NocturneFieldBackgroundBrush}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding RequireChips}"
                                                          ItemTemplate="{StaticResource SelectorTagChipTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <TextBox BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0"
                                                     MinHeight="18"
                                                     FontSize="{DynamicResource NocturneFontSizeMicro}"
                                                     Watermark="{x:Static res:Strings.Editor_Targets_AddTagWatermark}"
                                                     Text="{Binding NewRequireTag, Mode=TwoWay}"
                                                     KeyDown="OnRequireTagKeyDown" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="60,*" IsVisible="{Binding UseSelector}">
                                    <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Top" Margin="0,5,0,0" Text="{x:Static res:Strings.Node_Target_Exclude}" />
                                    <Border Grid.Column="1"
                                            MinHeight="26"
                                            Padding="6,3"
                                            CornerRadius="{DynamicResource NocturneRadiusSm}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource NocturneChipInputBorderBrush}"
                                            Background="{DynamicResource NocturneFieldBackgroundBrush}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding ExcludeChips}"
                                                          ItemTemplate="{StaticResource SelectorTagChipTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <TextBox BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0"
                                                     MinHeight="18"
                                                     FontSize="{DynamicResource NocturneFontSizeMicro}"
                                                     Watermark="{x:Static res:Strings.Editor_Targets_AddTagWatermark}"
                                                     Text="{Binding NewExcludeTag, Mode=TwoWay}"
                                                     KeyDown="OnExcludeTagKeyDown" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Classes="hint"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !UseSelector}"
                                           Text="{x:Static res:Strings.Editor_Targets_EmptyHint}" />
                            </StackPanel>

                            <!-- Состав. Только при маршрутизации по тегам: в режиме контекста
                                 селектор целится ровно в одно окно — то, из которого пришёл
                                 прогон, — и список из восьми перечёркнутых имён под «0 из 8»
                                 говорил бы прямо обратное тому, что происходит на деле. -->
                            <Border BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                                    Background="{DynamicResource NocturneBgBrush}"
                                    IsVisible="{Binding UseSelector}"
                                    Padding="10,7">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Classes="eyebrow" Text="{x:Static res:Strings.Editor_Targets_HitsHeader}" />
                                        <TextBlock FontSize="{DynamicResource NocturneFontSizeMicro}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                   Foreground="{DynamicResource NocturneAccent400Brush}"
                                                   Text="{Binding HitText}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HitWindows}"
                                                  ItemTemplate="{StaticResource TargetWindowChipTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Classes="windowChip" IsVisible="{Binding HasMore}">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="9.5"
                                                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                       Foreground="{DynamicResource NocturneChipTextSoftBrush}"
                                                       Text="{Binding MoreText}" />
                                        </Border>
                                        <Border Classes="windowChip missed" IsVisible="{Binding HasUntagged}">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="9.5"
                                                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                       Foreground="{DynamicResource NocturneTextFaintBrush}"
                                                       Text="{Binding UntaggedText}" />
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding MissedWindows}"
                                                  ItemTemplate="{StaticResource TargetWindowChipTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TargetBadgeTemplate}" />
            </Button>
        </DataTemplate>

        <!-- ==== одна строка исхода на СВЁРНУТОЙ коробке: подпись + точка порта ==== -->
        <DataTemplate x:Key="OutcomePortTemplate" x:DataType="nodes:NodeEdgeViewModel">
            <Grid ColumnDefinitions="*,Auto" Height="15">
                <TextBlock Grid.Column="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="9.5"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding IsEnd, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneTextFaintBrush|NocturneAccent400Brush}"
                           Text="{Binding BoxLabel}" />
                <Border Grid.Column="1"
                        Classes="port"
                        Classes.loose="{Binding IsEnd}"
                        ToolTip.Tip="{x:Static res:Strings.Editor_Canvas_PortTip}"
                        PointerPressed="OnPortPressed" />
            </Grid>
        </DataTemplate>

        <!-- ==== один исход как РЕДАКТОР: подпись + выпадающий список id нод ==== -->
        <DataTemplate x:Key="EdgeEditorTemplate" x:DataType="nodes:NodeEdgeViewModel">
            <!-- 82px, а не 64, как у строк параметров: «не распознано» — самое длинное имя
                 исхода в каталоге, а урезанное читается уже другим словом. -->
            <Grid ColumnDefinitions="82,*" Margin="0,0,0,5.6">
                <TextBlock Grid.Column="0" Classes="label" Text="{Binding ShortLabel}" />
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding Target, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="nodes:NodeChoiceViewModel">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </DataTemplate>

        <!-- ==== коробка ноды ==== -->
        <DataTemplate x:Key="NodeBoxTemplate" x:DataType="nodes:NodeRowViewModel">
            <Border Classes="node"
                    Classes.selected="{Binding IsSelected}"
                    Classes.passed="{Binding IsPassed}"
                    Classes.running="{Binding IsExecuting}"
                    Classes.paused="{Binding IsPaused}"
                    Classes.varSource="{Binding IsVariableSource}"
                    Classes.varConsumer="{Binding IsVariableConsumer}"
                    Classes.marked="{Binding IsMarked}"
                    Width="{Binding BoxWidth}"
                    Height="{Binding BoxHeight}"
                    PointerPressed="OnNodePressed"
                    DoubleTapped="OnNodeDoubleTapped">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- шапка: глиф семейства, тип, чип целей -->
                    <Border Grid.Row="0"
                            Classes="nodeHeader"
                            Classes.conditional="{Binding IsConditional}"
                            Classes.running="{Binding IsExecuting}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0"
                                    Width="7" Height="7"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource NocturneTextFaintBrush}"
                                    IsVisible="{Binding !IsConditional}" />
                            <Border Grid.Column="0"
                                    Width="7" Height="7"
                                    VerticalAlignment="Center"
                                    RenderTransform="rotate(45deg)"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource NocturneAccentBrush}"
                                    Background="{DynamicResource NocturneAccentTint22Brush}"
                                    IsVisible="{Binding IsConditional}" />
                            <TextBlock Grid.Column="1"
                                       Margin="6,0,0,0"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding IsConditional, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneChipTextSoftBrush|NocturneNeutral300Brush}"
                                       Text="{Binding TypeLabel}" />
                            <!-- Живой бейдж целей (1g), компактный. Только для нод, которые
                                 маршрутизируют по ТЕГАМ: «действует на контекстное окно» —
                                 умолчание, которое есть у каждой второй ноды, и слова
                                 заслуживает отступление от него. Здесь он только показывает;
                                 кликабельная разворачивающаяся копия — в инспекторе, который
                                 не лежит внутри canvas'ного transform из масштаба и сдвига
                                 (Popup над таким приземляется туда, где transform уже не
                                 действует). -->
                            <ContentControl Grid.Column="2"
                                            Margin="6,0,0,0"
                                            IsVisible="{Binding ShowsTargetChip}"
                                            Content="{Binding Target}"
                                            ContentTemplate="{StaticResource TargetBadgeCompactTemplate}" />
                            <!-- Пока за обходом следят, штамп прогона занимает место чипа
                                 целей: ✓ со временем у пройденной ноды, ▸ у живой. Слот тот же
                                 намеренно — шапка шириной 210px, и вытеснять из неё нельзя
                                 именно подпись типа. -->
                            <TextBlock Grid.Column="2"
                                       Margin="6,0,0,0"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsPassed}"
                                       ToolTip.Tip="{Binding PassedOutcome}"
                                       Foreground="{DynamicResource NocturneAccentBrush}"
                                       Text="{Binding PassedTime, StringFormat='✓ {0}'}" />
                            <TextBlock Grid.Column="2"
                                       Margin="6,0,0,0"
                                       FontSize="10"
                                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsPaused}"
                                       Foreground="{DynamicResource NocturneDangerBrush}"
                                       Text="&#x25A0;" />
                        </Grid>
                    </Border>

                    <!-- свёрнутое тело: id и та единственная строка, что говорит, чем нода занята -->
                    <StackPanel Grid.Row="1" Margin="7,3,7,0" IsVisible="{Binding !IsExpanded}">
                        <TextBlock FontSize="9.5"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneTextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,1,0,0"
                                   FontSize="10.5"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneNeutral300Brush}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasSummary}"
                                   Text="{Binding Summary}" />
                        <Border Classes="keycap"
                                Margin="0,1,0,0"
                                IsVisible="{Binding Keycap, Converter={x:Static conv:NotNullToBoolConverter.Instance}}">
                            <TextBlock FontSize="10"
                                       FontWeight="Medium"
                                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                       VerticalAlignment="Center"
                                       Text="{Binding Keycap}" />
                        </Border>
                    </StackPanel>

                    <!-- развёрнутое тело (1e): коробка становится редактором самой себя -->
                    <StackPanel Grid.Row="1" Margin="9,8,9,4" Spacing="5.6" IsVisible="{Binding IsExpanded}">
                        <Grid ColumnDefinitions="64,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Name}" />
                            <TextBox Grid.Column="1"
                                     Classes="mono"
                                     Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <ContentControl Content="{Binding}" />
                        <ContentControl Content="{Binding Target}" IsVisible="{Binding HasTarget}" />
                    </StackPanel>

                    <!-- исходы: строки портов в свёрнутом виде, выпадающие списки в развёрнутом -->
                    <ItemsControl Grid.Row="2"
                                  Margin="0,0,0,4"
                                  IsVisible="{Binding !IsExpanded}"
                                  ItemsSource="{Binding Edges}"
                                  ItemTemplate="{StaticResource OutcomePortTemplate}" />
                    <Border Grid.Row="2"
                            Padding="9,6,9,4"
                            IsVisible="{Binding IsExpanded}"
                            Background="{DynamicResource NocturneSurfaceRowAltBrush}"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource NocturneDividerStrongBrush}">
                        <ItemsControl ItemsSource="{Binding Edges}"
                                      ItemTemplate="{StaticResource EdgeEditorTemplate}" />
                    </Border>

                    <!-- Тянется на все строки, чтобы полоса шла во всю высоту коробки. В Grid
                         идёт последней, поэтому закрашивает и фон шапки. -->
                    <Border Grid.Row="0" Grid.RowSpan="3"
                            Classes="breakpointBar"
                            IsVisible="{Binding HasBreakpoint}"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Canvas_BreakpointTip}" />

                    <!-- Только пока обход действительно исполняет эту ноду: ПРИПАРКОВАННОМУ
                         достаётся вместо этого статичная тревожная кромка, потому что
                         «остановлено здесь» и «идёт здесь» не имеют права делить анимацию. -->
                    <Border Grid.Row="0" Grid.RowSpan="3"
                            Classes="pulseRing"
                            Classes.pulsing="{Binding IsRunningLive}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Кнопка вырезки шаблона со свежего снимка (issue #29).

             КЛЮЧЕВОЙ шаблон в ресурсах, а не DataTemplate по типу
             ConditionalNodeRowViewModel ниже: тот матчился бы и на три конкретных наследника, а
             поиск шаблона линеен — побеждает первый подошедший, и общий предок погасил бы все три
             блока параметров разом (x:Key в UserControl.DataTemplates к тому же не принимается).

             И не внутри шаблона RegionEditorViewModel: область есть у нод, у которых шаблона нет
             вовсе, а DataContext там — сама область, где о ноде ничего не известно.

             Стоит НАД четырьмя полями области: заполняет она именно их (плюс имя шаблона), и
             место ей там, куда посмотрят за результатом. -->
        <DataTemplate x:Key="RegionCaptureButton"
                      DataType="{x:Type nodes:ConditionalNodeRowViewModel}"
                      x:DataType="nodes:ConditionalNodeRowViewModel">
            <Button Classes="ghost"
                    HorizontalAlignment="Left"
                    Margin="64,0,0,0"
                    Padding="0"
                    MinWidth="0"
                    FontSize="{DynamicResource NocturneFontSizeMicro}"
                    Content="{x:Static res:Strings.Editor_Region_Capture}"
                    ToolTip.Tip="{x:Static res:Strings.Editor_Region_CaptureTip}"
                    Click="OnCaptureRegionClicked" />
        </DataTemplate>

        <!-- Та же кнопка для ноды клика, только берёт со снимка одну ТОЧКУ. Видна лишь при
             буквальных X/Y: у переменной координат нет, и подставлять их туда нечего. Прежний
             способ добыть координату (навести курсор, запустить макрос, прочитать в журнале, чем
             засеялся cursor) остаётся — он про живую точку во время прогона. -->
        <DataTemplate x:Key="PointPickButton"
                      DataType="{x:Type nodes:ClickNodeRowViewModel}"
                      x:DataType="nodes:ClickNodeRowViewModel">
            <Button Classes="ghost"
                    HorizontalAlignment="Left"
                    Margin="64,0,0,0"
                    Padding="0"
                    MinWidth="0"
                    IsVisible="{Binding UseLiteralPoint}"
                    FontSize="{DynamicResource NocturneFontSizeMicro}"
                    Content="{x:Static res:Strings.Editor_Point_Pick}"
                    ToolTip.Tip="{x:Static res:Strings.Editor_Point_PickTip}"
                    Click="OnPickPointClicked" />
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataTemplates>

        <!-- ==== общие редакторы: их используют И инспектор, И развёрнутая коробка ==== -->

        <DataTemplate DataType="{x:Type nodes:TargetSelectorViewModel}" x:DataType="nodes:TargetSelectorViewModel">
            <StackPanel Spacing="2.8">
                <CheckBox Content="{x:Static res:Strings.Node_Target_UseSelector}"
                          IsChecked="{Binding UseSelector, Mode=TwoWay}" />
                <Grid ColumnDefinitions="64,*" IsVisible="{Binding UseSelector}" Margin="0,2.8,0,0">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Target_Require}" />
                    <TextBox Grid.Column="1" Watermark="{x:Static res:Strings.Node_Target_TagsWatermark}" Text="{Binding RequireText, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="64,*" IsVisible="{Binding UseSelector}">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Target_Exclude}" />
                    <TextBox Grid.Column="1" Watermark="{x:Static res:Strings.Node_Target_TagsWatermark}" Text="{Binding ExcludeText, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:RegionEditorViewModel}" x:DataType="nodes:RegionEditorViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Region}" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,*,*,*">
                        <TextBox Grid.Column="0" Classes="numeric" Margin="0,0,2,0" Text="{Binding XText, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Classes="numeric" Margin="2,0" Text="{Binding YText, Mode=TwoWay}" />
                        <TextBox Grid.Column="2" Classes="numeric" Margin="2,0" Text="{Binding WidthText, Mode=TwoWay}" />
                        <TextBox Grid.Column="3" Classes="numeric" Margin="2,0,0,0" Text="{Binding HeightText, Mode=TwoWay}" />
                    </Grid>
                </Grid>
                <Grid ColumnDefinitions="64,*" Margin="0,1,0,0">
                    <Grid Grid.Column="1" ColumnDefinitions="*,*,*,*">
                        <TextBlock Grid.Column="0" Classes="hint" HorizontalAlignment="Center" Text="X" />
                        <TextBlock Grid.Column="1" Classes="hint" HorizontalAlignment="Center" Text="Y" />
                        <TextBlock Grid.Column="2" Classes="hint" HorizontalAlignment="Center" Text="{x:Static res:Strings.Node_Field_RegionWidth}" />
                        <TextBlock Grid.Column="3" Classes="hint" HorizontalAlignment="Center" Text="{x:Static res:Strings.Node_Field_RegionHeight}" />
                    </Grid>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- ==== блоки параметров нод (по одному на тип ноды) ==== -->

        <DataTemplate DataType="{x:Type nodes:KeyPressNodeRowViewModel}" x:DataType="nodes:KeyPressNodeRowViewModel">
            <Grid ColumnDefinitions="64,*">
                <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Key}" />
                <controls:KeyBindingPicker Grid.Column="1"
                                           HorizontalAlignment="Stretch"
                                           CaptureModifiers="False"
                                           Key="{Binding KeyName, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:ClickNodeRowViewModel}" x:DataType="nodes:ClickNodeRowViewModel">
            <StackPanel Spacing="5.6">
                <Grid ColumnDefinitions="64,*" IsVisible="{Binding UseLiteralPoint}">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Point}" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,*">
                        <TextBox Grid.Column="0" Classes="numeric" Margin="0,0,2,0" Text="{Binding XText, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Classes="numeric" Margin="2,0,0,0" Text="{Binding YText, Mode=TwoWay}" />
                    </Grid>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PointPickButton}" />
                <Grid ColumnDefinitions="64,*" IsVisible="{Binding UseVariable}">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_PointVar}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="cursor" Text="{Binding PointVar, Mode=TwoWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="11.2">
                    <CheckBox Content="{x:Static res:Strings.Node_Click_UseVariable}" IsChecked="{Binding UseVariable, Mode=TwoWay}" />
                    <CheckBox Content="{x:Static res:Strings.Node_Click_Double}" IsChecked="{Binding DoubleClick, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:DelayNodeRowViewModel}" x:DataType="nodes:DelayNodeRowViewModel">
            <StackPanel Spacing="2.8">
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Delay}" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Classes="mono" Text="{Binding SecondsText, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Classes="hint" Margin="5.6,0,0,0" Text="{x:Static res:Strings.Node_Field_Seconds}" />
                    </Grid>
                </Grid>
                <TextBlock Classes="hint" Text="{x:Static res:Strings.Node_Delay_Hint}" Margin="64,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:TagNodeRowViewModel}" x:DataType="nodes:TagNodeRowViewModel">
            <Grid ColumnDefinitions="64,*">
                <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Tag}" />
                <TextBox Grid.Column="1" Watermark="{x:Static res:Strings.Node_Tag_Watermark}" Text="{Binding Tag, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:SetIconNodeRowViewModel}" x:DataType="nodes:SetIconNodeRowViewModel">
            <Grid ColumnDefinitions="64,*">
                <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Icon}" />
                <TextBox Grid.Column="1"
                         Classes="mono"
                         Watermark="Assets/ClassIcons/{tag}.png"
                         Text="{Binding IconPath, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:RunSubmacroNodeRowViewModel}" x:DataType="nodes:RunSubmacroNodeRowViewModel">
            <StackPanel Spacing="5.6">
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Submacro}" />
                    <ComboBox Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding SubmacroChoices}"
                              SelectedItem="{Binding Submacro, Mode=TwoWay}" />
                </Grid>
                <CheckBox Content="{x:Static res:Strings.Node_Submacro_Await}" IsChecked="{Binding Await, Mode=TwoWay}" Margin="64,0,0,0" />
                <!-- Переменные подпрогону достаются КОПИЕЙ, и обратно ничего не возвращается.
                     Сказано здесь, а не только предупреждением валидатора: предупреждение
                     появляется, когда ловушка уже сработала, а эта строка стоит там, где
                     пользователь выбирает функцию. -->
                <TextBlock Classes="hint"
                           Margin="64,0,0,0"
                           TextWrapping="Wrap"
                           Text="{x:Static res:Strings.Node_Submacro_VariablesHint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:FindElementNodeRowViewModel}" x:DataType="nodes:FindElementNodeRowViewModel">
            <StackPanel Spacing="5.6">
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Template}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="{x:Static res:Strings.Node_Template_Watermark}" Text="{Binding Template, Mode=TwoWay}" />
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RegionCaptureButton}" />
                <ContentControl Content="{Binding Region}" />
                <TextBlock Classes="hint" Text="{x:Static res:Strings.Node_Find_RegionHint}" Margin="64,0,0,0" />
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Threshold}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="{x:Static res:Strings.Node_Threshold_Watermark}" Text="{Binding MatchThresholdText, Mode=TwoWay}" />
                </Grid>
                <TextBlock Classes="hint" Text="{x:Static res:Strings.Node_Threshold_Hint}" Margin="64,0,0,0" />
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_FoundPointVar}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="{x:Static res:Strings.Node_FoundPointVar_Watermark}" Text="{Binding FoundPointVar, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:WaitForElementNodeRowViewModel}" x:DataType="nodes:WaitForElementNodeRowViewModel">
            <StackPanel Spacing="5.6">
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Template}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="{x:Static res:Strings.Node_Template_Watermark}" Text="{Binding Template, Mode=TwoWay}" />
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RegionCaptureButton}" />
                <ContentControl Content="{Binding Region}" />
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Timeout}" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Classes="mono" Text="{Binding TimeoutMsText, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Classes="hint" Margin="5.6,0,0,0" Text="{x:Static res:Strings.Node_Field_Milliseconds}" />
                    </Grid>
                </Grid>
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Threshold}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="{x:Static res:Strings.Node_Threshold_Watermark}" Text="{Binding MatchThresholdText, Mode=TwoWay}" />
                </Grid>
                <TextBlock Classes="hint" Text="{x:Static res:Strings.Node_Threshold_Hint}" Margin="64,0,0,0" />
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_FoundPointVar}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="{x:Static res:Strings.Node_FoundPointVar_Watermark}" Text="{Binding FoundPointVar, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:MatchTemplateSetNodeRowViewModel}" x:DataType="nodes:MatchTemplateSetNodeRowViewModel">
            <StackPanel Spacing="5.6">
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label"
                               Text="{x:Static res:Strings.Node_Field_TemplateSet}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="classes" Text="{Binding TemplateSet, Mode=TwoWay}" />
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RegionCaptureButton}" />
                <ContentControl Content="{Binding Region}" />
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Threshold}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="{x:Static res:Strings.Node_Threshold_Watermark}" Text="{Binding MatchThresholdText, Mode=TwoWay}" />
                </Grid>
                <TextBlock Classes="hint" Text="{x:Static res:Strings.Node_Threshold_Hint}" Margin="64,0,0,0" />
                <Grid ColumnDefinitions="64,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_ResultVar}" />
                    <TextBox Grid.Column="1" Classes="mono" Watermark="tag" Text="{Binding ResultVar, Mode=TwoWay}" />
                </Grid>
                <!-- Галочки «вешать тег на окно» здесь больше нет: нода отдаёт значение, а окно
                     размечает отдельная нода «Добавить тег» с подстановкой {переменной}. Подсказка
                     говорит и это, и то, что промах переменную не трогает. -->
                <TextBlock Classes="hint"
                           Margin="64,0,0,0"
                           TextWrapping="Wrap"
                           Text="{x:Static res:Strings.Node_MatchSet_ResultHint}" />
            </StackPanel>
        </DataTemplate>

        <!-- ==== строки триггеров ==== -->

        <!-- Ловушка хоткея, макет 1f. Четыре состояния несёт сама ловушка; СНАРУЖИ ей место
             только двум строкам подсказки под взведённым состоянием — как выйти из ловли и то,
             что глобальные хоткеи демона лежат, пока открыт этот режим. Обе привязаны к
             собственному IsCapturing ловушки, поэтому появляются ровно тогда, когда верны. -->
        <DataTemplate DataType="{x:Type nodes:HotkeyTriggerRowViewModel}" x:DataType="nodes:HotkeyTriggerRowViewModel">
            <StackPanel Margin="0,0,0,5.6">
                <Grid ColumnDefinitions="*,Auto">
                    <controls:KeyBindingPicker Grid.Column="0"
                                               x:Name="Picker"
                                               HorizontalAlignment="Stretch"
                                               CaptureModifiers="True"
                                               Conflict="{Binding Conflict}"
                                               Key="{Binding KeyName, Mode=TwoWay}"
                                               Modifiers="{Binding Modifiers, Mode=TwoWay}"
                                               MouseButton="{Binding MouseButton, Mode=TwoWay}" />
                    <Button Grid.Column="1"
                            Content="✕"
                            Classes="ghost"
                            FontSize="10"
                            Width="24"
                            Height="24"
                            Margin="5.6,0,0,0"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Triggers_RemoveHotkey}"
                            Click="OnRemoveTriggerClicked" />
                </Grid>
                <StackPanel Margin="0,4,0,0" Spacing="2" IsVisible="{Binding #Picker.IsCapturing}">
                    <TextBlock Classes="hint"
                               TextWrapping="Wrap"
                               Text="{x:Static res:Strings.Editor_Triggers_CaptureHint}" />
                    <!-- Grid, а не горизонтальный StackPanel: StackPanel меряет детей с
                         бесконечной шириной, поэтому TextWrapping не срабатывает никогда, и
                         строка просто обрезается по краю панели. -->
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- U+25B2, а НЕ U+26A0 ⚠: у знака предупреждения есть
                             эмодзи-представление, поэтому Windows подаёт его из Segoe UI Emoji
                             полноцветной картинкой, начисто игнорирующей Foreground, — та же
                             ловушка, на которую D1 напоролась с U+25B6. -->
                        <TextBlock Grid.Column="0"
                                   FontSize="9"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource NocturneWarningBrush}"
                                   Text="&#x25B2;" />
                        <TextBlock Grid.Column="1"
                                   FontSize="{DynamicResource NocturneFontSizeMicro}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource NocturneWarningBrush}"
                                   Text="{x:Static res:Strings.Editor_Triggers_SuspendedHint}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type nodes:ProcessTriggerRowViewModel}" x:DataType="nodes:ProcessTriggerRowViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2.8">
                <TextBox Grid.Column="0"
                         Classes="mono"
                         Watermark="elementclient_64"
                         Text="{Binding ProcessName, Mode=TwoWay}" />
                <Button Grid.Column="1"
                        Content="×"
                        Classes="ghost"
                        Margin="5.6,0,0,0"
                        ToolTip.Tip="{x:Static res:Strings.Editor_Triggers_RemoveProcess}"
                        Click="OnRemoveTriggerClicked" />
            </Grid>
        </DataTemplate>

        <!-- ==== замечание валидатора ==== -->

        <DataTemplate DataType="{x:Type vm:ValidationIssueViewModel}" x:DataType="vm:ValidationIssueViewModel">
            <Button Classes="ghost"
                    Padding="2.8,1.4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OnIssueClicked">
                <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                           TextWrapping="Wrap"
                           Foreground="{Binding IsError, Converter={x:Static conv:IssueSeverityToBrushConverter.Instance}}"
                           Text="{Binding Display}" />
            </Button>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,*">

        <!-- ======================= панель инструментов ======================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource NocturneDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
                <!-- Padding + VerticalContentAlignment вместе с жёсткой Height — см. ловушку у
                     темы TextBox в Themes/Controls.axaml: без них отступ темы оставлял под
                     строку меньше, чем она занимает, и хвосты «р»/«у»/«д» в имени макроса
                     срезались по базовой линии. -->
                <!-- Хлебные крошки «макрос ▸ функция» (F4). Когда на канве под-макрос, имя
                     МАКРОСА становится кнопкой возврата, а правится подпись функции: имя макроса
                     — это имя файла, и позволить переписать его жестом, который выглядит как
                     переименование функции, нельзя. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Enter / уход фокуса ПЕРЕИМЕНОВЫВАЮТ файл, Esc отменяет набранное.
                         Автосохранение сюда не смотрит: оно пишет в загруженное имя, иначе
                         каждое нажатие клавиши здесь заводило бы новый .hsm. Пока набранное
                         расходится с именем файла, об этом говорит подпись состояния записи
                         посреди полосы. -->
                    <TextBox Width="170"
                             Height="26"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             FontWeight="Medium"
                             FontSize="{DynamicResource NocturneFontSizeBody}"
                             IsVisible="{Binding !IsSubmacroOpen}"
                             IsEnabled="{Binding HasOpenMacro}"
                             ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_MacroNameTip}"
                             Text="{Binding MacroName, Mode=TwoWay}"
                             KeyDown="OnMacroNameKeyDown"
                             LostFocus="OnMacroNameLostFocus" />

                    <Button Classes="ghost"
                            Height="26"
                            Padding="6,0"
                            FontSize="{DynamicResource NocturneFontSizeSmall}"
                            IsVisible="{Binding IsSubmacroOpen}"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_BackToMacroTip}"
                            Content="{Binding MacroName}"
                            Click="OnOpenParentGraphClicked" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{DynamicResource NocturneTextMutedBrush}"
                               IsVisible="{Binding IsSubmacroOpen}"
                               Text="&#x25B8;" />
                    <TextBox Width="140"
                             Height="26"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             FontWeight="Medium"
                             FontSize="{DynamicResource NocturneFontSizeBody}"
                             IsVisible="{Binding IsSubmacroOpen}"
                             ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_SubmacroNameTip}"
                             Text="{Binding SubmacroName, Mode=TwoWay}" />
                </StackPanel>

                <Border Grid.Column="1" Width="1" Height="18" Margin="10,0"
                        Background="{DynamicResource NocturneDividerStrongBrush}" />

                <TextBlock Grid.Column="2" Classes="label" Text="{x:Static res:Strings.Editor_Toolbar_StartNode}" Margin="0,0,5.6,0" />
                <ComboBox Grid.Column="3"
                          MinWidth="150"
                          IsEnabled="{Binding HasOpenMacro}"
                          ItemsSource="{Binding StartNodeChoices}"
                          SelectedItem="{Binding StartNode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="nodes:NodeChoiceViewModel">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                    <Button x:Name="AddNodeButton"
                            Content="{x:Static res:Strings.Editor_Toolbar_AddNode}"
                            Height="26"
                            IsEnabled="{Binding HasOpenMacro}">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ItemsControl ItemsSource="{Binding NodeKinds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="nodes:MacroNodeKindOption">
                                            <Button Content="{Binding Label}"
                                                    Classes="ghost"
                                                    Padding="{DynamicResource NocturneInsetField}"
                                                    MinWidth="180"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="OnAddNodeClicked" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Функция заводится ЗДЕСЬ, а не в подвале библиотеки: там кнопки отвечают
                         на вопрос «откуда в библиотеке берётся МАКРОС», а под-макрос берётся из
                         того макроса, который открыт. Гаснет внутри функции — под-макросы
                         плоские. -->
                    <Button Content="{x:Static res:Strings.Editor_Toolbar_AddSubmacro}"
                            Height="26"
                            IsEnabled="{Binding ShowsTriggers}"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_AddSubmacroTip}"
                            Click="OnAddSubmacroClicked" />

                    <!-- Появляется только когда есть что извлекать: кнопка, которая почти всегда
                         мертва, отучает читать панель инструментов. -->
                    <Button Content="{Binding ExtractLabel}"
                            Classes="accent"
                            Height="26"
                            IsVisible="{Binding CanExtractSubmacro}"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_ExtractTip}"
                            Click="OnExtractSubmacroClicked" />
                </StackPanel>

                <!-- ==== отладчик (D5) ====
                     Появляется, только когда обход этого графа уже зафиксирован: четыре
                     навсегда мёртвые кнопки — верный способ добиться, чтобы панель инструментов
                     перестали читать. Макет кладёт счётчик прогресса внутрь чипа прогона; здесь
                     он стоит рядом с теми кнопками, к которым относится, а ПЕРЕКЛЮЧАТЕЛЬ
                     ОБХОДОВ остаётся в полосе лога ниже, со стрелками ◂ ▸, — два разных числа,
                     каждое рядом с тем, что считает. -->
                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            IsVisible="{Binding HasDebugTarget}">
                    <Border Width="1" Height="18" Margin="0,0,6,0"
                            Background="{DynamicResource NocturneDividerStrongBrush}" />

                    <!-- «Пауза» и «Дальше» делят один слот: это взаимоисключающие состояния
                         одного обхода, а в панели инструментов шириной 1520px нет места для
                         навсегда мёртвого близнеца. Глифы ⏸ / ⤼ / ▷| из макета НЕ используются:
                         U+23F8 несёт Emoji_Presentation и приехал бы цветной картинкой,
                         игнорирующей Foreground, — та же ловушка, на которую D1 напоролась с
                         U+25B6, а D4 с U+26A0. Проверено, что текстом рисуются U+25B8 и
                         U+25A0, — их и взяли. -->
                    <Button Height="26"
                            Content="{x:Static res:Strings.Editor_Debug_Pause}"
                            IsVisible="{Binding !SelectedRunIsPaused}"
                            IsEnabled="{Binding CanPause}"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Debug_PauseTip}"
                            Click="OnDebugPauseClicked" />
                    <Button Height="26"
                            Classes="accent"
                            Content="{x:Static res:Strings.Editor_Debug_Resume}"
                            IsVisible="{Binding SelectedRunIsPaused}"
                            IsEnabled="{Binding CanResume}"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Debug_ResumeTip}"
                            Click="OnDebugResumeClicked" />
                    <Button Height="26"
                            Content="{x:Static res:Strings.Editor_Debug_Step}"
                            IsEnabled="{Binding CanResume}"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Debug_StepTip}"
                            Click="OnDebugStepClicked" />
                    <Button Height="26"
                            Content="{x:Static res:Strings.Editor_Debug_RunToCursor}"
                            IsEnabled="{Binding CanRunToCursor}"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Debug_RunToCursorTip}"
                            Click="OnDebugRunToCursorClicked" />
                    <Button Height="26"
                            Classes="danger"
                            Content="{Binding StopLabel}"
                            IsEnabled="{Binding CanStop}"
                            ToolTip.Tip="{Binding StopTooltip}"
                            Click="OnDebugStopClicked" />

                    <!-- Только счётчик и часы. ЛИЧНОСТЬ обхода и причина его паузы живут в шапке
                         полосы лога, рядом с ◂ ▸, которыми его и выбирают, — напечатать их
                         дважды стоило 260px и вытолкнуло «Сохранить» за край окна, а это ровно
                         та кнопка, к которой тянешься после сеанса отладки. -->
                    <Border Height="26"
                            Margin="6,0,0,0"
                            Padding="8,0"
                            CornerRadius="{DynamicResource NocturneRadiusSm}"
                            Background="{DynamicResource NocturneSurfaceInsetBrush}"
                            BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                            BorderThickness="1"
                            ToolTip.Tip="{x:Static res:Strings.Editor_Debug_ProgressTip}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock FontSize="10.5"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                       Text="{Binding RunProgressText}" />
                            <TextBlock FontSize="10.5"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                       Foreground="{DynamicResource NocturneTextFaintBrush}"
                                       Text="{Binding RunElapsedText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Обратная связь живёт посреди полосы: она про макрос целиком, а не про то,
                     что инспектор случайно показывает прямо сейчас. -->
                <StackPanel Grid.Column="6" Margin="14,0" VerticalAlignment="Center" Spacing="1">
                    <!-- Подпись СОСТОЯНИЯ записи: «сохранено» / «правки ещё не записаны» /
                         «Enter — переименовать». Отдельно от строки статуса ниже намеренно — та
                         однократная, и мигать в ней словом «Сохранено» каждые несколько секунд
                         значило бы затирать «Макрос удалён» и «Импортировано». Строк в этом стеке
                         по-прежнему не больше трёх разом: при ChangedOnDisk эта гаснет, потому
                         что жёлтая строка ниже говорит то же самое и точнее. -->
                    <TextBlock FontSize="{DynamicResource NocturneFontSizeMicro}"
                               Foreground="{DynamicResource NocturneTextFaintBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding SaveStateText, Converter={x:Static conv:NotNullToBoolConverter.Instance}}"
                               ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_SaveStateTip}"
                               Text="{Binding SaveStateText}" />
                    <TextBlock FontSize="{DynamicResource NocturneFontSizeMicro}"
                               Foreground="{DynamicResource NocturneWarningBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding ChangedOnDisk}"
                               ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_ChangedOnDiskTip}"
                               Text="{x:Static res:Strings.Editor_Toolbar_ChangedOnDisk}" />
                    <TextBlock FontSize="{DynamicResource NocturneFontSizeMicro}"
                               Foreground="{DynamicResource NocturneDangerBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:NotNullToBoolConverter.Instance}}"
                               Text="{Binding ErrorMessage}" />
                    <TextBlock FontSize="{DynamicResource NocturneFontSizeMicro}"
                               Foreground="{DynamicResource NocturneTextFaintBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding StatusMessage, Converter={x:Static conv:NotNullToBoolConverter.Instance}}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>

                <Button Grid.Column="7"
                        Content="{x:Static res:Strings.Editor_Toolbar_OpenFolder}"
                        Height="26"
                        ToolTip.Tip="{Binding FolderPath}"
                        Click="OnOpenFolderClicked" />
                <Button Grid.Column="8"
                        Content="{x:Static res:Strings.Editor_Toolbar_Reload}"
                        Height="26"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding HasOpenMacro}"
                        ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_ReloadTip}"
                        Click="OnReloadClicked" />
                <Button Grid.Column="9"
                        Content="{x:Static res:Strings.Editor_Toolbar_AutoLayout}"
                        Height="26"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding HasOpenMacro}"
                        ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_AutoLayoutTip}"
                        Click="OnAutoLayoutClicked" />
                <!-- Кнопка осталась, хотя пишет автосохранение: за ней три вещи, которых оно не
                     делает и делать не должно, — переименовать файл, выбрать свою сторону при
                     правке снаружи и записать немедленно. -->
                <Button Grid.Column="10"
                        Content="{x:Static res:Strings.Editor_Toolbar_Save}"
                        Classes="accent"
                        Height="26"
                        Padding="16,0"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding HasOpenMacro}"
                        ToolTip.Tip="{x:Static res:Strings.Editor_Toolbar_SaveTip}"
                        Click="OnSaveClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="228,*,308">

            <!-- ============================= библиотека ============================= -->
            <Border Grid.Column="0"
                    Background="{DynamicResource NocturneSurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource NocturneDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Padding + VerticalContentAlignment — та же ловушка жёсткой высоты, что и
                         у поля имени макроса выше. -->
                    <TextBox Grid.Row="0"
                             Margin="8"
                             Height="24"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             Watermark="{x:Static res:Strings.Macros_Library_SearchWatermark}"
                             Text="{Binding LibrarySearch, Mode=TwoWay}" />

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MacroGroups}">
                            <ItemsControl.ItemTemplate>
                                <!-- Группа — это МАКРОС: его строка сама и есть заголовок, а
                                     вложенный список под ней — его под-макросы (F4). Группировка
                                     по префиксу имени убрана; довод — в MacroLibraryGroupViewModel. -->
                                <DataTemplate x:DataType="canvas:MacroLibraryGroupViewModel">
                                    <StackPanel>
                                        <ContentControl Content="{Binding Macro}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="vm:MacroListItemViewModel">
                                                    <Border Classes="libRow"
                                                            Classes.current="{Binding IsCurrent}"
                                                            ToolTip.Tip="{Binding Summary}"
                                                            PointerPressed="OnMacroRowPressed">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        Spacing="1">
                                                                <!-- СЕТКА, а не горизонтальный StackPanel, и это не
                                                                     вкусовщина. StackPanel меряет детей неограниченной
                                                                     шириной, поэтому имя с бейджем и ▲ спокойно
                                                                     выезжали за колонку и печатались ПОД кнопками
                                                                     ▸ ■ ⤓ × (библиотека — 228px). Найдено обходом
                                                                     раскладки. Звёздочку получает ИМЯ: у него
                                                                     единственного здесь есть TextTrimming, то есть оно и
                                                                     есть та часть, которой разрешено укоротиться, — а
                                                                     аккорд соперничать за ширину перестал, см. ниже. -->
                                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                                      VerticalAlignment="Center">
                                                                    <!-- С макросом беда: бандл не читается ЛИБО в графе
                                                                         ошибки. Строка ОСТАЁТСЯ в списке: файл
                                                                         существует, и пользователь обязан это видеть —
                                                                         иначе единственный способ узнать о нём — открыть
                                                                         папку проводником. Второй случай сюда добавлен
                                                                         позже: у макроса с ошибкой и без хоткея не
                                                                         загоралось ничего, а ▸ гасла молча. -->
                                                                    <TextBlock Grid.Column="0"
                                                                               FontSize="10"
                                                                               Margin="0,0,7,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource NocturneDangerBrush}"
                                                                               IsVisible="{Binding IsUnhealthy}"
                                                                               ToolTip.Tip="{Binding UnhealthyReason}"
                                                                               Text="!" />
                                                                    <TextBlock Grid.Column="1"
                                                                               FontSize="11.5"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{Binding IsCurrent, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneTextBrush|NocturneTextSecondaryBrush}"
                                                                               Text="{Binding Name}" />
                                                                </Grid>
                                                                <!-- ⚠️ Аккорд ВТОРОЙ СТРОКОЙ, и это не оформление.
                                                                     Библиотеке 228px, а имя и аккорд на одной строке в
                                                                     них не помещаются НИКОГДА — проверено запуском обоих
                                                                     разменов: отдай звёздочку имени, и «Ctrl+Shift+Alt+F12»
                                                                     съедает строку целиком (имя получает 0px и пропадает
                                                                     насовсем); ограничь бейдж, и имя вырождается в «p…»,
                                                                     по которому pw-immunity от pw-identify не отличить.
                                                                     Обрезка просто переезжала с одного на другое, потому
                                                                     что места нет в принципе. Вторая строка убирает саму
                                                                     конкуренцию, и она у строки уже была — под описание
                                                                     нечитаемого бандла. Имя первое, потому что оно и есть
                                                                     идентичность макроса (оно же имя файла). -->
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="6"
                                                                            HorizontalAlignment="Left">
                                                                    <Border Padding="5,1"
                                                                            CornerRadius="3"
                                                                            VerticalAlignment="Center"
                                                                            Background="{DynamicResource NocturneSurfaceInsetBrush}"
                                                                            IsVisible="{Binding HasTriggerBadge}">
                                                                        <TextBlock FontSize="9.5"
                                                                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                                                   Foreground="{DynamicResource NocturneTextMutedBrush}"
                                                                                   Text="{Binding TriggerBadge}" />
                                                                    </Border>
                                                                    <!-- Хоткей привязан, но не работает. Две причины и
                                                                         оба раза один симптом: Windows не отдала
                                                                         сочетание (это знает только демон) либо в графе
                                                                         ошибка и демон не вооружил триггер вовсе (это
                                                                         панель считает сама, тем же валидатором).
                                                                         Показано на СТРОКЕ, потому что это единственное
                                                                         место, где такое можно заметить, не открывая
                                                                         макрос, — и РЯДОМ С АККОРДОМ, потому что речь о
                                                                         нём: на строке имени он был выровнен по имени, а
                                                                         сообщает про то, что этажом ниже. -->
                                                                    <TextBlock FontSize="9"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource NocturneDangerBrush}"
                                                                               IsVisible="{Binding HasHotkeyProblem}"
                                                                               ToolTip.Tip="{Binding HotkeyProblem}"
                                                                               Text="&#x25B2;" />
                                                                </StackPanel>
                                                                <!-- Паспорт прочитался, а граф — нет: показываем
                                                                     настоящее имя и описание автора, а не «файл X —
                                                                     ошибка». Ради этого случая metadata.json и
                                                                     nodes.json и лежат в бандле порознь. -->
                                                                <TextBlock FontSize="9.5"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource NocturneTextMutedBrush}"
                                                                           IsVisible="{Binding IsBroken}"
                                                                           Text="{Binding BrokenDetail}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Button Content="▸"
                                                                        Classes="ghost"
                                                                        Padding="4,0"
                                                                        FontSize="10"
                                                                        ToolTip.Tip="{x:Static res:Strings.Macros_Row_Run}"
                                                                        IsEnabled="{Binding CanRun}"
                                                                        Click="OnRunMacroClicked" />
                                                                <Button Content="■"
                                                                        Classes="ghost"
                                                                        Padding="4,0"
                                                                        FontSize="9"
                                                                        ToolTip.Tip="{x:Static res:Strings.Macros_Row_Stop}"
                                                                        IsEnabled="{Binding IsRunning}"
                                                                        Click="OnStopMacroClicked" />
                                                                <Button Content="⤓"
                                                                        Classes="ghost"
                                                                        Padding="4,0"
                                                                        FontSize="10"
                                                                        ToolTip.Tip="{x:Static res:Strings.Macros_Row_Export}"
                                                                        Click="OnExportMacroClicked" />
                                                                <Button Content="×"
                                                                        Classes="ghost"
                                                                        Padding="4,0"
                                                                        FontSize="11"
                                                                        ToolTip.Tip="{x:Static res:Strings.Macros_Row_Delete}"
                                                                        Click="OnDeleteMacroClicked" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>

                                        <!-- Под-макросы: строка проще родительской ровно на то,
                                             чего у функции нет. Ни ▸, ни ⤓ — запустить её саму по
                                             себе нельзя (она не макрос), а отдать отдельным файлом
                                             тем более: она живёт внутри бандла родителя. -->
                                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SubmacroListItemViewModel">
                                                    <Border Classes="libRow"
                                                            Classes.current="{Binding IsCurrent}"
                                                            Margin="14,0,0,0"
                                                            ToolTip.Tip="{Binding Summary}"
                                                            PointerPressed="OnSubmacroRowPressed">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <!-- Направляющая дерева — ЛИНИЯ, а не
                                                                 глиф: любой символ псевдографики
                                                                 пришлось бы сперва посмотреть
                                                                 глазами и внести в список
                                                                 проверенных (AxamlGlyphTests), а
                                                                 борозда в один пиксель говорит
                                                                 «вложено» ничуть не хуже. -->
                                                            <Border Grid.Column="0"
                                                                    Width="1"
                                                                    Margin="2,2,8,2"
                                                                    Background="{DynamicResource NocturneDividerStrongBrush}" />
                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        Spacing="7"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{Binding IsCurrent, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneTextBrush|NocturneTextSecondaryBrush}"
                                                                           Text="{Binding Name}" />
                                                                <TextBlock FontSize="10"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource NocturneDangerBrush}"
                                                                           IsVisible="{Binding HasErrors}"
                                                                           ToolTip.Tip="{x:Static res:Strings.Macros_SubmacroRow_ErrorTip}"
                                                                           Text="!" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2"
                                                                    Content="×"
                                                                    Classes="ghost"
                                                                    Padding="4,0"
                                                                    FontSize="11"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip.Tip="{x:Static res:Strings.Macros_SubmacroRow_Delete}"
                                                                    Click="OnDeleteSubmacroClicked" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Padding="8"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource NocturneDividerBrush}">
                        <!-- Импорт рядом с созданием, а не в шапке: обе кнопки отвечают на один
                             вопрос «откуда в библиотеке берётся макрос». Экспорт живёт на СТРОКЕ —
                             он всегда про конкретный файл. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0"
                                    Content="{x:Static res:Strings.Macros_Library_New}"
                                    Classes="accent"
                                    Height="26"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnNewMacroClicked" />
                            <Button Grid.Column="1"
                                    Content="{x:Static res:Strings.Macros_Library_Import}"
                                    Height="26"
                                    Padding="10,0"
                                    Margin="6,0,0,0"
                                    ToolTip.Tip="{x:Static res:Strings.Macros_Library_ImportTip}"
                                    Click="OnImportMacroClicked" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ======================== canvas + лог прогона ======================== -->
            <Grid Grid.Column="1" RowDefinitions="*,158">

                <Panel Grid.Row="0"
                       x:Name="Viewport"
                       Background="{DynamicResource NocturneCanvasBrush}"
                       ClipToBounds="True"
                       Focusable="True"
                       PointerPressed="OnViewportPressed"
                       PointerMoved="OnViewportMoved"
                       PointerReleased="OnViewportReleased"
                       PointerWheelChanged="OnViewportWheel"
                       KeyDown="OnViewportKeyDown">

                    <controls:CanvasBackdrop Zoom="{Binding Zoom}"
                                             OffsetX="{Binding PanX}"
                                             OffsetY="{Binding PanY}" />

                    <!-- Трансформируемая поверхность. Всё на ней — в координатах canvas;
                         code-behind переводит положения указателя теми же числами. -->
                    <Canvas x:Name="Surface"
                            Width="4000"
                            Height="4000"
                            Background="Transparent"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            RenderTransformOrigin="0%,0%"
                            IsVisible="{Binding HasOpenMacro}">
                        <controls:EdgeLayer x:Name="Edges"
                                            Width="4000"
                                            Height="4000"
                                            Edges="{Binding CanvasEdges}"
                                            Links="{Binding VariableLinks}" />
                        <ItemsControl ItemsSource="{Binding Nodes}"
                                      ItemTemplate="{StaticResource NodeBoxTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="4000" Height="4000" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <!-- Положение несёт сгенерированный контейнер; сам шаблон
                                     коробки о том, где он находится, не знает ничего.
                                     ClipToBounds выключен явно: точка останова свисает с левого
                                     верхнего угла коробки на отрицательном отступе, и у ноды на
                                     canvas при x=0 левую половину срезало. -->
                                <Style Selector="ItemsControl > ContentPresenter" x:DataType="nodes:NodeRowViewModel">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    <Setter Property="ClipToBounds" Value="False" />
                                </Style>
                            </ItemsControl.Styles>
                        </ItemsControl>
                    </Canvas>

                    <!-- пустое состояние: макрос не открыт, но библиотека не пуста -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8.4"
                                IsVisible="{Binding ShowPickMacroHint}">
                        <TextBlock FontSize="{DynamicResource NocturneFontSizeTitle}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource NocturneTextMutedBrush}"
                                   Text="{x:Static res:Strings.Macros_PickMacro_Title}" />
                        <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneTextGhostBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding FolderPath}" />
                    </StackPanel>

                    <!-- пустое состояние: в macros/ нет вообще ничего.
                         Свежая установка открывается именно так: ни посева, ни раздаточных
                         примеров больше нет. Отдельно от «выберите макрос слева» намеренно —
                         пустой список с надписью «выберите» читается как сломанная панель. -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="460"
                                Spacing="8.4"
                                IsVisible="{Binding ShowEmptyLibraryHint}">
                        <TextBlock FontSize="{DynamicResource NocturneFontSizeTitle}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource NocturneTextMutedBrush}"
                                   Text="{x:Static res:Strings.Macros_EmptyLibrary_Title}" />
                        <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource NocturneTextFaintBrush}"
                                   Text="{x:Static res:Strings.Macros_EmptyLibrary_Hint}" />
                        <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneTextGhostBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding FolderPath}" />
                    </StackPanel>

                    <!-- Чип масштаба. Внизу СЛЕВА, а не вверху справа, как в макете: у макета
                         canvas шире графа, у нас — ровно по нему, так что чип в правом верхнем
                         углу садится прямо на первую коробку третьей колонки. -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12"
                            Height="24"
                            Padding="4,0"
                            CornerRadius="{DynamicResource NocturneRadiusSm}"
                            Background="{DynamicResource NocturneSurfaceOverlayBrush}"
                            BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding HasOpenMacro}">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Content="−" Classes="ghost" Padding="6,0" ToolTip.Tip="{x:Static res:Strings.Editor_Canvas_ZoomOut}" Click="OnZoomOutClicked" />
                            <Button Classes="ghost" Padding="4,0" ToolTip.Tip="{x:Static res:Strings.Editor_Canvas_ZoomReset}" Click="OnZoomResetClicked">
                                <TextBlock FontSize="10.5"
                                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                           MinWidth="34"
                                           TextAlignment="Center"
                                           Text="{Binding ZoomText}" />
                            </Button>
                            <Button Content="+" Classes="ghost" Padding="6,0" ToolTip.Tip="{x:Static res:Strings.Editor_Canvas_ZoomIn}" Click="OnZoomInClicked" />
                        </StackPanel>
                    </Border>

                    <!-- легенда -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="12"
                            Height="24"
                            Padding="10,0"
                            CornerRadius="{DynamicResource NocturneRadiusSm}"
                            Background="{DynamicResource NocturneSurfaceOverlayBrush}"
                            BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding HasOpenMacro}">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Width="7" Height="7"
                                        VerticalAlignment="Center"
                                        RenderTransform="rotate(45deg)"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource NocturneAccentBrush}" />
                                <TextBlock Classes="hint" Text="{x:Static res:Strings.Editor_Canvas_LegendConditional}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Width="7" Height="7"
                                        CornerRadius="2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource NocturneTextFaintBrush}" />
                                <TextBlock Classes="hint" Text="{x:Static res:Strings.Editor_Canvas_LegendAction}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Width="12" Height="1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource NocturneVariableBrush}" />
                                <TextBlock Classes="hint" Text="{x:Static res:Strings.Editor_Canvas_LegendVariable}" />
                            </StackPanel>
                            <TextBlock Classes="hint" Text="{x:Static res:Strings.Editor_Canvas_LegendPan}" />
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- =========================== лог прогона =========================== -->
                <Border Grid.Row="1"
                        Background="{DynamicResource NocturnePanelDeepBrush}"
                        BorderBrush="{DynamicResource NocturneDividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="26,*">
                        <Border Grid.Row="0"
                                Padding="12,0"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource NocturnePanelDeepDividerBrush}">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           FontSize="10.5"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource NocturneNeutral300Brush}"
                                           Text="{x:Static res:Strings.Editor_RunLog_Title}" />

                                <!-- Переключатель прогонов. По одному графу могут идти десять
                                     окон разом, поэтому полоса и подсветка на canvas следуют за
                                     ОДНИМ из них, а выбирают его здесь. -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasRuns}">
                                    <Ellipse Width="5" Height="5"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SelectedRunIsLive}"
                                             Fill="{DynamicResource NocturneAccentBrush}" />
                                    <TextBlock FontSize="10"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                               Foreground="{DynamicResource NocturneTextMutedBrush}"
                                               Text="{Binding RunChipText}" />
                                    <TextBlock Classes="hint"
                                               Text="{Binding RunPositionText}" />
                                    <!-- U+25C2/U+25B8, а не U+25C0/U+25B6: D1 выяснила, что
                                         большие треугольники получают эмодзи-представление и
                                         приезжают белыми, начисто игнорируя Foreground. -->
                                    <Button Classes="ghost" Padding="5,0" FontSize="11"
                                            Content="&#x25C2;"
                                            ToolTip.Tip="{x:Static res:Strings.Editor_RunLog_PreviousRun}"
                                            Click="OnPreviousRunClicked" />
                                    <Button Classes="ghost" Padding="5,0" FontSize="11"
                                            Content="&#x25B8;"
                                            ToolTip.Tip="{x:Static res:Strings.Editor_RunLog_NextRun}"
                                            Click="OnNextRunClicked" />
                                </StackPanel>

                                <!-- Неполный лог не имеет права выглядеть полным. -->
                                <Border Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Padding="7,1"
                                        VerticalAlignment="Center"
                                        CornerRadius="9"
                                        Background="{DynamicResource NocturneWarningSurfaceBrush}"
                                        BorderBrush="{DynamicResource NocturneWarningBorderBrush}"
                                        BorderThickness="1"
                                        IsVisible="{Binding HasRunLogNotice}">
                                    <TextBlock FontSize="9.5"
                                               Foreground="{DynamicResource NocturneWarningBrush}"
                                               Text="{Binding RunLogNotice}" />
                                </Border>

                                <!-- Красная пилюля из макета 1d, расширенная на все причины
                                     паузы: это ЕДИНСТВЕННОЕ место, называющее и состояние, и
                                     ноду, на которой обход припаркован, — а значит, оно обязано
                                     покрывать и шаг, и ручную паузу, а не одну лишь точку
                                     останова. Тревожный оттенок — только для точки останова:
                                     остальное пользователь сделал сам. -->
                                <Border Grid.Column="3"
                                        Margin="10,0,0,0"
                                        Padding="7,1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="9"
                                        Background="{Binding SelectedRunAtBreakpoint, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneDangerSurfaceBrush|NocturneAccentTint12Brush}"
                                        BorderBrush="{Binding SelectedRunAtBreakpoint, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneDangerBorderBrush|NocturneAccent700Brush}"
                                        BorderThickness="1"
                                        IsVisible="{Binding SelectedRunPauseVisible}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="5" Height="5"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding SelectedRunAtBreakpoint, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneDangerBrush|NocturneAccentBrush}" />
                                        <TextBlock FontSize="9.5"
                                                   Foreground="{Binding SelectedRunAtBreakpoint, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneDangerBrush|NocturneAccent300Brush}"
                                                   Text="{Binding PauseNotice}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Column="3"
                                           Classes="hint"
                                           Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding !SelectedRunPauseVisible}"
                                           Text="{x:Static res:Strings.Editor_RunLog_Columns}" />

                                <Button Grid.Column="4"
                                        Classes="ghost"
                                        Padding="6,0"
                                        FontSize="10"
                                        Content="{x:Static res:Strings.Editor_RunLog_Clear}"
                                        ToolTip.Tip="{x:Static res:Strings.Editor_RunLog_ClearTip}"
                                        IsVisible="{Binding HasRuns}"
                                        Click="OnClearRunLogClicked" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource NocturneFontSizeSmall}"
                                   Foreground="{DynamicResource NocturneTextGhostBrush}"
                                   IsVisible="{Binding !HasRunLog}"
                                   Text="{Binding RunLogEmptyText}" />

                        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasRunLog}">
                            <ItemsControl ItemsSource="{Binding RunLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="canvas:RunLogRowViewModel">
                                        <Border Padding="12,3"
                                                BorderThickness="2,0,0,0"
                                                BorderBrush="{Binding IsCurrent, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccentBrush|NocturneCanvasBrush}"
                                                Background="{Binding IsCurrent, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccentTint08Brush|NocturnePanelDeepBrush}">
                                            <Grid ColumnDefinitions="62,156,96,*">
                                                <TextBlock Grid.Column="0"
                                                           FontSize="10.5"
                                                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                           Foreground="{DynamicResource NocturneTextMutedBrush}"
                                                           Text="{Binding Elapsed}" />
                                                <TextBlock Grid.Column="1"
                                                           FontSize="10.5"
                                                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource NocturneTextMutedBrush}"
                                                           Text="{Binding NodeName}" />
                                                <TextBlock Grid.Column="2"
                                                           FontSize="10.5"
                                                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                           Foreground="{Binding OutcomeIsAccent, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccent400Brush|NocturneTextMutedBrush}"
                                                           Text="{Binding Outcome}" />
                                                <TextBlock Grid.Column="3"
                                                           FontSize="10.5"
                                                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource NocturneTextFaintBrush}"
                                                           Text="{Binding Detail}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================== инспектор ============================== -->
            <Border Grid.Column="2"
                    Background="{DynamicResource NocturnePanelDeepBrush}"
                    BorderBrush="{DynamicResource NocturneDividerBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="30,*,Auto">

                    <Border Grid.Row="0"
                            Padding="12,0"
                            Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource NocturnePanelDeepDividerBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Text="{Binding InspectorTitle}" />
                            <TextBlock Grid.Column="2"
                                       Classes="hint"
                                       IsVisible="{Binding HasSelectedNode}"
                                       Text="{x:Static res:Strings.Editor_Inspector_DoubleClickHint}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- инспектор ноды -->
                            <StackPanel IsVisible="{Binding HasSelectedNode}">
                                <StackPanel Margin="12,9" Spacing="5.6">
                                    <Grid ColumnDefinitions="64,*">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{x:Static res:Strings.Node_Field_Name}" />
                                        <TextBox Grid.Column="1"
                                                 Classes="mono"
                                                 ToolTip.Tip="{x:Static res:Strings.Editor_Inspector_NodeNameTip}"
                                                 Text="{Binding SelectedNode.DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <ContentControl Content="{Binding SelectedNode}" />
                                </StackPanel>

                                <Border BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource NocturnePanelDeepDividerBrush}"
                                        Padding="12,9"
                                        IsVisible="{Binding SelectedNode.HasTarget}">
                                    <StackPanel Spacing="5.6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Classes="eyebrow" Text="{x:Static res:Strings.Editor_Inspector_TargetsHeader}" />
                                            <!-- Бейдж вместе со своим разворотом (1g). Здесь, а
                                                 не на коробке canvas, потому что Popup над
                                                 масштабированной и сдвинутой поверхностью
                                                 приземляется туда, где transform не действует. -->
                                            <ContentControl Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Content="{Binding SelectedNode.Target}"
                                                            ContentTemplate="{StaticResource TargetBadgeButtonTemplate}" />
                                        </Grid>
                                        <ContentControl Content="{Binding SelectedNode.Target}" />
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource NocturnePanelDeepDividerBrush}"
                                        Padding="12,9">
                                    <StackPanel Spacing="5.6">
                                        <TextBlock Classes="eyebrow" Text="{x:Static res:Strings.Editor_Inspector_OutcomesHeader}" />
                                        <ItemsControl ItemsSource="{Binding SelectedNode.Edges}"
                                                      ItemTemplate="{StaticResource EdgeEditorTemplate}" />
                                        <TextBlock Classes="hint"
                                                   TextWrapping="Wrap"
                                                   Text="{x:Static res:Strings.Editor_Inspector_EndHint}" />
                                        <!-- Макет 1d кладёт галочку точки останова сюда, в
                                             подвал блока исходов. Частью графа она НЕ является:
                                             уходит в сеанс демона и в файл макроса не попадает
                                             никогда. -->
                                        <CheckBox Margin="0,4,0,0"
                                                  Content="{x:Static res:Strings.Editor_Inspector_Breakpoint}"
                                                  ToolTip.Tip="{x:Static res:Strings.Editor_Inspector_BreakpointTip}"
                                                  IsChecked="{Binding SelectedNode.HasBreakpoint, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource NocturnePanelDeepDividerBrush}"
                                        Padding="12,9">
                                    <Button Content="{x:Static res:Strings.Editor_Inspector_DeleteNode}"
                                            Classes="danger"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="OnDeleteNodeClicked" />
                                </Border>
                            </StackPanel>

                            <!-- инспектор макроса (ничего не выделено) -->
                            <StackPanel Margin="12,9"
                                        Spacing="8.4"
                                        IsVisible="{Binding !HasSelectedNode}">
                                <TextBlock Classes="hint"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasOpenMacro}"
                                           Text="{x:Static res:Strings.Editor_Inspector_NoSelection}" />
                                <TextBlock Classes="hint"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !HasOpenMacro}"
                                           Text="{x:Static res:Strings.Editor_Inspector_NoMacro}" />
                            </StackPanel>

                            <!-- Раздел целиком прячется, когда на канве под-макрос: триггеров у
                                 функции не бывает по определению (см. MacroSubmacro), и «+ хоткей»
                                 здесь предлагал бы ошибку валидации. -->
                            <Border Padding="12,9"
                                    BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource NocturnePanelDeepDividerBrush}"
                                    IsVisible="{Binding ShowsTriggers}">
                                <StackPanel Spacing="5.6">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Classes="eyebrow" Text="{x:Static res:Strings.Editor_Triggers_Header}" />
                                        <Button Grid.Column="1"
                                                Content="{x:Static res:Strings.Editor_Triggers_AddHotkey}"
                                                Classes="ghost"
                                                Click="OnAddHotkeyTriggerClicked" />
                                        <Button Grid.Column="2"
                                                Content="{x:Static res:Strings.Editor_Triggers_AddProcess}"
                                                Classes="ghost"
                                                Click="OnAddProcessTriggerClicked" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Triggers}" />
                                    <!-- Здесь раньше стояла постоянная строка «в этом режиме
                                         хоткеи выключены». D4 перенесла её во взведённое
                                         состояние ловушки (1f) — в тот момент, когда с ней
                                         можно что-то сделать; две копии одной фразы, одна из
                                         них вечная, — верный способ добиться, чтобы
                                         предупреждение перестали читать. -->
                                </StackPanel>
                            </Border>

                            <!-- ==== переменные (D5) ====
                                 Структура — из статического анализа в Shared, значение — из
                                 выбранного обхода. Показывается, чем бы ни была занята другая
                                 половина инспектора, как и валидация: речь про МАКРОС, и спрятав
                                 её за выделением ноды, мы сделали бы «кто пишет {tag}» вопросом,
                                 на который отвечают только с той ноды, что случайно выделена. -->
                            <Border Padding="12,9"
                                    BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource NocturnePanelDeepDividerBrush}"
                                    Background="{DynamicResource NocturneCanvasBrush}"
                                    IsVisible="{Binding HasOpenMacro}">
                                <StackPanel Spacing="8.4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="eyebrow" Text="{x:Static res:Strings.Editor_Variables_Header}" />
                                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding VariableCountText}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Variables}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="canvas:MacroVariableRowViewModel">
                                                <Border Margin="0,0,0,5.6"
                                                        CornerRadius="6"
                                                        BorderThickness="1"
                                                        Background="{DynamicResource NocturneSurfaceRowAltBrush}"
                                                        BorderBrush="{Binding IsHighlighted, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneVariableBrush|NocturneDividerStrongBrush}"
                                                        PointerEntered="OnVariableHovered"
                                                        PointerExited="OnVariableUnhovered">
                                                    <StackPanel>
                                                        <Border Padding="8,5"
                                                                BorderThickness="0,0,0,1"
                                                                BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                                                                Background="{DynamicResource NocturneVariableSurfaceBrush}">
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           FontSize="11"
                                                                           FontWeight="Medium"
                                                                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                                           Foreground="{DynamicResource NocturneVariableBrush}"
                                                                           Text="{Binding Name}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="7,0,0,0"
                                                                           Classes="hint"
                                                                           Text="{Binding KindText}" />
                                                                <!-- Ничего, а не прочерк, когда обход её ещё не
                                                                     выставил: пустая ячейка читается как «пока
                                                                     нет», а прочерк — как «пустая строка», и это
                                                                     разные ошибки. -->
                                                                <TextBlock Grid.Column="3"
                                                                           FontSize="10"
                                                                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           IsVisible="{Binding HasValue}"
                                                                           Text="{Binding Value}" />
                                                            </Grid>
                                                        </Border>
                                                        <Grid ColumnDefinitions="46,*" Margin="8,4,8,0">
                                                            <TextBlock Grid.Column="0" Classes="hint" Text="{x:Static res:Strings.Editor_Variables_WrittenBy}" />
                                                            <TextBlock Grid.Column="1"
                                                                       FontSize="10.5"
                                                                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource NocturneNeutral300Brush}"
                                                                       Text="{Binding WrittenBy}" />
                                                        </Grid>
                                                        <Grid ColumnDefinitions="46,*" Margin="8,1,8,5"
                                                              ToolTip.Tip="{Binding ReadDetail}">
                                                            <TextBlock Grid.Column="0" Classes="hint" Text="{x:Static res:Strings.Editor_Variables_ReadBy}" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                <TextBlock FontSize="10.5"
                                                                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource NocturneNeutral300Brush}"
                                                                           Text="{Binding ReadBy}" />
                                                                <TextBlock Classes="hint" Text="{Binding ReadWhere}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <!-- Чтение без записи обрывает прогон на этой ноде
                                                             (spec §5.3). Сказать об этом здесь дешевле,
                                                             чем узнать из строки лога. -->
                                                        <TextBlock Margin="8,0,8,5"
                                                                   FontSize="9.5"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding IsUndefined}"
                                                                   Foreground="{DynamicResource NocturneDangerBrush}"
                                                                   Text="{x:Static res:Strings.Editor_Variables_Undefined}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Classes="hint"
                                               TextWrapping="Wrap"
                                               Text="{x:Static res:Strings.Editor_Variables_HoverHint}" />
                                </StackPanel>
                            </Border>

                            <!-- ==== шаблоны макроса (F2) ====
                                 Бывший режим рейки «Шаблоны». Он оттуда ушёл вместе с общим
                                 деревом templates/: шаблон лежит внутри бандла .hsm ровно одного
                                 макроса, то есть перестал быть самостоятельной сущностью, а рейка
                                 — про сущности. Место ему здесь, рядом с триггерами и
                                 переменными, среди остальных свойств макроса как целого.

                                 Раздела «НЕТ ФАЙЛА» здесь нет и не будет: «нода называет шаблон,
                                 которого в бандле нет» теперь ловит валидатор и кладёт в общий
                                 список замечаний внизу. -->
                            <Border Padding="12,9"
                                    BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource NocturnePanelDeepDividerBrush}"
                                    IsVisible="{Binding HasOpenMacro}">
                                <StackPanel Spacing="7" DataContext="{Binding Templates}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="eyebrow" Text="{x:Static res:Strings.Editor_Templates_Header}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="7,0,0,0"
                                                   Classes="hint"
                                                   Text="{Binding CountText}" />
                                        <Button Grid.Column="2"
                                                Content="{x:Static res:Strings.Editor_Templates_Add}"
                                                Classes="ghost"
                                                IsEnabled="{Binding HasMacro}"
                                                ToolTip.Tip="{x:Static res:Strings.Editor_Templates_AddTip}"
                                                Click="OnAddTemplateClicked" />
                                    </Grid>

                                    <!-- Набор указывается ПЕРЕД импортом, полем, а не диалогом:
                                         это одна строка, и модальность ради неё была бы дороже
                                         самой задачи. Имя шаблона не спрашивается вовсе — им
                                         становится основа имени выбранного файла, ровно как было
                                         в общем дереве. Padding + VerticalContentAlignment — та
                                         же ловушка жёсткой высоты, что у поля имени макроса. -->
                                    <Grid ColumnDefinitions="46,*" IsVisible="{Binding HasMacro}">
                                        <TextBlock Grid.Column="0" Classes="label"
                                                   Text="{x:Static res:Strings.Editor_Templates_Set}" />
                                        <TextBox Grid.Column="1"
                                                 Height="24"
                                                 Padding="8,0"
                                                 VerticalContentAlignment="Center"
                                                 Classes="mono"
                                                 Watermark="{x:Static res:Strings.Editor_Templates_SetWatermark}"
                                                 Text="{Binding ImportSet, Mode=TwoWay}" />
                                    </Grid>

                                    <TextBlock Classes="hint"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding !HasMacro}"
                                               Text="{x:Static res:Strings.Editor_Templates_NoBundle}" />

                                    <TextBlock TextWrapping="Wrap"
                                               FontSize="10.5"
                                               IsVisible="{Binding HasImportProblem}"
                                               Foreground="{DynamicResource NocturneDangerBrush}"
                                               Text="{Binding ImportProblem}" />

                                    <TextBlock Classes="hint"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding IsEmpty}"
                                               Text="{x:Static res:Strings.Editor_Templates_Empty}" />

                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TemplateGroupViewModel">
                                                <StackPanel Margin="0,0,0,4">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,3">
                                                        <TextBlock Grid.Column="0"
                                                                   Classes="hint"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="hint"
                                                                   Text="{Binding CountText}" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TemplateRowViewModel">
                                                                <Border Classes="libRow"
                                                                        Classes.current="{Binding IsSelected}"
                                                                        ToolTip.Tip="{Binding UsageText}"
                                                                        PointerPressed="OnTemplateRowPressed">
                                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                                        <TextBlock Grid.Column="0"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                                                   Foreground="{Binding IsUnused, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneTextMutedBrush|NocturneTextBrush}"
                                                                                   Text="{Binding Name}" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Margin="6,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Classes="hint"
                                                                                   Text="{Binding SizeText}" />
                                                                        <Button Grid.Column="2"
                                                                                Content="×"
                                                                                Classes="ghost"
                                                                                Padding="4,0"
                                                                                FontSize="11"
                                                                                ToolTip.Tip="{x:Static res:Strings.Editor_Templates_Delete}"
                                                                                Click="OnDeleteTemplateClicked" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Превью выбранного. Байты приезжают по одному шаблону, за
                                         выделением: список это метаданные, а труба общая с
                                         потоком событий прогона. -->
                                    <StackPanel Spacing="5.6" IsVisible="{Binding HasSelection}">
                                        <Border Padding="8"
                                                CornerRadius="{DynamicResource NocturneRadiusSm}"
                                                Background="{DynamicResource NocturneCanvasBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource NocturneDividerBrush}">
                                            <StackPanel Spacing="5.6">
                                                <TextBlock FontSize="11"
                                                           FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Selected.FullName}" />
                                                <!-- Source ставит code-behind, а не привязка с
                                                     конвертером: Bitmap держит неуправляемую
                                                     память Skia, и конвертер, вызываемый на
                                                     каждое обновление, оставлял бы каждую
                                                     предыдущую картинку финализатору. Живая
                                                     картинка здесь ровно одна. -->
                                                <Image x:Name="TemplatePreviewImage"
                                                       MaxHeight="160"
                                                       HorizontalAlignment="Left"
                                                       IsVisible="{Binding HasPreview}" />
                                                <TextBlock Classes="hint"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasPreviewProblem}"
                                                           Text="{Binding PreviewProblem}" />
                                                <TextBlock Classes="eyebrow" Text="{Binding SelectedUsageHeader}" />
                                                <ItemsControl ItemsSource="{Binding SelectedUsages}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock FontSize="10.5"
                                                                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource NocturneNeutral300Brush}"
                                                                       Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Валидация остаётся на виду, что бы инспектор ни показывал: она про граф
                         целиком, а спрятать её за выделением — верный способ превратить
                         заблокированное сохранение в загадку. -->
                    <Border Grid.Row="2"
                            Margin="8"
                            Padding="{DynamicResource NocturneInsetTight}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource NocturneDangerBorderBrush}"
                            Background="{DynamicResource NocturneDangerSurfaceBrush}"
                            CornerRadius="{DynamicResource NocturneRadiusSm}"
                            IsVisible="{Binding HasIssues}">
                        <ScrollViewer MaxHeight="140">
                            <ItemsControl ItemsSource="{Binding Issues}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
