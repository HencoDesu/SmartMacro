<!--
  Transitional macro list (W0.2b). The old per-tag/per-action editor bound to the legacy
  flat macro model, which no longer exists — W0.3 rebuilds a real editor against the node
  graph. Until then this dialog is deliberately read-only plus Run/Stop: enough to drive
  the engine, with the files themselves editable by hand in the macros/ folder.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartMacro.App.ViewModels"
        xmlns:conv="using:SmartMacro.App.Converters"
        x:Class="SmartMacro.App.MacrosDialog"
        x:DataType="vm:MacrosDialogViewModel"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="Макросы">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12">
        <TextBlock Grid.Row="0"
                   FontSize="11"
                   Foreground="#888"
                   TextWrapping="Wrap"
                   Text="{Binding FolderHint}" />

        <Border Grid.Row="1"
                Margin="0,10"
                BorderThickness="1"
                BorderBrush="#444"
                CornerRadius="4">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MacroRowViewModel">
                            <Border Padding="10"
                                    Margin="4"
                                    BorderThickness="1"
                                    BorderBrush="#333"
                                    CornerRadius="3"
                                    Background="#1a1a1a">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" Text="{Binding Name}" />
                                        <TextBlock FontSize="11"
                                                   Foreground="#888"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Summary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Run"
                                            FontSize="11"
                                            Padding="12,4"
                                            Margin="8,0,0,0"
                                            IsEnabled="{Binding !IsRunning}"
                                            Click="OnRunClicked" />
                                    <Button Grid.Column="2"
                                            Content="Stop"
                                            FontSize="11"
                                            Padding="12,4"
                                            Margin="6,0,0,0"
                                            IsEnabled="{Binding IsRunning}"
                                            Click="OnStopClicked" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2"
                   Foreground="#E06060"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:NotNullToBoolConverter.Instance}}"
                   Text="{Binding ErrorMessage}" />

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Content="Открыть папку"
                    FontSize="11"
                    Padding="10,4"
                    Click="OnOpenFolderClicked" />
            <Button Grid.Column="2"
                    Content="Закрыть"
                    Click="OnClose" />
        </Grid>
    </Grid>
</Window>
