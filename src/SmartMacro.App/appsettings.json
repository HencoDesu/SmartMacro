{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "SmartMacro.GameWindows": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartmacro-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Agent": {
    "ProcessPollIntervalSeconds": 1,
    "AgentPollIntervalSeconds": 2
  },
  "ProcessProfiles": [
    {
      "ProcessName": "elementclient_64",
      "ActivationLParam": 37336,
      "SettleDelayMs": 200,
      "DeactivationDelayMs": 100
    }
  ],
  "Vision": {
    "ClassMatcher": {
      "Region": { "X": 3200, "Y": 1060, "Width": 160, "Height": 35 },
      "LuminanceThreshold": 200.0,
      "MatchThreshold": 0.6
    },
    "Window": {
      "MatchThreshold": 0.5,
      "PollIntervalMs": 500
    }
  }
}
