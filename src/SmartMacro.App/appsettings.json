{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "SmartMacro.GameWindows": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartmacro-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Agent": {
    "GameProcessName": "elementclient_64",
    "ProcessPollIntervalSeconds": 1,
    "AgentPollIntervalSeconds": 2,
    "StatsHotkey": "C",
    "StatsOpenDelayMs": 500,
    "ServerSelectButton": { "X": 1192, "Y": 1805 },
    "CharacterSelectButton": { "X": 1958, "Y": 2053 },
    "InWorldRegion": { "X": 0, "Y": 2100, "Width": 160, "Height": 60 },
    "DefaultImmunityKey": "F8",
    "DefaultAssistKey": "F2",
    "MasterClass": "Лучник",
    "IgnoredClasses": ["Шаман"]
  },
  "Input": {
    "Activating": {
      "SettleDelayMs": 200,
      "ActivationLParam": 37336,
      "PartySlot1": { "X": 285, "Y": 456 }
    }
  },
  "Vision": {
    "ClassMatcher": {
      "Region": { "X": 3200, "Y": 1060, "Width": 160, "Height": 35 },
      "LuminanceThreshold": 200.0,
      "MatchThreshold": 0.6
    },
    "Window": {
      "MatchThreshold": 0.5,
      "PollIntervalMs": 500
    }
  }
}
