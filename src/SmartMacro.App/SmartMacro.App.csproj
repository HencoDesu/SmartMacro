<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro.App</RootNamespace>
    <AssemblyName>SmartMacro.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- LibraryImport source generators emit unsafe ref-handling code (Win32MessageBox). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Configuration, but no Hosting: after stage 3 the only thing appsettings.json
         configures is Serilog, and the four objects this process owns are wired by hand in
         AppServices rather than by a container. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.8" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts (+ Native, transitively) and NOTHING ELSE.
         Stage 3 removed the SmartMacro.Core reference: the panel is a pure IPC client now,
         and this is the constraint that keeps OpenCV, Tesseract and their native blobs out
         of the process the user opens and closes all day. If a view-model ever needs
         something from Core, the answer is a message type, not a reference. -->
    <ProjectReference Include="..\SmartMacro.Contracts\SmartMacro.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serilog only. Every engine knob (Agent / ProcessProfiles / Vision) lives in the
         daemon's appsettings.json — this process has nothing to configure. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The only asset left in this project: the window icon, embedded and loaded via
         avares://SmartMacro.App/Assets/icon.png. The vision templates, the per-tag taskbar
         icons, the tray .ico and the Tesseract language pack all moved to SmartMacro.Daemon
         in stage 3 — they are read at runtime by code that no longer runs here. -->
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>

</Project>
