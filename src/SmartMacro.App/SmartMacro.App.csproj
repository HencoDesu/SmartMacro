<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro.App</RootNamespace>
    <AssemblyName>SmartMacro.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartMacro.Core\SmartMacro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </None>
    <None Update="tessdata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled tray + window icon; loaded via avares://SmartMacro.App/Assets/icon.png -->
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Per-tag taskbar icons. Loaded from disk (not embedded) so the user can swap
         them out without rebuilding. A SetIconNode names the file (typically
         "Assets/ClassIcons/{tag}.png"); WindowIconService resolves it and skips with a
         Debug log when it's missing. -->
    <None Include="Assets\ClassIcons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\ClassIcons\%(Filename)%(Extension)</Link>
    </None>
    <!-- Tag templates for the stats-window template-match identification path
         (filename stem = tag). -->
    <None Include="Assets\GameClassNames\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\GameClassNames\%(Filename)%(Extension)</Link>
    </None>
    <!-- Single UI-element templates, referenced by file stem from Find/Wait nodes.
         Loaded from disk so the user can add new templates without rebuilding. -->
    <None Include="Assets\GameUiElements\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\GameUiElements\%(Filename)%(Extension)</Link>
    </None>
    <!-- User-authored template SETS for RecognizeTag nodes: Assets/templates/{set}/{tag}.png.
         Empty in the repo — the glob exists so a set dropped in here reaches the output on
         the next build, the same way the shipped folders do. -->
    <None Include="Assets\templates\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
