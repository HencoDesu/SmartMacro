<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro.App</RootNamespace>
    <!-- ИМЯ ПРОГРАММЫ, а не имя проекта. В корне поставки видна ровно одна кнопка, и назваться
         она обязана SmartMacro.exe: SmartMacro.App.exe рядом с папкой daemon\ читается как
         «одна из двух половин», хотя это и есть то, что запускают.

         Почему AssemblyName, хотя переименовать хотелось только выходной файл: имя apphost'а SDK
         не даёт настроить отдельно. В Microsoft.NET.Sdk.targets он приезжает в выхлоп элементом
         None с жёстко заданным Link=$(AssemblyName)$(_NativeExecutableExtension) — свойства
         «как назвать exe» не существует. Оставались два пути: переименовать AssemblyName или
         переименовывать файл после публикации. Второй проигрывает дважды — это переименование
         УЖЕ СОБРАННОГО single-file-хоста (сценарий, который никто не поддерживает), и имя
         разъезжается между деревом разработки и поставкой, из-за чего локатору напарника
         пришлось бы знать два имени вместо одного.

         RootNamespace при этом НЕ меняется: типы, папка проекта, имя мьютекса и файл журнала
         остаются SmartMacro.App. Единственное, что тянется за идентичностью сборки, — адреса
         avares://, они теперь avares://SmartMacro/ (их четыре, все в App.axaml и App.axaml.cs). -->
    <AssemblyName>SmartMacro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Тот же довод, что и в SmartMacro.Daemon.csproj, — см. комментарий там. Дорогая часть
         здесь Avalonia: без RID в выхлоп ехали Skia и HarfBuzz под linux-x64, linux-musl-x64,
         linux-arm, linux-arm64, osx, win-arm64 и win-x86 вдобавок к единственной сборке,
         которая вообще может запуститься. Выхлоп: 112 МБ → 29 МБ. Только на диске —
         libSkiaSharp и libHarfBuzzSharp просто переезжают в корень выхлопа, а панель
         по-прежнему стартует и подключается. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Иконка самого exe: вшивается в apphost, отдельным файлом в корне поставки НЕ становится
         (что важно — там ровно один файл). Тот же .ico, что у демона; см. ItemGroup ниже. -->
    <ApplicationIcon>..\..\assets\logo\icon.ico</ApplicationIcon>

    <!-- ОДИН ФАЙЛ В КОРНЕ ПОСТАВКИ. Свойство влияет только на publish, сборка в bin\ остаётся
         обычной россыпью, так что дереву разработки это ничего не стоит.

         Смысл ровно тот же, что у всей раскладки: пользователь видит одну кнопку и свои данные,
         а не полсотни dll. Единственный интересный побочный эффект — распаковка: у панели три
         нативные библиотеки (libSkiaSharp, libHarfBuzzSharp, av_libglesv2), а они, в отличие от
         управляемых сборок, из бандла не грузятся и требуют файла на диске. Отсюда
         IncludeNativeLibrariesForSelfExtract: при первом запуске они уезжают в %TEMP%\.net\...,
         ОДИН РАЗ НА ВЕРСИЮ, а не при каждом старте. Это и есть та цена, из-за которой демона в
         single-file заворачивать не стали: у него нативы OpenCV, он резидентный, и стек с
         путями, которых нет на диске, отлаживать заметно противнее.

         DebugType=embedded, а не отдельный .pdb: pdb рядом с exe — второй файл в корне, ровно
         то, чего раскладка избегает; удалять его после публикации значило бы отдавать номера
         строк в стеках. Внутри бандла он не мешает никому. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- DebugType выше распоряжается только СВОИМИ символами. Символы ССЫЛОК (Contracts,
         Native) приезжают отдельными .pdb как «сопутствующие файлы» и в бандл не заворачиваются
         (IncludeSymbolsInSingleFile по умолчанию false) — то есть в корне поставки оказывались
         SmartMacro.Contracts.pdb и SmartMacro.Native.pdb, ровно те лишние файлы, ради
         отсутствия которых всё и затевалось.

         Только в Release: в Debug они нужны, без них отладчик не покажет ни строки в коде
         Contracts. А Release-сборка панели — это и есть то, что уезжает пользователю. -->
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Configuration, but no Hosting: единственное, что панель вообще настраивает, — Serilog,
         а четыре объекта, которыми она владеет, связаны руками в AppServices, без контейнера.
         Конфигурация осталась даже после того, как файл конфигурации исчез: НЕОБЯЗАТЕЛЬНЫЙ
         appsettings.panel.json рядом с exe читается, если пользователь его положил. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.8" />
    <!-- Транзитивный пакет, выписанный явно. Сюда он приезжает через Serilog.Settings.Configuration
         (зависимость >= 10.0.0), а к демону — через Microsoft.Extensions.Hosting (>= 10.0.8), и
         NuGet честно даёт каждому свой минимум. Пин появился, когда оба exe публиковались в ОДНУ
         папку: там физически лежала одна копия, и молча побеждала та, что публиковалась первой.
         Папки теперь разные, и столкнуться этим версиям негде — пин остаётся гигиеной, чтобы два
         процесса одной программы не расходились в общей зависимости без причины. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts (и транзитивно Native) — И БОЛЬШЕ НИЧЕГО.
         Ссылку на SmartMacro.Core сняли на стадии 3: панель стала чистым клиентом IPC, и
         именно это ограничение держит OpenCV, Tesseract и их нативные блобы за пределами
         процесса, который пользователь открывает и закрывает по десять раз на дню. Если
         view-model'и однажды понадобится что-то из Core, ответ — новый тип сообщения, а не
         ссылка. -->
    <ProjectReference Include="..\SmartMacro.Contracts\SmartMacro.Contracts.csproj" />
  </ItemGroup>

  <!-- Файла конфигурации у панели больше НЕТ. Раньше рядом лежал appsettings.panel.json ровно с
       одной секцией Serilog; теперь эти умолчания живут в App/Program.cs, а внешний файл читается
       опционально — если пользователь положил его сам. Причина в single-file: файлы содержимого
       из бандла не распаковываются, значит конфиг пришлось бы класть рядом с exe — и в корне
       поставки снова оказалось бы два файла вместо одного. -->

  <ItemGroup>
    <!-- Единственный актив, оставшийся в этом проекте: иконка окна, встроенная и загружаемая
         через avares://SmartMacro/Assets/icon.png. Шаблоны vision, иконки панели задач по
         тегам и языковой пакет Tesseract уехали в SmartMacro.Daemon на стадии 3 — их читает в
         рантайме код, который здесь больше не работает.

         ФАЙЛ ЛЕЖИТ НЕ ЗДЕСЬ, а в assets/logo/ в корне репозитория, и приезжает по Link. Причина
         та же, по которой один .ico на оба исполняемых: знак один, а мест, где он нужен, три
         (окно панели, иконка SmartMacro.exe, иконка демона с треем). Копия в каждом проекте —
         это копии, обязанные совпадать, а они не совпадают ровно с того дня, когда знак
         перерисуют и обновят не все. Растр собирает tools/IconForge из SVG; сами SVG отданы
         Claude Design дословно. -->
    <AvaloniaResource Include="..\..\assets\logo\icon-256.png" Link="Assets\icon.png" />
  </ItemGroup>

</Project>
