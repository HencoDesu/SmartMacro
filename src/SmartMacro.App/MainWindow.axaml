<!--
  Main window (W0.3): the tracked WINDOWS with their tag chips, plus the live list of
  running macros. It replaced the agent-row list — after W0.1 there are no per-character
  agents to show, only windows and the tags that route macros at them.

  D1 repainted this in Nocturne without moving anything: same grid, same rows, same
  bindings. Every colour and every padding now comes from Themes/Tokens.axaml — if you
  find yourself typing a hex here, add a token instead. D2 is the wave that reshapes the
  shell into the 1b layout (left rail, always-on runs strip), so resist tidying the
  structure now.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartMacro.App.ViewModels"
        xmlns:conv="using:SmartMacro.App.Converters"
        x:Class="SmartMacro.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="820" Height="820"
        MinWidth="600" MinHeight="500"
        Title="SmartMacro">

    <Window.DataTemplates>
        <!-- Tag chip: the tag text plus its own remove button. -->
        <DataTemplate DataType="vm:TagChipViewModel" x:DataType="vm:TagChipViewModel">
            <Border Background="{DynamicResource NocturneChipFillBrush}"
                    BorderBrush="{DynamicResource NocturneChipBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource NocturneRadiusPill}"
                    Padding="{DynamicResource NocturneInsetChip}"
                    Margin="0,0,5.6,2.8">
                <StackPanel Orientation="Horizontal" Spacing="5.6">
                    <TextBlock Text="{Binding Text}"
                               FontSize="{DynamicResource NocturneFontSizeSmall}"
                               Foreground="{DynamicResource NocturneChipTextBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="×"
                            Classes="ghost"
                            FontSize="{DynamicResource NocturneFontSizeSmall}"
                            Padding="2.8,0"
                            Margin="0"
                            MinWidth="0"
                            ToolTip.Tip="Снять тег"
                            Click="OnRemoveTagClicked" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="{DynamicResource NocturneInsetWindow}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <!-- Headings are never heavier than 500 — hierarchy is size and space. -->
            <TextBlock Grid.Column="0"
                       FontSize="{DynamicResource NocturneFontSizeHeading}"
                       FontWeight="Medium"
                       Text="SmartMacro"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       FontSize="{DynamicResource NocturneFontSizeSmall}"
                       FontFamily="{DynamicResource NocturneFontFamilyMono}"
                       Foreground="{DynamicResource NocturneTextFaintBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding WindowCountText}" />
        </Grid>

        <!-- Windows -->
        <Border Grid.Row="1"
                Margin="0,11.2,0,0"
                BorderThickness="1"
                BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                Background="{DynamicResource NocturneBgBrush}"
                CornerRadius="{DynamicResource NocturneRadiusSm}">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Windows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WindowRowViewModel">
                            <Border Padding="{DynamicResource NocturneInsetPanel}"
                                    Margin="{DynamicResource NocturneSpace1Thickness}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource NocturneDividerBrush}"
                                    CornerRadius="{DynamicResource NocturneRadiusSm}"
                                    Background="{DynamicResource NocturneSurfaceRaisedBrush}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="8.4"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource NocturneFontSizeTitle}"
                                                   Foreground="{Binding HasTags, Converter={x:Static conv:TaggedToBrushConverter.Instance}}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ProcessName}" />
                                        <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                                                   Foreground="{DynamicResource NocturneTextFaintBrush}"
                                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding HwndHex}" />
                                        <TextBlock FontSize="{DynamicResource NocturneFontSizeSmall}"
                                                   Foreground="{DynamicResource NocturneTextGhostBrush}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasTags}"
                                                   Text="без тегов" />
                                    </StackPanel>

                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             MinWidth="140"
                                             Watermark="новый тег"
                                             Text="{Binding NewTagText, Mode=TwoWay}"
                                             KeyDown="OnTagInputKeyDown" />
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Content="+"
                                            Classes="accent"
                                            Padding="{DynamicResource NocturneInsetTight}"
                                            Margin="5.6,0,0,0"
                                            MinWidth="24"
                                            ToolTip.Tip="Добавить тег"
                                            Click="OnAddTagClicked" />

                                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="3"
                                                  Margin="0,8.4,0,0"
                                                  IsVisible="{Binding HasTags}"
                                                  ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Running macros -->
        <Border Grid.Row="2"
                Margin="0,8.4,0,8.4"
                Padding="{DynamicResource NocturneInsetPanel}"
                BorderThickness="1"
                BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                CornerRadius="{DynamicResource NocturneRadiusSm}">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               FontSize="{DynamicResource NocturneFontSizeBody}"
                               Foreground="{DynamicResource NocturneTextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding RunsHeaderText}" />
                    <Button Grid.Column="1"
                            Content="Стоп всё"
                            Classes="danger"
                            IsEnabled="{Binding HasRuns}"
                            Click="OnStopAllRunsClicked" />
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="150" Margin="0,5.6,0,0">
                    <ItemsControl ItemsSource="{Binding Runs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunningMacroRowViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2.8">
                                    <TextBlock Grid.Column="0"
                                               FontSize="{DynamicResource NocturneFontSizeBody}"
                                               VerticalAlignment="Center"
                                               Text="{Binding MacroName}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="{DynamicResource NocturneFontSizeSmall}"
                                               Foreground="{DynamicResource NocturneTextFaintBrush}"
                                               FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                               VerticalAlignment="Center"
                                               Margin="8.4,0"
                                               Text="{Binding Elapsed}" />
                                    <TextBlock Grid.Column="2"
                                               FontSize="{DynamicResource NocturneFontSizeSmall}"
                                               FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                               Foreground="{DynamicResource NocturneAccent400Brush}"
                                               VerticalAlignment="Center"
                                               MinWidth="120"
                                               ToolTip.Tip="Текущая нода"
                                               Text="{Binding CurrentNodeText}" />
                                    <Button Grid.Column="3"
                                            Content="Стоп"
                                            Padding="{DynamicResource NocturneInsetTight}"
                                            Click="OnStopRunClicked" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1"
                    Content="Dump captures"
                    Margin="0,0,5.6,0"
                    ToolTip.Tip="Сохранить снимки окон в debug/ для настройки регионов"
                    Click="OnDumpCapturesClicked" />
            <Button Grid.Column="2"
                    Content="Макросы"
                    Classes="accent"
                    Click="OnMacrosClicked" />
        </Grid>
    </Grid>
</Window>
