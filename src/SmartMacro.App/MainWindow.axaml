<!--
  Main window (W0.3): the tracked WINDOWS with their tag chips, plus the live list of
  running macros. It replaced the agent-row list — after W0.1 there are no per-character
  agents to show, only windows and the tags that route macros at them.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartMacro.App.ViewModels"
        xmlns:conv="using:SmartMacro.App.Converters"
        x:Class="SmartMacro.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="820" Height="820"
        MinWidth="600" MinHeight="500"
        Title="SmartMacro">

    <Window.DataTemplates>
        <!-- Tag chip: the tag text plus its own remove button. -->
        <DataTemplate DataType="vm:TagChipViewModel" x:DataType="vm:TagChipViewModel">
            <Border Background="#2b3a2b"
                    BorderBrush="#3f5a3f"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,2"
                    Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Text}"
                               FontSize="11"
                               Foreground="#CFE6CF"
                               VerticalAlignment="Center" />
                    <Button Content="×"
                            FontSize="11"
                            Padding="4,0"
                            Margin="0"
                            MinWidth="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="Снять тег"
                            Click="OnRemoveTagClicked" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" FontSize="18" Text="SmartMacro" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       FontSize="11"
                       Foreground="#666"
                       VerticalAlignment="Center"
                       Text="{Binding WindowCountText}" />
        </Grid>

        <!-- Windows -->
        <Border Grid.Row="1"
                Margin="0,12,0,0"
                BorderThickness="1"
                BorderBrush="#444"
                CornerRadius="4">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Windows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WindowRowViewModel">
                            <Border Padding="10"
                                    Margin="4"
                                    BorderThickness="1"
                                    BorderBrush="#333"
                                    CornerRadius="3"
                                    Background="#1a1a1a">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="14"
                                                   Foreground="{Binding HasTags, Converter={x:Static conv:TaggedToBrushConverter.Instance}}"
                                                   Text="{Binding ProcessName}" />
                                        <TextBlock FontSize="11"
                                                   Foreground="#888"
                                                   FontFamily="Consolas, monospace"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding HwndHex}" />
                                        <TextBlock FontSize="11"
                                                   Foreground="#777"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasTags}"
                                                   Text="без тегов" />
                                    </StackPanel>

                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             MinWidth="140"
                                             FontSize="11"
                                             Watermark="новый тег"
                                             Text="{Binding NewTagText, Mode=TwoWay}"
                                             KeyDown="OnTagInputKeyDown" />
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Content="+"
                                            FontSize="12"
                                            Padding="10,4"
                                            Margin="6,0,0,0"
                                            ToolTip.Tip="Добавить тег"
                                            Click="OnAddTagClicked" />

                                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="3"
                                                  Margin="0,8,0,0"
                                                  IsVisible="{Binding HasTags}"
                                                  ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Running macros -->
        <Border Grid.Row="2"
                Margin="0,10,0,10"
                Padding="8"
                BorderThickness="1"
                BorderBrush="#444"
                CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               FontSize="12"
                               Foreground="#aaa"
                               VerticalAlignment="Center"
                               Text="{Binding RunsHeaderText}" />
                    <Button Grid.Column="1"
                            Content="Стоп всё"
                            FontSize="11"
                            Padding="10,3"
                            IsEnabled="{Binding HasRuns}"
                            Click="OnStopAllRunsClicked" />
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="150" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Runs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunningMacroRowViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="{Binding MacroName}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="11"
                                               Foreground="#888"
                                               FontFamily="Consolas, monospace"
                                               VerticalAlignment="Center"
                                               Margin="10,0"
                                               Text="{Binding Elapsed}" />
                                    <TextBlock Grid.Column="2"
                                               FontSize="11"
                                               Foreground="#6a9fd0"
                                               VerticalAlignment="Center"
                                               MinWidth="120"
                                               ToolTip.Tip="Текущая нода"
                                               Text="{Binding CurrentNodeText}" />
                                    <Button Grid.Column="3"
                                            Content="Стоп"
                                            FontSize="11"
                                            Padding="10,2"
                                            Click="OnStopRunClicked" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1"
                    Content="Dump captures"
                    FontSize="11"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    ToolTip.Tip="Сохранить снимки окон в debug/ для настройки регионов"
                    Click="OnDumpCapturesClicked" />
            <Button Grid.Column="2"
                    Content="Макросы"
                    FontSize="11"
                    Padding="10,4"
                    Click="OnMacrosClicked" />
        </Grid>
    </Grid>
</Window>
