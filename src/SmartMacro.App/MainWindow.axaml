<!--
  The 1b shell (wave D2). Source of truth: docs/design/opt-1b.html.

  One window, four parts:

    · a 30px CUSTOM title bar. ExtendClientAreaToDecorationsHint removes the OS frame —
      D1 found the stock Windows caption renders light and cannot be darkened through
      RequestedThemeVariant, and this is the fix. The bar therefore has to do the OS's job
      itself: BeginMoveDrag to move, double-tap to maximise, three real buttons.
    · a 172px mode rail. It is a ListBox on purpose: the ListBoxItem theme from D1 already
      draws selection as a 2px accent rule over a 12% wash, which is exactly the mockup's
      nav pattern, and keyboard navigation comes free.
    · the work area, one view per mode. All five are constructed once and toggled with
      IsVisible rather than swapped through a ContentControl, so a half-typed tag, a
      scrolled node list and the editor's dirty state all survive a trip to another mode.
    · a 30px run bar, always present. Its presence IS the feature — when nothing runs it
      shows an idle line rather than collapsing.

  D3a grew the window from the 900×482 of mockup 1b to 1520×840. The canvas editor is
  mockup 1d, which is 1628px wide for a reason: at 900 the 172px rail plus a 228px library
  plus a 308px inspector left the graph under 200px, which is not even one node box. 1500
  is what it takes for the three-column wrapping layout (780px) to fit at 100% zoom. The minimum is
  1100 — below that the canvas holds fewer than two columns and the layout stops making
  sense (it still pans and zooms, so nothing is unreachable).

  Every colour and padding comes from Themes/Tokens.axaml. If a value is missing, add a
  token; do not type a hex here.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartMacro.App.ViewModels"
        xmlns:views="using:SmartMacro.App.Views"
        xmlns:conv="using:SmartMacro.App.Converters"
        x:Class="SmartMacro.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        x:Name="Root"
        Width="1520" Height="840"
        MinWidth="1100" MinHeight="620"
        Background="{DynamicResource NocturneBgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="SmartMacro">

    <Window.Styles>
        <!-- Caption buttons. The mockup draws bare glyphs; a real window needs a hit target,
             so these are 38×30 chrome-less buttons that only light up on hover. -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeBody}" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral600Brush}" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint08Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral200Brush}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneDangerSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneDangerBrush}" />
        </Style>

        <!-- Mode rail. The theme's 8.4,5.6 padding would make a 30px row impossible; 10px
             on the left plus the item's own 2px rule reproduces the mockup's 12px inset. -->
        <Style Selector="ListBox.rail">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rail ListBoxItem">
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral500Brush}" />
        </Style>

        <!-- The uppercase eyebrow over a section ("ТЕГИ", "НЕ ОПОЗНАНО · 3"). -->
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="LetterSpacing" Value="0.7" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextGhostBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <!-- OffScreenMargin keeps a maximised extended-client-area window off the screen edges
         (and out from under the taskbar); it is zero in every other state. -->
    <Grid RowDefinitions="30,*" Margin="{Binding #Root.OffScreenMargin}">

        <!-- ================================ title bar ================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource NocturneSurfaceOverlayBrush}"
                BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,0,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="9" Height="9"
                            CornerRadius="2"
                            Background="{DynamicResource NocturneAccent700Brush}" />
                    <TextBlock Text="SmartMacro"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource NocturneNeutral300Brush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="caption" Content="—" ToolTip.Tip="Свернуть" Click="OnMinimiseClicked" />
                    <Button Classes="caption" Content="▢" ToolTip.Tip="Развернуть" Click="OnMaximiseClicked" />
                    <Button Classes="caption close" Content="✕" ToolTip.Tip="Закрыть" Click="OnCloseClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================== body =================================== -->
        <Grid Grid.Row="1" ColumnDefinitions="172,*">

            <!-- =============================== sidebar =============================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource NocturneSurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource NocturneDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">

                    <ListBox Grid.Row="0"
                             Classes="rail"
                             ItemsSource="{Binding Modes}"
                             SelectedItem="{Binding SelectedMode, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShellModeViewModel">
                                <Grid ColumnDefinitions="*,Auto" Height="30">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontSize="{DynamicResource NocturneFontSizeBody}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasCounter}">
                                        <Border Width="5" Height="5"
                                                CornerRadius="2.5"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource NocturneAccentBrush}"
                                                IsVisible="{Binding ShowsActivityDot}" />
                                        <TextBlock Text="{Binding CounterText}"
                                                   FontSize="10.5"
                                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding CounterIsAccent, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccent400Brush|NocturneTextFaintBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Tag summary, pinned to the bottom. The designer's note: this is the
                         only place the whole party composition is visible at once. -->
                    <StackPanel Grid.Row="2" Margin="12,10,12,8" Spacing="6">
                        <TextBlock Classes="eyebrow" Text="ТЕГИ" />
                        <ItemsControl ItemsSource="{Binding TagSummary}" IsVisible="{Binding HasTagSummary}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TagSummaryItemViewModel">
                                    <Border Height="18"
                                            Margin="0,0,4,4"
                                            Padding="7,0"
                                            CornerRadius="9"
                                            Background="{DynamicResource NocturneChipFillSoftBrush}"
                                            BorderBrush="{DynamicResource NocturneChipBorderSoftBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tag}"
                                                       FontSize="{DynamicResource NocturneFontSizeMicro}"
                                                       Foreground="{DynamicResource NocturneChipTextSoftBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}"
                                                       FontSize="{DynamicResource NocturneFontSizeMicro}"
                                                       Foreground="{DynamicResource NocturneNeutral600Brush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="ни одного окна не опознано"
                                   FontSize="{DynamicResource NocturneFontSizeMicro}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource NocturneTextGhostBrush}"
                                   IsVisible="{Binding !HasTagSummary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================= work area + run bar ========================= -->
            <Grid Grid.Column="1" RowDefinitions="*,30">

                <Panel Grid.Row="0">
                    <views:WindowsView IsVisible="{Binding IsWindowsMode}" />
                    <Panel IsVisible="{Binding IsMacrosMode}">
                        <views:MacrosView DataContext="{Binding Editor}" />
                    </Panel>
                    <views:RunsView IsVisible="{Binding IsRunsMode}" />
                    <views:TemplatesView IsVisible="{Binding IsTemplatesMode}" />
                    <views:LogView IsVisible="{Binding IsLogMode}" />
                </Panel>

                <Border Grid.Row="1"
                        Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                        <!-- Live: accent dot with its halo, then macro / elapsed / node. -->
                        <Border Grid.Column="0"
                                Width="7" Height="7"
                                Margin="0,0,10,0"
                                CornerRadius="3.5"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasRuns}"
                                Background="{DynamicResource NocturneAccentBrush}"
                                BoxShadow="{DynamicResource NocturneRunDotGlow}" />
                        <Border Grid.Column="0"
                                Width="7" Height="7"
                                Margin="0,0,10,0"
                                CornerRadius="3.5"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasRuns}"
                                Background="{DynamicResource NocturneNeutral800Brush}" />

                        <TextBlock Grid.Column="1"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasRuns}"
                                   Text="{Binding PrimaryRun.MacroName}" />
                        <TextBlock Grid.Column="2"
                                   Margin="10,0,0,0"
                                   FontSize="{DynamicResource NocturneFontSizeSmall}"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneNeutral500Brush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasRuns}"
                                   Text="{Binding PrimaryRun.Elapsed}" />
                        <TextBlock Grid.Column="3"
                                   Margin="10,0,0,0"
                                   FontSize="10.5"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneAccent400Brush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="Текущая нода"
                                   IsVisible="{Binding HasRuns}"
                                   Text="{Binding PrimaryRun.CurrentNodeText, StringFormat='▸ {0}'}" />
                        <TextBlock Grid.Column="4"
                                   Margin="10,0,0,0"
                                   FontSize="10.5"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneTextFaintBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="Ещё прогоны — весь список в режиме «Прогоны»"
                                   IsVisible="{Binding HasOtherRuns}"
                                   Text="{Binding OtherRunsText}" />

                        <!-- Idle: the bar stays, and says so. -->
                        <TextBlock Grid.Column="1"
                                   FontSize="{DynamicResource NocturneFontSizeSmall}"
                                   Foreground="{DynamicResource NocturneTextFaintBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !HasRuns}"
                                   Text="{Binding IdleText}" />

                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                            <Button Content="Стоп"
                                    Height="21"
                                    Padding="10,0"
                                    IsEnabled="{Binding HasRuns}"
                                    ToolTip.Tip="Остановить прогон, названный в полосе"
                                    Click="OnStopPrimaryRunClicked" />
                            <Button Content="Стоп всё"
                                    Classes="danger"
                                    Height="21"
                                    Padding="10,0"
                                    IsEnabled="{Binding HasRuns}"
                                    Click="OnStopAllRunsClicked" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
