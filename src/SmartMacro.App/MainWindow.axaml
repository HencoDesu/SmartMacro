<!--
  Оболочка 1b (волна D2). Источник истины: docs/design/opt-1b.html.

  Одно окно, четыре части:

    · СВОЯ строка заголовка в 30px. ExtendClientAreaToDecorationsHint убирает рамку ОС: на
      волне D1 выяснилось, что штатный виндовый заголовок рисуется светлым и потемнеть через
      RequestedThemeVariant не может, — это и есть лекарство. Из-за чего строке приходится
      делать работу ОС самой: BeginMoveDrag для перетаскивания, двойное касание для
      разворота, три настоящие кнопки.
    · рейка режимов в 172px. Это намеренно ListBox: тема ListBoxItem из D1 уже рисует
      выделение как акцентную линейку в 2px поверх заливки 12%, а это ровно навигационный
      приём макета, — и навигация с клавиатуры достаётся даром.
    · рабочая область, по представлению на режим. Все пять создаются один раз и
      переключаются через IsVisible, а не подменяются в ContentControl, — благодаря чему
      недопечатанный тег, прокрученный список нод и несохранённое состояние редактора
      переживают поход в другой режим.
    · полоса прогона в 30px, присутствует всегда. Само её присутствие И ЕСТЬ фича: когда
      ничего не работает, она показывает строку простоя, а не схлопывается.

  Волна D3a вырастила окно с 900×482 макета 1b до 1520×840. Canvas-редактор — это макет 1d, и
  его ширина в 1628px взялась не случайно: при 900 рейка в 172px плюс библиотека в 228px плюс
  инспектор в 308px оставляли графу меньше 200px, а это даже не одна коробка ноды. 1500 —
  ровно столько, сколько нужно, чтобы трёхколоночная раскладка с переносом (780px) поместилась
  при масштабе 100%. Минимум — 1100: ниже на canvas не влезает и двух колонок, и раскладка
  перестаёт иметь смысл (панорамирование и масштабирование при этом работают, так что
  недостижимого ничего не остаётся).

  Каждый цвет и каждый отступ приезжают из Themes/Tokens.axaml. Если значения не хватает,
  добавьте токен, а не вписывайте сюда hex.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartMacro.App.ViewModels"
        xmlns:views="using:SmartMacro.App.Views"
        xmlns:conv="using:SmartMacro.App.Converters"
        xmlns:res="using:SmartMacro.Resources"
        x:Class="SmartMacro.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        x:Name="Root"
        Width="1520" Height="840"
        MinWidth="1100" MinHeight="620"
        Background="{DynamicResource NocturneBgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="SmartMacro">

    <Window.Styles>
        <!-- Кнопки заголовка. Макет рисует голые глифы; настоящему окну нужна область
             попадания, поэтому здесь кнопки 38×30 без оправы, загорающиеся лишь при
             наведении. -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="{DynamicResource NocturneFontSizeBody}" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral600Brush}" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint08Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral200Brush}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneDangerSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneDangerBrush}" />
        </Style>

        <!-- Рейка режимов. С темовым padding 8.4,5.6 строка в 30px была бы невозможна; 10px
             слева плюс собственная линейка элемента в 2px воспроизводят отступ в 12px с
             макета. -->
        <Style Selector="ListBox.rail">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rail ListBoxItem">
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral500Brush}" />
        </Style>

        <!-- «Настройки» под разделителем. Повторяет геометрию и состояния ListBoxItem рейки —
             акцентная линейка 2px по ведущей кромке поверх 12%-заливки, — но живёт вне списка,
             чтобы выделение рейки и выделение настроек не спорили. Прозрачная линейка у
             невыбранного держит текст на месте. -->
        <Style Selector="ToggleButton.railitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneNeutral500Brush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.railitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint08Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.railitem:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NocturneAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.railitem:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NocturneAccentTint18Brush}" />
        </Style>

        <!-- Надзаголовок капслоком над разделом («ТЕГИ», «НЕ ОПОЗНАНО · 3»). -->
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="LetterSpacing" Value="0.7" />
            <Setter Property="Foreground" Value="{DynamicResource NocturneTextGhostBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <!-- OffScreenMargin удерживает развёрнутое окно с расширенной клиентской областью от краёв
         экрана (и от заезда под панель задач); во всех остальных состояниях он равен нулю. -->
    <Grid RowDefinitions="30,*" Margin="{Binding #Root.OffScreenMargin}">

        <!-- ============================ строка заголовка ============================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource NocturneSurfaceOverlayBrush}"
                BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,0,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Знак приложения, вариант 1a «Цикл»: дуга повтора и треугольник запуска.
                         Тот же контур, что у иконки в трее и у обоих exe; ниже 32 px хвост
                         стрелки убран и штрих поднят до 3 — на этом размере три отдельных
                         штриха в верхнем углу сливаются в пятно.

                         ВЕКТОРОМ, а не тем же PNG, что уходит в WindowIcon. Заголовок — часть
                         темы: так знак берёт её кисти (сменится акцент — сменится и он) и
                         остаётся резким на любом масштабе экрана, тогда как растр на 18 px
                         пришлось бы или мылить, или заводить отдельным кадром.
                         Пути — дословно из assets/logo/icon-small.svg. -->
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                        <Canvas Width="32" Height="32">
                            <Path Data="M16 4.6 A11.4 11.4 0 1 1 5.6 20.2"
                                  Stroke="{DynamicResource NocturneNeutral400Brush}"
                                  StrokeThickness="3"
                                  StrokeLineCap="Round" />
                            <Path Data="M13.4 10.8 L22.6 16 L13.4 21.2 Z"
                                  Fill="{DynamicResource NocturneAccentBrush}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="SmartMacro"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource NocturneNeutral300Brush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="caption" Content="—" ToolTip.Tip="{x:Static res:Strings.Shell_Caption_Minimize}" Click="OnMinimiseClicked" />
                    <Button Classes="caption" Content="▢" ToolTip.Tip="{x:Static res:Strings.Shell_Caption_Maximize}" Click="OnMaximiseClicked" />
                    <Button Classes="caption close" Content="✕" ToolTip.Tip="{x:Static res:Strings.Shell_Caption_Close}" Click="OnCloseClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================== тело =================================== -->
        <Grid Grid.Row="1" ColumnDefinitions="172,*">

            <!-- =========================== боковая панель ============================ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource NocturneSurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource NocturneDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">

                    <ListBox Grid.Row="0"
                             Classes="rail"
                             ItemsSource="{Binding Modes}"
                             SelectedItem="{Binding SelectedMode, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShellModeViewModel">
                                <Grid ColumnDefinitions="*,Auto" Height="30">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontSize="{DynamicResource NocturneFontSizeBody}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasCounter}">
                                        <Border Width="5" Height="5"
                                                CornerRadius="2.5"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource NocturneAccentBrush}"
                                                IsVisible="{Binding ShowsActivityDot}" />
                                        <TextBlock Text="{Binding CounterText}"
                                                   FontSize="10.5"
                                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding CounterIsAccent, Converter={x:Static conv:TokenBrushConverter.Instance}, ConverterParameter=NocturneAccent400Brush|NocturneTextFaintBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Сводка по тегам, приколоченная к низу, и под ней — «Настройки».
                         Настройки НЕ шестой элемент того же ListBox: у них нет счётчика
                         (счётчики отвечают «сколько сейчас есть», а у настроек такого числа
                         нет), они стоят под разделителем, и выделяться две строки сразу не
                         должны — поэтому это отдельная кнопка, а выбор рейки при переходе сюда
                         обнуляется. -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,0"><StackPanel Margin="12,10,12,8" Spacing="6">
                        <TextBlock Classes="eyebrow" Text="{x:Static res:Strings.Shell_Tags_Header}" />
                        <ItemsControl ItemsSource="{Binding TagSummary}" IsVisible="{Binding HasTagSummary}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TagSummaryItemViewModel">
                                    <Border Height="18"
                                            Margin="0,0,4,4"
                                            Padding="7,0"
                                            CornerRadius="9"
                                            Background="{DynamicResource NocturneChipFillSoftBrush}"
                                            BorderBrush="{DynamicResource NocturneChipBorderSoftBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tag}"
                                                       FontSize="{DynamicResource NocturneFontSizeMicro}"
                                                       Foreground="{DynamicResource NocturneChipTextSoftBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}"
                                                       FontSize="{DynamicResource NocturneFontSizeMicro}"
                                                       Foreground="{DynamicResource NocturneNeutral600Brush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static res:Strings.Shell_Tags_Empty}"
                                   FontSize="{DynamicResource NocturneFontSizeMicro}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource NocturneTextGhostBrush}"
                                   IsVisible="{Binding !HasTagSummary}" />
                        </StackPanel>

                        <!-- «Настройки» под разделителем. Кнопка, а не ListBoxItem: выбор
                             рисует сам ListBox, и вторая строка внутри него неизбежно
                             подсвечивалась бы одновременно с рабочей. Псевдокласс :checked у
                             ToggleButton даёт ту же акцентную линейку в 2px, что и рейка. -->
                        <Border BorderBrush="{DynamicResource NocturneDividerBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,9,0,0"
                                Padding="0,7,0,0">
                            <ToggleButton Classes="railitem"
                                          IsChecked="{Binding SettingsMode.IsSelected, Mode=OneWay}"
                                          Click="OnSettingsClicked"
                                          ToolTip.Tip="{x:Static res:Strings.Shell_Rail_SettingsTip}">
                                <Grid ColumnDefinitions="Auto,*,Auto" Height="30">
                                    <!-- Шестерёнка. Не глиф из шрифта: у ⚙ есть эмодзи-вариант,
                                         который Windows подаёт из Segoe UI Emoji полноцветным и
                                         игнорирующим Foreground (ловушка описана в Tokens.axaml). -->
                                    <Path Grid.Column="0"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource NocturneNeutral500Brush}"
                                          StrokeThickness="1.2"
                                          Data="M8,5.6 A2.4,2.4 0 1 1 8,10.4 A2.4,2.4 0 1 1 8,5.6 M8,1.5 L8,3.5 M8,12.5 L8,14.5 M1.5,8 L3.5,8 M12.5,8 L14.5,8 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M12.6,3.4 L11.2,4.8 M4.8,11.2 L3.4,12.6" />
                                    <TextBlock Grid.Column="1"
                                               Margin="9,0,0,0"
                                               Text="{x:Static res:Strings.Shell_Mode_Settings}"
                                               FontSize="{DynamicResource NocturneFontSizeBody}"
                                               VerticalAlignment="Center" />
                                    <!-- Красная точка на месте счётчика: проваленная проверка
                                         среды. Числа здесь быть не может — «сколько сейчас
                                         есть» у настроек не бывает. -->
                                    <Border Grid.Column="2"
                                            Width="6" Height="6"
                                            CornerRadius="3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource NocturneDangerBrush}"
                                            IsVisible="{Binding HasEnvironmentProblems}"
                                            ToolTip.Tip="{x:Static res:Strings.Shell_Rail_DiagnosticsDot}" />
                                </Grid>
                            </ToggleButton>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== рабочая область + полоса прогона ================= -->
            <Grid Grid.Column="1" RowDefinitions="*,30">

                <Panel Grid.Row="0">
                    <views:WindowsView IsVisible="{Binding IsWindowsMode}" />
                    <Panel IsVisible="{Binding IsMacrosMode}">
                        <views:MacrosView DataContext="{Binding Editor}" />
                    </Panel>
                    <views:RunsView IsVisible="{Binding IsRunsMode}" />
                    <!-- Режима «Шаблоны» здесь больше нет: с волны F2 шаблон живёт внутри бандла
                         своего макроса, а браузер — в инспекторе редактора (см. MacrosView). -->
                    <Panel IsVisible="{Binding IsLogMode}">
                        <views:LogView DataContext="{Binding Log}" />
                    </Panel>
                    <Panel IsVisible="{Binding IsSettingsMode}">
                        <views:SettingsView DataContext="{Binding Settings}" />
                    </Panel>
                </Panel>

                <Border Grid.Row="1"
                        Background="{DynamicResource NocturneSurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource NocturneDividerStrongBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                        <!-- Идёт: акцентная точка со своим ореолом, дальше макрос / время / нода. -->
                        <Border Grid.Column="0"
                                Width="7" Height="7"
                                Margin="0,0,10,0"
                                CornerRadius="3.5"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasRuns}"
                                Background="{DynamicResource NocturneAccentBrush}"
                                BoxShadow="{DynamicResource NocturneRunDotGlow}" />
                        <Border Grid.Column="0"
                                Width="7" Height="7"
                                Margin="0,0,10,0"
                                CornerRadius="3.5"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasRuns}"
                                Background="{DynamicResource NocturneNeutral800Brush}" />

                        <TextBlock Grid.Column="1"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasRuns}"
                                   Text="{Binding PrimaryRun.MacroName}" />
                        <TextBlock Grid.Column="2"
                                   Margin="10,0,0,0"
                                   FontSize="{DynamicResource NocturneFontSizeSmall}"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneNeutral500Brush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasRuns}"
                                   Text="{Binding PrimaryRun.Elapsed}" />
                        <TextBlock Grid.Column="3"
                                   Margin="10,0,0,0"
                                   FontSize="10.5"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneAccent400Brush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{x:Static res:Strings.Shell_RunBar_CurrentNodeTip}"
                                   IsVisible="{Binding HasRuns}"
                                   Text="{Binding PrimaryRun.CurrentNodeText, StringFormat='▸ {0}'}" />
                        <TextBlock Grid.Column="4"
                                   Margin="10,0,0,0"
                                   FontSize="10.5"
                                   FontFamily="{DynamicResource NocturneFontFamilyMono}"
                                   Foreground="{DynamicResource NocturneTextFaintBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{x:Static res:Strings.Shell_RunBar_OtherRunsTip}"
                                   IsVisible="{Binding HasOtherRuns}"
                                   Text="{Binding OtherRunsText}" />

                        <!-- Простой: полоса остаётся на месте и прямо об этом сообщает. -->
                        <TextBlock Grid.Column="1"
                                   FontSize="{DynamicResource NocturneFontSizeSmall}"
                                   Foreground="{DynamicResource NocturneTextFaintBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !HasRuns}"
                                   Text="{Binding IdleText}" />

                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                            <Button Content="{x:Static res:Strings.Shell_RunBar_Stop}"
                                    Height="21"
                                    Padding="10,0"
                                    IsEnabled="{Binding HasRuns}"
                                    ToolTip.Tip="{x:Static res:Strings.Shell_RunBar_StopTip}"
                                    Click="OnStopPrimaryRunClicked" />
                            <Button Content="{x:Static res:Strings.Shell_RunBar_StopAll}"
                                    Classes="danger"
                                    Height="21"
                                    Padding="10,0"
                                    IsEnabled="{Binding HasRuns}"
                                    Click="OnStopAllRunsClicked" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
