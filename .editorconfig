root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,slnx}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false  # markdown: two trailing spaces = line break

# ─── C# style ───
[*.cs]

# Always require braces around if/else/for/while/using bodies, even single-statement ones.
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning

# File-scoped namespaces (matches existing codebase).
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning

# Cosmetic — keep using directives grouped, System first.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
