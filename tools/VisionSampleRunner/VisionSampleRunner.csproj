<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMacro.VisionSampleRunner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ссылка прямая, а не унаследованная: SmartMacro.Core помечает Tesseract как
         PrivateAssets="all", чтобы 12 МБ нативных блобов не доезжали до SmartMacro.Daemon,
         который OCR не делает никогда. Этот прогонщик — ЕДИНСТВЕННЫЙ живой потребитель
         TesseractCoordinateReader, поэтому пакет он просит себе сам (и везёт при себе
         подходящий tessdata\ ниже). -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartMacro.Core\SmartMacro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tessdata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
