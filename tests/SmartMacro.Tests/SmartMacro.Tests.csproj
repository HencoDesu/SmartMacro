<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- TUnit runs on Microsoft.Testing.Platform: the test project is an executable
         (dotnet run with project tests/SmartMacro.Tests). TUnit source-generates Main. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartMacro.Contracts\SmartMacro.Contracts.csproj" />
    <ProjectReference Include="..\..\src\SmartMacro.Core\SmartMacro.Core.csproj" />
    <!-- W0.3: view-model tests. The App project is a WinExe, but referencing it only
         pulls in its assembly — the VMs under test take Core services through their
         constructors and marshal through IUiDispatcher, so nothing here needs an
         Avalonia application, a dispatcher loop, or a render surface. -->
    <ProjectReference Include="..\..\src\SmartMacro.App\SmartMacro.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FakeItEasy" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageReference Include="TUnit" Version="1.63.0" />
  </ItemGroup>

</Project>
