<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- TUnit работает поверх Microsoft.Testing.Platform: тестовый проект — это исполняемый
         файл, который запускают через `dotnet run` с ключом project, а Main генерирует сам
         TUnit. (Ключ здесь описан словами: двойной дефис внутри XML-комментария запрещён.) -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartMacro.Contracts\SmartMacro.Contracts.csproj" />
    <ProjectReference Include="..\..\src\SmartMacro.Core\SmartMacro.Core.csproj" />
    <!-- Тесты view-model'ей. Проект панели — WinExe, но ссылка на него тянет только сборку:
         проверяемые view-model'и получают всё через конструктор и маршалят через
         IUiDispatcher, так что ни приложения Avalonia, ни цикла диспетчера, ни поверхности
         отрисовки здесь не нужно. -->
    <ProjectReference Include="..\..\src\SmartMacro.App\SmartMacro.App.csproj" />
    <!-- Куски настоящей (не-Win32) логики демона: мьютекс единственного экземпляра, поиск
         исполняемого файла панели, проба пера на запись. Оговорка про столкновение двух
         appsettings.json в выхлопе тестов снята дважды: сперва имена разошлись, потом файл
         конфигурации у панели исчез вовсе. Читать конфиг отсюда всё равно некому — ни один exe
         тесты не запускают. -->
    <ProjectReference Include="..\..\src\SmartMacro.Daemon\SmartMacro.Daemon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Обход интерфейса (tests/Ui): настоящее окно панели без экрана. Платформа собирается с
         UseHeadlessDrawing=false плюс UseSkia, то есть кадр рисуется по-настоящему — иначе
         замеры чернил глифов были бы невозможны. Официального переходника к TUnit у пакета нет
         (есть к NUnit и xUnit), поэтому вход в поток UI — свой помощник Ui.RunAsync; довод
         записан у него. -->
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="FakeItEasy" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageReference Include="TUnit" Version="1.63.0" />
  </ItemGroup>

</Project>
