<!--
  Портативная поставка: панель ОДНИМ ФАЙЛОМ в корне, демон со своим рантаймом в подпапке.

  Собрать:   dotnet msbuild build\portable.proj
  Zip:       dotnet msbuild build\portable.proj -t:Package
  Отладочная сборка в ту же раскладку: -p:Configuration=Debug

  ─────────────────────────────────────────────────────────────────────────────────────────
  РАСКЛАДКА

    SmartMacro\
      SmartMacro.exe        панель, single-file — ЕДИНСТВЕННОЕ, что видно в корне
      macros\               графы пользователя
      settings.json         настройки движка; создаёт демон при первом запуске
      logs\  debug\         журнал панели и дампы захватов — их смотрит человек
      daemon\
        SmartMacro.Daemon.exe + рантайм + appsettings.json + свой logs\

  ПОЧЕМУ НЕ ОДНА ПАПКА НА ОБОИХ

  Предыдущая итерация сводила оба exe в один каталог. Дедупликация дала 26 файлов и 3 МБ из
  118 — два с половиной процента, и ради этого пришлось лечить целый класс ошибок: ОДНА ПАПКА
  ЕСТЬ ОДИН КАТАЛОГ ЗОНДИРОВАНИЯ СБОРОК, и всё, что его сканирует, начинает видеть зависимости
  соседнего процесса. Панель на этом однажды вообще не запускалась (Serilog.Settings.Configuration
  перебирал Serilog*.dll рядом с собой, находил серилоговские расширения демона и падал на
  CreateLogger без единого сообщения). Разные папки убирают причину, а не следствие.

  Взамен раскладка отвечает на вопрос, который был вторым по важности: пользователь видит одну
  кнопку и свои данные, а не выхлоп сборки. Полсотни dll ушли в daemon\ и в бандл панели.

  ПОЧЕМУ ДВА EXE, А НЕ ОДИН С КЛЮЧОМ РЕЖИМА (daemon / panel)
  (двойной дефис перед ключами здесь не написать: XML-комментарий его не допускает)

  Манифест привязан к БИНАРНИКУ, а не к режиму запуска. Демону нужен requireAdministrator (UIPI
  режет ввод и PrintWindow в elevated-клиенты игры, §7 спеки), и единый exe унаследовал бы
  повышение в оба режима — панель начала бы всегда спрашивать UAC, а снять с неё elevation стало
  бы невозможно в принципе. Разделение на два файла — ровно то, что оставляет эту дверь
  открытой: панель ничем не управляет, она IPC-клиент, и вполне может однажды ходить с обычными
  правами. НЕ СЛИВАТЬ.

  ПОЧЕМУ ЦЕЛЬ MSBUILD, А НЕ СКРИПТ

  Публикаций всё равно две (`dotnet publish` умеет один проект за раз), значит порядок и два
  разных PublishDir надо где-то записать. Скрипту на PowerShell пришлось бы дублировать набор
  свойств, который MSBuild и так знает из csproj (Configuration, RID, SelfContained,
  PublishSingleFile). Плюс одна точка входа для CLI, Rider и любого CI, без политик исполнения
  скриптов.

  SINGLE-FILE — ТОЛЬКО У ПАНЕЛИ

  У панели три нативные библиотеки (Skia, HarfBuzz, ANGLE), и они уезжают внутрь бандла с
  IncludeNativeLibrariesForSelfExtract; распаковка идёт в %TEMP%\.net\... ОДИН РАЗ НА ВЕРСИЮ, а
  не при каждом запуске, — приемлемо ради одного файла в корне. Демона в бандл не заворачиваем:
  он лежит в подпапке и продуктом выглядеть не обязан, зато у него нативные блобы OpenCV и
  резидентная жизнь, где мутный стек с несуществующими путями обходится дороже.

  ПРОВЕРКИ СТОЛКНОВЕНИЙ ЗДЕСЬ БОЛЬШЕ НЕТ

  VerifyNoClobber и build\publish-file-list.targets удалены вместе с общей папкой: два разных
  PublishDir не могут положить файл на файл, и сравнивать нечего.
-->
<Project DefaultTargets="Publish">

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</RepoRoot>
    <!-- Лишний уровень (dist\portable\) не украшение: ZipDirectory кладёт в архив СОДЕРЖИМОЕ
         исходной папки, а раздача условлена как «zip с папкой». Значит, зипуем родителя, и
         родитель обязан не содержать ничего, кроме неё, — сам архив поэтому лежит уровнем
         выше. -->
    <PortableStage Condition="'$(PortableStage)' == ''">$([MSBuild]::NormalizeDirectory('$(RepoRoot)dist', 'portable'))</PortableStage>
    <PortableDir Condition="'$(PortableDir)' == ''">$([MSBuild]::NormalizeDirectory('$(PortableStage)', 'SmartMacro'))</PortableDir>
    <!-- Имя подпапки продублировано из Contracts/Ipc/InstallationLayout.DaemonFolderName:
         MSBuild не умеет спросить константу у C#. Разъедутся — панель не найдёт демона первым
         кандидатом, а демон будет искать состояние не там; тест на связку лежит в
         SmartMacro.Tests. -->
    <PortableDaemonDir Condition="'$(PortableDaemonDir)' == ''">$([MSBuild]::NormalizeDirectory('$(PortableDir)', 'daemon'))</PortableDaemonDir>
    <PortableZip Condition="'$(PortableZip)' == ''">$(RepoRoot)dist\SmartMacro-$(Configuration).zip</PortableZip>
    <DaemonProject>$(RepoRoot)src\SmartMacro.Daemon\SmartMacro.Daemon.csproj</DaemonProject>
    <AppProject>$(RepoRoot)src\SmartMacro.App\SmartMacro.App.csproj</AppProject>
  </PropertyGroup>

  <!--
    Восстановление отдельным вызовом MSBuild, а не Targets="Restore;Publish" в одном: проект
    вычисляется один раз, ДО того как restore запишет project.assets.json, и второй целью
    публикация ушла бы со старым (или отсутствующим) файлом активов. Нужно ради свежего клона —
    без этого точка входа работала бы только после `dotnet build`.
  -->
  <Target Name="Restore">
    <MSBuild Projects="$(DaemonProject);$(AppProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="Publish" DependsOnTargets="Restore;Clean;PublishDaemon;PublishPanel">
    <ItemGroup>
      <_RootFile Include="$(PortableDir)*" />
      <_DaemonFile Include="$(PortableDaemonDir)**\*" />
    </ItemGroup>
    <Message Importance="high"
             Text="Поставка: $(PortableDir) — в корне файлов: @(_RootFile->Count()), в daemon\: @(_DaemonFile->Count())" />
  </Target>

  <Target Name="PublishDaemon">
    <MSBuild Projects="$(DaemonProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(PortableDaemonDir)" />
  </Target>

  <Target Name="PublishPanel">
    <MSBuild Projects="$(AppProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(PortableDir)" />
  </Target>

  <!--
    ⚠️ ЦЕЛИ LiftSharedContent БОЛЬШЕ НЕТ, и это волна F2.

    Она поднимала templates\ из daemon\ в корень поставки: файлы приезжали из проекта демона, а
    демон публикуется в подпапку, так что общее дерево оказывалось уровнем ниже нужного, и
    починить это могла только сборка. Общего дерева больше не существует — шаблон живёт внутри
    бандла .hsm своего макроса (§13.1 спеки), — так что поднимать нечего, а Move, который ничего
    не находит, был бы ошибкой сборки на пустом месте.
  -->

  <!--
    Чистая папка — часть Publish, а не отдельный ритуал: артефакт обязан собираться с нуля,
    иначе в архив уедет файл, удалённый из проекта три волны назад.

    Следствие, о котором надо знать: dist\ — ВЫХЛОП СБОРКИ, а не установка. Если запустить
    программу оттуда, её macros\, settings.json, logs\ и debug\ исчезнут при следующей
    публикации. Рабочая установка — распакованный zip где-нибудь ещё.
  -->
  <Target Name="Clean">
    <RemoveDir Directories="$(PortableDir)" />
  </Target>

  <Target Name="Package" DependsOnTargets="Publish">
    <Delete Files="$(PortableZip)" />
    <ZipDirectory SourceDirectory="$(PortableStage)" DestinationFile="$(PortableZip)" />
    <Message Importance="high" Text="Архив: $(PortableZip)" />
  </Target>

</Project>
